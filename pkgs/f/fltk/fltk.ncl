{
  lib,
  drvs,
  fltk | lib.CmakePackage = {
    generator = "Ninja",
    singleSource = {
      uri = "https://github.com/fltk/fltk/archive/refs/tags/release-1.4.0-1.tar.gz",
      sha256sum = "9a1123fe59a3879237c3ee3a56f3b6e10fdaad037b0e6a472df7ca4aaffd6654",
    },
    buildEnv = {
      EXTRA_CPPFLAGS = [
        # "-I/usr/include/pango-1.0",
        # "-I/usr/include/glib-2.0",
        # "-I/usr/lib/glib-2.0/include",
        "$(pkg-config --cflags pango)",
      ],
      EXTRA_CFLAGS = EXTRA_CPPFLAGS,
      EXTRA_CXXFLAGS = EXTRA_CPPFLAGS,
      EXTRA_LDFLAGS = [
        "$(pkg-config --libs --static cairo)"
      ],
    },

    cmakeExtraArgsRecord = {
      "-DFLTK_BUILD_TEST" = false,
      "-DFLTK_USE_CAIRO" = true,
      "-DFLTK_USE_X11" = false,
      "-DFl_Cairo_Window" = true,
      "-DFLTK_BUILD_FLUID" = false,
      "-DFLTK_BUILD_FLTK_OPTIONS" = false,
    },
    llvmProvider = drvs.llvmFull,
    biDrvs = [
      drvs.expat,
      drvs.fontconfig,
      drvs.freetype,
      drvs.glu,
      drvs.gperf,
      drvs.libdrm,
      drvs.libelf,
      drvs.libffi,
      drvs.libfontenc,
      drvs.libjpegTurboStatic,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libx11,
      drvs.libxau,
      drvs.libxcb,
      drvs.libxcursor,
      drvs.libxcvt,
      drvs.libxext,
      drvs.libxf86vm,
      drvs.libxfixes,
      drvs.libxfont2,
      drvs.libxft,
      drvs.libxinerama,
      drvs.libxkbcommon,
      drvs.libxkbfile,
      drvs.libxrandr,
      drvs.libxrender,
      drvs.libxshmfence,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.mesaGlx,
      drvs.ncurses,
      drvs.openssl,
      drvs.spirvHeaders,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.xcbProto,
      drvs.xcbRenderutil,
      drvs.xcbUtilErrors,
      drvs.xcbUtilWm,
      drvs.xorgMacros,
      drvs.xorgproto,
      drvs.xtrans,
      drvs.zlibNg,
      drvs.cairoXlib,
      drvs.pango,
      drvs.pixman,
      drvs.libdecor,
      drvs.glib,
      drvs.pcre2,
      drvs.fribidi,
      drvs.harfbuzz,
      drvs.dbus,
    ],
  },
  fltk13 | lib.CmakePackage =
    fltk
    & {
      singleSource | priority 1 = {
        uri = "https://github.com/fltk/fltk/archive/refs/tags/release-1.3.11.tar.gz",
        sha256sum = "2378a965971eaa7325decc7b48deef9ab666c7fdb4c244fcd95fce0ecdddc6c3",
      }
    }
}
