{
  lib,
  tllist,
  fcft,
  fontconfig,
  freetype,
  zlibNg,
  gperf,
  pixman,
  wayland,
  waylandProtocols,
  libffi,
  libxkbcommon,
  expat,
  linuxHeaders,
  scdoc,
  ncurses,
  utf8proc,

  foot | lib.MesonPackage = {
    name = "foot",
    singleSource = {
      uri = "https://codeberg.org/dnkl/foot/releases/download/1.18.1/foot-1.18.1.tar.gz",
      sha256sum = "7bd2ff135fe611a049d19b89480a410eb0ae12befadf70cfa7055b6f359ee607",
    },
    biDrvs =
      lib.biMap [
        tllist,
        fcft,
        fontconfig,
        freetype,
        zlibNg,
        gperf,
        pixman,
        wayland,
        waylandProtocols,
        libffi,
        libxkbcommon,
        expat,
        linuxHeaders,
        scdoc,
        ncurses,
        utf8proc,
      ],
    extraMesonArgs = [
      "-Ddocs=enabled",
      "-Dthemes=false",
      "-Dime=true",
      "-Dgrapheme-clustering=enabled",
      "-Dtests=false",
      "-Dutmp-backend=none",
      "-Dterminfo=enabled",
    ]
  }
}
