{
  lib,
  drvs,
  fwupd | lib.MesonPackage = {
    singleSource = {
      uri = "https://github.com/fwupd/fwupd/archive/refs/tags/2.1.3.tar.gz",
      sha256sum = "19db782eeae2c7439ad27eb0b3ed8005689542f3a91606e9c4b459fcd09f73b6",
    },
    extraMesonArgs = [
      "-Dintrospection=disabled",
      "-Dplugin_uefi_capsule_splash=false",
      # "-Dplugin_uefi_capsule_splash=true",
      "-Dplugin_flashrom=disabled",
      "-Dsupported_build=enabled",
      # "-Defi_os_dir=/efi",
    ],
    preConfigurePhase = [
      "mkdir /tmp/home",
      "export HOME=/tmp/home",
      lib.functions.writeFile "${SRC}/dlopen.c" (import "fwupd_dlopen.c" as 'Text),
      "${CC} ${CFLAGS} -c -Werror ${SRC}/dlopen.c -o ${SRC}/dlopen.o",
      # m%"sed -i "s@subdir('po')@@g" ${SRC}/meson.build"%,
      # m%"sed -i "s@subdir('po')@@g" ${SRC}/meson.build"%,
      # m%"printf "#!/usr/bin/env python\nexit(0)\n" > ${SRC}/po/test-deps"%,
    ],
    buildEnv = {
      EXTRA_LDFLAGS = [
        "-lassuan",
        "-ldrm_amdgpu",
        "/tmp/workdir/src/dlopen.o",
      ],
    },
    # enableParallel = false,

    preBuildPhase = [
      "ninja libfwupd/fwupd-bios-setting-struct.h",
      "ninja libfwupd/fwupd-client-struct.h",
      "ninja libfwupd/fwupd-codec-struct.h",
      "ninja libfwupd/fwupd-device-struct.h",
      "ninja libfwupd/fwupd-enums-struct.h",
      "ninja libfwupd/fwupd-error-struct.h",
      "ninja libfwupd/fwupd-jcat-struct.h",
      "ninja libfwupd/fwupd-json-struct.h",
      "ninja libfwupd/fwupd-plugin-struct.h",
      "ninja libfwupd/fwupd-release-struct.h",
      "ninja libfwupd/fwupd-remote-struct.h",
      "ninja libfwupd/fwupd-report-struct.h",
      "ninja libfwupd/fwupd-request-struct.h",
      "ninja libfwupd/fwupd-security-attr-struct.h",
    ],
    postInstallPhase = [
      "rm -r ${DEST}/usr/libexec/installed-tests/fwupd",
    ],
    pythonProvider = drvs.pythonDynamic,

    muslProvider = drvs.muslBothRenamedDl,

    biDrvs = [
      # drvs.libdlFactory,
      drvs.acl,
      drvs.attr,
      drvs.bash,
      drvs.cryptsetup,
      drvs.curl,
      drvs.dbus,
      drvs.docbookXml,
      drvs.docbookXslNons,
      drvs.duktape,
      drvs.e2fsprogs,
      drvs.elogindWithPolkit,
      drvs.eudev,
      drvs.expat,
      drvs.gettext,
      drvs.glibPatched,
      drvs.gmp,
      drvs.gnutls,
      drvs.gobjectDynamic,
      drvs.gpgme,
      drvs.graphviz,
      drvs.gudev,
      drvs.hwdata,
      drvs.inih,
      drvs.jsonC,
      drvs.jsonGlib,
      drvs.keyutils,
      drvs.kmod,
      drvs.libassuan,
      drvs.libatasmart,
      drvs.libblockdev,
      drvs.libcap,
      drvs.libdrm,
      drvs.libevdev,
      drvs.libffi,
      drvs.libgcrypt,
      drvs.libgpgError,
      drvs.libinput,
      drvs.libjcat,
      drvs.libnvme,
      drvs.libpamFinal,
      drvs.libpciaccess,
      drvs.libpsl,
      drvs.libtasn1,
      drvs.libusb,
      drvs.libxkbcommon,
      drvs.libxml2,
      drvs.libxmlb,
      drvs.libxslt,
      drvs.linuxHeaders,
      drvs.lvm2,
      drvs.mtdev,
      drvs.ncurses,
      drvs.nettleGmp,
      drvs.openssl,
      drvs.parted,
      drvs.pcre2,
      drvs.perl,
      drvs.polkit,
      drvs.popt,
      drvs.pythonFlitCore,
      drvs.pythonJinja2,
      drvs.pythonMarkupsafe,
      drvs.pythonPygobject,
      drvs.pythonPycairo,
      drvs.readline,
      drvs.scdoc,
      drvs.sqlite,
      drvs.udisks,
      drvs.utilLinux,
      drvs.vala,
      drvs.xz,
      drvs.zlibNg,
      drvs.zstd,
      drvs.cairoGobject,
      drvs.p11Kit,
    ]
  }
}
