{
  lib,
  drvs,
  fwupd | lib.MesonPackage = {
    singleSource = {
      uri = "https://github.com/fwupd/fwupd/archive/refs/tags/2.0.16.tar.gz",
      sha256sum = "e63f7ce7d536cf38961c4f3a87835f76043128cb964ae193c4144d94f4d6f49b",
    },
    extraMesonArgs = [
      "-Dintrospection=disabled",
      "-Dplugin_uefi_capsule_splash=false",
      "-Dplugin_flashrom=disabled",
    ],
    preConfigurePhase = [
      "mkdir /tmp/home",
      "export HOME=/tmp/home",
    ],
    buildEnv = {
      EXTRA_LDFLAGS = [
        "-lassuan",
        "-ldrm_amdgpu"
      ],
    },
    pythonProvider =
      drvs.pythonDynamic,

    biDrvs = [
      drvs.acl,
      drvs.attr,
      drvs.bash,
      drvs.cryptsetup,
      drvs.curl,
      drvs.dbus,
      drvs.docbookXml,
      drvs.docbookXslNons,
      drvs.duktape,
      drvs.e2fsprogs,
      drvs.elogindWithPolkit,
      drvs.eudev,
      drvs.expat,
      drvs.gettext,
      drvs.glib,
      drvs.gmp,
      drvs.gnutls,
      drvs.gobjectDynamic,
      drvs.gpgme,
      drvs.graphviz,
      drvs.gudev,
      drvs.hwdata,
      drvs.inih,
      drvs.jsonC,
      drvs.jsonGlib,
      drvs.keyutils,
      drvs.kmod,
      drvs.libassuan,
      drvs.libatasmart,
      drvs.libblockdev,
      drvs.libcap,
      drvs.libdrm,
      drvs.libevdev,
      drvs.libffi,
      drvs.libgcrypt,
      drvs.libgpgError,
      drvs.libinput,
      drvs.libjcat,
      drvs.libnvme,
      drvs.libpamFinal,
      drvs.libpciaccess,
      drvs.libpsl,
      drvs.libtasn1,
      drvs.libusb,
      drvs.libxkbcommon,
      drvs.libxml2,
      drvs.libxmlb,
      drvs.libxslt,
      drvs.linuxHeaders,
      drvs.lvm2,
      drvs.mtdev,
      drvs.muslShared,
      drvs.ncurses,
      drvs.nettleGmp,
      drvs.openssl,
      drvs.parted,
      drvs.pcre2,
      drvs.perl,
      drvs.polkit,
      drvs.popt,
      drvs.pythonFlitCore,
      drvs.pythonJinja2,
      drvs.pythonMarkupsafe,
      drvs.pythonPygobject,
      drvs.pythonPycairo,
      drvs.readline,
      drvs.scdoc,
      drvs.sqlite,
      drvs.udisks,
      drvs.utilLinux,
      drvs.vala,
      drvs.xz,
      drvs.zlibNg,
      drvs.zstd,
      drvs.cairoGobject,
    ]
  }
}
