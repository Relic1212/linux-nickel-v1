{
  lib,
  drvs,

  freerdp | lib.CmakePackage = {
    generator = "Ninja",
    singleSource = {
      uri = "https://github.com/FreeRDP/FreeRDP/archive/refs/tags/3.20.0.tar.gz",
      sha256sum = "7aef7cb22398ecdff0dd83071cbd17d20881751750b3879982af75b28042fd0d"
    },
    cmakeExtraArgsRecord = {
      "-DWITH_X11" = false,
      "-DWITH_WAYLAND" = true,
      "-DWITH_CUPS" = false,
    },
    preConfigurePhase = [
      "HOME=$(mktemp -d)",
      "export HOME",
    ],
    buildEnv = {
      EXTRA_LDFLAGS = [
        "-lc++",
        "$(pkg-config --libs --static mit-krb5)",
        "$(pkg-config --libs --static libudev)", # libusb
        "$(pkg-config --libs --static libdrm)",
        "$(pkg-config --libs --static libffi)",
        "$(pkg-config --static --libs xcb)",
        "$(pkg-config --static --libs xcb-shm)",
        "$(pkg-config --static --libs x11-xcb)",
        "$(pkg-config --static --libs xau)",
      ],
    },
    biDrvs = [
      drvs.eudev,
      drvs.expat,
      drvs.ffmpeg,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.fuse,
      drvs.glib,
      drvs.gperf,
      drvs.jansson,
      drvs.jsonC,
      drvs.kmod,
      drvs.krb5,
      drvs.libdrm,
      drvs.libelf,
      drvs.libffi,
      drvs.libfontenc,
      drvs.libicu,
      drvs.libpciaccess,
      drvs.libusb,
      drvs.libx11,
      drvs.libxau,
      drvs.libxcb,
      drvs.libxcursor,
      drvs.libxcvt,
      drvs.libxext,
      drvs.libxfixes,
      drvs.libxfont2,
      drvs.libxkbcommon,
      drvs.libxkbfile,
      drvs.libxrender,
      drvs.libxshmfence,
      drvs.linuxHeaders,
      drvs.mesa2,
      drvs.nasm,
      drvs.openssl,
      drvs.pcre2,
      drvs.pixman,
      drvs.utilLinux,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.xcbProto,
      drvs.xcbRenderutil,
      drvs.xcbUtilWm,
      drvs.xorgMacros,
      drvs.xorgproto,
      drvs.xtrans,
      drvs.xz,
      drvs.zlibNg,
      drvs.zstd,
    ]
  }
}
