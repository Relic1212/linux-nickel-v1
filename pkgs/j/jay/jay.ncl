{
  lib,
  drvs,
  jay | lib.CargoPackage = {
    singleSource = {
      #   uri = "https://github.com/mahkoh/jay/archive/c6cebc754681eebb042a020e73aab2d6f71cc857.tar.gz",
      #   sha256sum = "c82697ccdc695fdac79f18b41727a28a514fc733d71436758ab21f22afa8e815",

      uri = "https://github.com/mahkoh/jay/archive/refs/tags/v1.11.1.tar.gz",
      sha256sum = "857e6df843bde64b4182eae355e677e935f85e3ad90a30919bdb9259f6728ac3",
    },
    crates = lib.functions.filterCrates (import "./jay-crates.json"),

    extraEnv.EXTRA_RUSTFLAGS = [
      m%"$(for l in $(pkg-config --libs --static gbm libinput libudev cairo pango pangofc pangoft2 gobject-2.0 libevdev glib-2.0 cairo-ft cairo-png);do printf " -C link-arg=$l ";done)"%,
      #   "-C link-arg=/tmp/workdir/src/symbols.c.o",
      "-lc++",
      "-C link-arg=-Wl,--error-limit=0",
    ],

    llvmProvider = drvs.llvmFull,
    biDrvs = [
      drvs.muslDlFactory & { priority = 1 },
      drvs.shaderc,
      drvs.alsaLibs,
      drvs.atSpi2Core,
      drvs.bluez,
      drvs.cairo,
      drvs.cairoGobjectEmpty,
      drvs.dbus,
      drvs.eudev,
      drvs.expat,
      drvs.fdkAac,
      drvs.ffmpeg,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.glib,
      drvs.gperf,
      drvs.harfbuzz,
      drvs.hwdata,
      drvs.jansson,
      drvs.jsonC,
      drvs.kmod,
      drvs.ldacbt,
      drvs.libdisplayinfo,
      drvs.libdlEgl,
      drvs.libdrm,
      drvs.libelf,
      drvs.libevdev,
      drvs.libffi,
      drvs.libinput,
      drvs.libjpegTurbo,
      drvs.libopus,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libsndfile,
      drvs.libusb,
      drvs.libxkbcommon,
      drvs.libyaml,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.lua,
      drvs.m4,
      drvs.mtdev,
      drvs.ncurses,
      drvs.openssl,
      drvs.pango,
      drvs.pcre2,
      drvs.pixman,
      drvs.readline,
      drvs.sbc,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.utilLinux,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.xz,
      drvs.zlibNg,
      drvs.zstd,
      drvs.pipewire,
      drvs.dinit,
      drvs.libstdcppCompat,
      drvs.mesaExp,
    ],

    propagatedBuildInputs = [
      drvs.seatd,
    ],
  }
}
