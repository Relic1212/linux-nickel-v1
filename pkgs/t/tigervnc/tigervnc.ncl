{
  lib,
  drvs,
  tigervnc | lib.CmakePackage = {
    generator = "Ninja",
    singleSource = {
      uri = "https://github.com/TigerVNC/tigervnc/archive/refs/tags/v1.16.2.tar.gz",
      sha256sum = "b107c0c8b8a962594281690366c24186e95c2ea4a169acbc0076aa62ed01f467",
    },
    buildEnv = {
      EXTRA_CFLAGS = [
        "-Wno-error=unused-but-set-global",
      ],
      EXTRA_LDFLAGS = [
        "$(pkg-config --libs --static xau)",
        "$(pkg-config --libs --static xcb)",
        "$(pkg-config --libs --static x11)",
        "$(pkg-config --libs --static x11-xcb)",
        "$(pkg-config --libs --static libpng)",
        "$(pkg-config --libs --static libswresample)",
        "$(pkg-config --libs --static freetype2)",
        "$(pkg-config --libs --static expat)",
        "$(pkg-config --libs --static xrender)",
      ],
    },
    preConfigurePhase = [
      m%"sed -i "s@#include <stdexcept>@#include <stdexcept>\n#include <new>@g" ${SRC}/vncviewer/Surface_X11.cxx"%,
      m%"sed -i "s@#include <assert.h>@#include <assert.h>\n#include <cstdlib>@g" ${SRC}/common/rfb/UnixPasswordValidator.cxx"%,
    ],
    # biDrvs = [
    #   drvs.xorgMacros,
    #   drvs.xorgproto,
    #   drvs.xtrans,
    #   drvs.libxcb,
    #   drvs.xcbProto,
    #   drvs.libxau,
    #   drvs.libx11,
    #   drvs.libxrender,
    #   drvs.libxfixes,
    #   drvs.libxext,
    #   drvs.libxinerama,
    #   drvs.pixman,
    #   drvs.zlibNg,
    #   drvs.libjpegTurboStatic,
    #   drvs.libpam,
    #   drvs.linuxHeaders,
    #   drvs.wayland,
    #   drvs.waylandProtocols,
    #   drvs.utilLinux,
    #   drvs.libxkbcommon,
    #   drvs.libffi,
    #   drvs.fltk,
    # ]

    biDrvs = [
      drvs.bison,
      drvs.cairoXlib,
      drvs.dbus,
      drvs.expat,
      drvs.ffmpeg,
      drvs.fltk13,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.glib,
      drvs.glu,
      drvs.gperf,
      drvs.harfbuzz,
      drvs.libdecor,
      drvs.libdrm,
      drvs.libelf,
      drvs.libffi,
      drvs.libfontenc,
      drvs.libjpegTurboStatic,
      drvs.libpam,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libx11,
      drvs.libxau,
      drvs.libxcb,
      drvs.libxcursor,
      drvs.libxcvt,
      drvs.libxext,
      drvs.libxf86vm,
      drvs.libxfixes,
      drvs.libxfont2,
      drvs.libxft,
      drvs.libxinerama,
      drvs.libxkbcommon,
      drvs.libxkbfile,
      drvs.libxrandr,
      drvs.libxrender,
      drvs.libxshmfence,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.m4,
      drvs.mesaGlx,
      drvs.nasm,
      drvs.ncurses,
      drvs.openssl,
      drvs.pango,
      drvs.pcre2,
      drvs.pixman,
      drvs.spirvHeaders,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.utilLinux,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.xcbProto,
      drvs.xcbRenderutil,
      drvs.xcbUtilErrors,
      drvs.xcbUtilWm,
      drvs.xorgMacros,
      drvs.xorgproto,
      drvs.xtrans,
      drvs.zlibNg,
      drvs.libxi,
    ]
  }
}
