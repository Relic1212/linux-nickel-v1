{
  lib,
  drvs,
  wofi | lib.MesonPackage = {
    singleSource = {
      uri = "https://hg.sr.ht/~scoopta/wofi/archive/v1.5.3.tar.gz",
      sha256sum = "6216dc14d93cdb6170f89c1ca3aaacdeaa44862fbc9be947d614be266a9c49f6"
    },
    buildEnv = {
      EXTRA_LDFLAGS = [
        # "/tmp/workdir/src/dlopen.o",
      ],
    },
    preConfigurePhase = [
      lib.functions.writeFile "${SRC}/src/dlopen.c" (import "wofi_dlopen.c" as 'Text),
      # "${CC} ${CFLAGS} -Werror -c ${SRC}/dlopen.c -o ${SRC}/dlopen.o",
      m%"sed -i "s@'src/main.c'@'src/main.c','src/dlopen.c'@g" ${SRC}/meson.build"%,
    ],
    extraMesonArgs = [
      "-Denable_drun=true",
      "-Denable_run=true",
      "-Denable_dmenu=true",
    ],
    llvmProvider = drvs.llvmFull,
    muslProvider = drvs.muslBothWeakDl,

    biDrvs = [
      #drvs.cairo,
      drvs.atSpi2Core,
      drvs.cairoXlib,
      drvs.expat,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.glibDynamic,
      drvs.gobjectDynamic,
      drvs.gperf,
      drvs.harfbuzz,
      drvs.hwdata,
      drvs.libdrm,
      drvs.libelf,
      drvs.libepoxy,
      drvs.libffi,
      drvs.libfontenc,
      drvs.libjpegTurbo,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libx11,
      drvs.libxau,
      drvs.libxcb,
      drvs.libxcursor,
      drvs.libxcvt,
      drvs.libxfixes,
      drvs.libxfont2,
      drvs.libxkbcommon,
      drvs.libxkbfile,
      drvs.libxrender,
      drvs.libxshmfence,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.mesa2,
      drvs.muslShared,
      drvs.ncurses,
      drvs.openssl,
      drvs.pango,
      drvs.pcre2,
      drvs.pixman,
      drvs.readline,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.xcbProto,
      drvs.xcbRenderutil,
      drvs.xcbUtilWm,
      drvs.xorgMacros,
      drvs.xorgproto,
      drvs.xtrans,
      drvs.xwayland,
      drvs.zlibNg,
      drvs.isoCodes,
      drvs.libxext,
      drvs.libxf86vm,
      drvs.libxrandr,
      drvs.gtk3,
    ],
  }
}
