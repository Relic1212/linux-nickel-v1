{
  lib,
  drvs,
  waybar | lib.MesonPackage
    = {
      singleSource = {
        uri = "https://github.com/Alexays/Waybar/archive/refs/tags/0.11.0.tar.gz",
        sha256sum = "6a0e9f0f7f2eff503951958cbb16dc39041c0b67e86c35154e8507677c61be9d"
      },

      llvmProvider = drvs.llvmFull,
      pythonProvider = drvs.pythonDynamic,

      biDrvs = [
        drvs.fontconfig,
        drvs.freetype,
        drvs.zlibNg,
        drvs.gperf,
        drvs.pixman,
        drvs.wayland,
        drvs.waylandProtocols,
        drvs.libffi,
        drvs.libxkbcommonWithRegistry,
        drvs.libxml2,
        drvs.expat,
        drvs.linuxHeaders,
        drvs.ncurses,
        drvs.readline,
        drvs.pcre2,
        drvs.pango,
        drvs.cairo,
        drvs.libpng,
        drvs.harfbuzz,
        drvs.glibDynamic,
        drvs.muslShared,
        drvs.hwdata,
        drvs.gobjectDynamic,
        drvs.cairoGobject,
        drvs.fribidi,
        drvs.gdkPixbufFull,
        drvs.libjpegTurbo,
        drvs.libepoxy,
        drvs.atSpi2Core,
        drvs.mesa2,
        drvs.libelf,
        drvs.libdrm,
        drvs.libpciaccess,
        drvs.llvmConfigStatic,
        drvs.spirvTools,
        drvs.spirvLlvmTranslator,
        drvs."gtk+3",
        drvs."libsigc++2",
        drvs."cairomm-1.0",
        drvs."pangomm",
        drvs.glibmm,
        drvs.pythonSetuptools,
        drvs.gtkmm3,
        drvs.fmt,
        drvs.spdlog,
        drvs.libevdev,
        drvs.jsoncpp,
        drvs.scdoc,
        drvs.gtkLayerShell,

        # drvs.libinput,
        # drvs.epollShim,
        # drvs.mtdev,
        drvs.eudev,
        drvs.sndiod,
        drvs.upower,

        # drvs.libnl,
      ],

      extraMesonArgs = [
        "-Dlibinput=disabled",
        "-Dlibudev=enabled",
        "-Dlibevdev=enabled",
        "-Dupower_glib=enabled",
        "-Dman-pages=enabled",
        "-Drfkill=enabled",
        "-Dsndio=enabled",
        "-Dlibnl=disabled",
      ]
    }
}
