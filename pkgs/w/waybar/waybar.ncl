{
  lib,
  fontconfig,
  freetype,
  zlibNg,
  gperf,
  pixman,
  wayland,
  waylandProtocols,
  libffi,
  libxkbcommonWithRegistry,
  libxml2,
  expat,
  linuxHeaders,
  ncurses,
  readline,
  pcre2,
  pango,
  cairo,
  libpng,
  harfbuzz,
  glibDynamic,
  muslShared,
  hwdata,
  gobjectDynamic,
  cairoGobject,
  fribidi,
  gdkPixbufFull,
  libjpegTurbo,
  libepoxy,
  atSpi2Core,
  mesa2,
  libelf,
  libdrm,
  libpciaccess,
  llvmConfigStatic,
  spirvTools,
  spirvLlvmTranslator,
  gtk3,
  libsigcpp2,
  cairomm_1_0,
  pangomm,
  glibmm,
  pythonSetuptools,
  gtkmm3,
  fmt,
  spdlog,
  libevdev,
  jsoncpp,
  scdoc,
  gtkLayerShell,
  libinput,
  epollShim,
  mtdev,
  eudev,
  sndiod,
  upower,
  libnl,
  llvmFull,
  pythonDynamic,

  waybar | lib.MesonPackage = {
    singleSource = {
      #uri = "https://github.com/Alexays/Waybar/archive/refs/tags/0.11.0.tar.gz",
      #sha256sum = "6a0e9f0f7f2eff503951958cbb16dc39041c0b67e86c35154e8507677c61be9d",

      uri = "https://github.com/Alexays/Waybar/archive/refs/tags/0.12.0.tar.gz",
      sha256sum = "80454a0778176f575c112bdef9107f272621b578aa629bcc257ad9844a6c7165"
    },

    llvmProvider = lib.singleBiMap llvmFull,
    pythonProvider = lib.singleBiMap pythonDynamic,

    biDrvs =
      lib.biMap [
        fontconfig,
        freetype,
        zlibNg,
        gperf,
        pixman,
        wayland,
        waylandProtocols,
        libffi,
        libxkbcommonWithRegistry,
        libxml2,
        expat,
        linuxHeaders,
        ncurses,
        readline,
        pcre2,
        pango,
        cairo,
        libpng,
        harfbuzz,
        glibDynamic,
        muslShared,
        hwdata,
        gobjectDynamic,
        cairoGobject,
        fribidi,
        gdkPixbufFull,
        libjpegTurbo,
        libepoxy,
        atSpi2Core,
        mesa2,
        libelf,
        libdrm,
        libpciaccess,
        llvmConfigStatic,
        spirvTools,
        spirvLlvmTranslator,
        gtk3,
        libsigcpp2,
        cairomm_1_0,
        pangomm,
        glibmm,
        pythonSetuptools,
        gtkmm3,
        fmt,
        spdlog,
        libevdev,
        jsoncpp,
        scdoc,
        gtkLayerShell,

        # libinput,
        # epollShim,
        # mtdev,
        eudev,
        sndiod,
        upower,

        # libnl,
      ],

    extraMesonArgs = [
      "-Dlibinput=disabled",
      "-Dlibudev=enabled",
      "-Dlibevdev=enabled",
      "-Dupower_glib=enabled",
      "-Dman-pages=enabled",
      "-Drfkill=enabled",
      "-Dsndio=enabled",
      "-Dlibnl=disabled",
    ]
  }
}
