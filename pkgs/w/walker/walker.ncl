{
  lib,
  drvs,
  walker | lib.CargoPackage = {
    singleSource = {
      uri = "https://github.com/abenz1267/walker/archive/refs/tags/v2.16.0.tar.gz",
      sha256sum = "c099b910616d4eb659803981dc96a4efcaefdee853048d634ace90051aeedabe",
    },

    crates = lib.functions.filterCrates (import "walker-crates.json"),

    linkSelfContained = "no",
    extraEnv = {
      EXTRA_RUSTFLAGS = [
        "-C link-arg=/tmp/workdir/src/dlopen.o",
        # "-C link-arg=-no-pie",
        # "-C relocation-model=static",

        # "-C link-arg=-l:libdl_ashell",
        # "-C link-arg=$(clang --print-file-name=libclang_rt.builtins-x86_64.a)",
        "-C link-arg=-lc++",
        m%"$(for l in $(pkg-config --libs --static xkbcommon egl wayland-client wayland-egl poppler);do printf " -C link-arg=$l ";done)"%,
      ],
    },
    extraCargoFlags = [
      "--verbose",
    ],
    configurePhase = [
      "mkdir /tmp/home",
      "export HOME=/tmp/home",
      #
      #   m%"sed -i 's/\("files":{\)[^}]*/\1/' vendor/*/.cargo-checksum.json"%,
      ######
      ######
      # "echo '%{import "../../i/ironbar/ironbar_dlopen.c" as 'Text}' > ${SRC}/dlopen.c",
      "echo '%{import "walker_dlopen.c" as 'Text}' > ${SRC}/dlopen.c",
      "${CC} ${CFLAGS} -c ${SRC}/dlopen.c -o ${SRC}/dlopen.o",
      "cargo tree --target=x86_64-unknown-linux-musl -e features",
    ],

    muslProvider = drvs.muslBothRenamedDl,
    llvmProvider = drvs.llvmFull,
    biDrvs = [
      drvs.atSpi2Core,
      drvs.cairo,
      drvs.cairoGobject,
      drvs.cairomm_1_16,
      drvs.dbus,
      drvs.expat,
      drvs.eudev,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.glibPatched,
      drvs.glibmm_2_82,
      drvs.gobjectDynamic,
      drvs.gperf,
      drvs.graphene,
      drvs.gtk4,
      drvs.gtk4LayerShell,
      drvs.gtkmm4,
      drvs.harfbuzzFull,
      drvs.hwdata,
      drvs.libdrm,
      drvs.libelf,
      drvs.libepoxy,
      drvs.libevdev,
      drvs.libffi,
      drvs.libjpegTurboStatic,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libsigcpp,
      drvs.libtiff,
      drvs.libxkbcommon,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.mesaExp,
      drvs.ncurses,
      drvs.pango,
      drvs.pangomm_2_48,
      drvs.pcre2,
      drvs.pixman,
      drvs.readline,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.vala,
      drvs.waylandGtk4LayerShell,
      drvs.waylandProtocols,
      drvs.zlibNg,
      #
      drvs.kmod,
      drvs.xz,
      drvs.openssl,
      drvs.zstd,
      drvs.utilLinux,
      #
      #   drvs.luajitStatic,
      #
      drvs.libinput,
      drvs.mtdev,
      #
      #   drvs.alsaLibs,
      #   drvs.bluez,
      #   drvs.sbc,
      #   drvs.ffmpeg,
      #   drvs.speex,
      #   drvs.speexdsp,
      #   drvs.check,
      #   drvs.pulseaudio17,
      drvs.poppler,
      drvs.curl,
      drvs.lcms,
      drvs.libpsl,
      drvs.protobuf,
    ],
  }
}
