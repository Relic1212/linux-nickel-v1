    singleSource = {
      uri = "https://gitlab.freedesktop.org/wlroots/wlroots/-/archive/0.19.2/wlroots-0.19.2.tar.bz2",
      sha256sum = "804bd3eab10f03556628c4e977351b0b1b17bc34084342dfaff5086c54ce1fa0",
