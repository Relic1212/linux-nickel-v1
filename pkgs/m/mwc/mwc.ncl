{
  lib,
  expat,
  jsonC,
  pcre2,
  mesa2,
  spirvTools,
  wayland,
  waylandProtocols,
  libelf,
  libpciaccess,
  libdrm,
  libxkbcommon,
  pixman,
  eudev,
  seatd,
  libdisplayinfo,
  libinput,
  libffi,
  libevdev,
  mtdev,
  pango,
  cairo,
  libpng,
  freetype,
  fontconfig,
  zlibNg,
  harfbuzz,
  glib,
  hwdata,
  linuxHeaders,
  gdkPixbufFull,
  libjpegTurbo,
  basu,
  lcms,
  scdoc,
  libxcursor,
  xorgMacros,
  xorgproto,
  xtrans,
  libxcb,
  xcbProto,
  libxau,
  libx11,
  libxrender,
  libxfixes,
  xcbRenderutil,
  libxfont2,
  libfontenc,
  libxcvt,
  libxshmfence,
  xwayland,
  libxkbfile,
  openssl,
  xcbUtilWm,
  wlroots18,
  scenefx,
  llvmFull,

  mwc | lib.MesonPackage = {
    sourceInputs = [
      {
        src = {
          uri = "https://github.com/dqrk0jeste/mwc/archive/refs/tags/v0.1.3.tar.gz",
          sha256sum = "f723fe07c62703761b86d77c6afd9021647c5938f9bf4cda8c918327fe9c2522"
        }
      }
    ],
    llvmProvider = lib.singleBiMap llvmFull,
    biDrvs =
      lib.biMap [
        expat,
        jsonC,
        pcre2,
        mesa2,
        spirvTools,
        wayland,
        #waylandProtocols_1_41,
        waylandProtocols,
        libelf,
        libpciaccess,
        libdrm,
        libxkbcommon,
        pixman,
        eudev,
        seatd,
        libdisplayinfo,
        libinput,
        libffi,
        libevdev,
        mtdev,
        pango,
        cairo,
        libpng,
        freetype,
        fontconfig,
        zlibNg,
        harfbuzz,
        glib,
        hwdata,
        linuxHeaders,
        gdkPixbufFull,
        libjpegTurbo,
        basu,
        lcms,
        scdoc,
        libxcursor,
        xorgMacros,
        xorgproto,
        xtrans,
        libxcb,
        xcbProto,
        libxau,
        libx11,
        libxrender,
        libxfixes,
        xcbRenderutil,
        libxfont2,
        libfontenc,
        libxcvt,
        libxshmfence,
        xwayland,
        libxkbfile,
        openssl,
        xcbUtilWm,
        wlroots18,
        scenefx,
      ],

    buildEnv = {
      EXTRA_LDFLAGS = [
        "-lc++"
      ],
    },
  }
}
