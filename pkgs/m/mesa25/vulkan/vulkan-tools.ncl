{
  lib,
  drvs,
  vulkanTools | lib.CmakePackage = {
    generator = "Ninja",
    singleSource = {
      uri = "https://github.com/KhronosGroup/Vulkan-Tools/archive/refs/tags/v1.4.343.tar.gz",
      sha256sum = "c32b1145b0786d5a2f6ee7f63ba57873a4079ee848474b6ffd849b0ffa599f28",
    },
    patches = [
      #   {
      #     sha256sum = "94adcd41e39f05f362a39f6002665ccf40961797fd20ed8f7580eee516346000",
      #     file = "vulkan-tools.patch"
      #   },
      {
        sha256sum = "335ab8b216f63d5aca4692fb24cdb896c11709003458fb47cedc3566d6a85a31",
        file = "vulkan-tools-dl.patch"
      }
    ],
    debug = true,
    preConfigurePhase = [
      m%"sed -i 's|MODULE|STATIC|g' ${SRC}/icd/CMakeLists.txt"%,
      "echo '%{ import "vulkan-tools-dl.c" as 'Text }' > ${SRC}/dlopen.c",
      "${CC} ${CFLAGS} -c ${SRC}/dlopen.c -o ${SRC}/dlopen.o",
    ],
    buildEnv = {
      # EXTRA_CPPFLAGS = [
      #   "-DVK_ONLY_EXPORTED_PROTOTYPES",
      # ],
      # EXTRA_CFLAGS = [
      #   "-DVK_ONLY_EXPORTED_PROTOTYPES",
      # ],
      # EXTRA_CXXFLAGS = [
      #   "-DVK_ONLY_EXPORTED_PROTOTYPES",
      # ],
      EXTRA_LDFLAGS = [
        "-Wl,--error-limit=0",
        "-Wl,-u,vkEnumerateInstanceVersion",
        "-Wl,-u,radv_EnumerateInstanceVersion",
        # "-Wl,-u,radv_CreateDebugReportCallbackEXT",
        "-Wl,-u,vk_common_CreateDebugReportCallbackEXT",
        "-Wl,-u,vk_common_GetPhysicalDeviceProperties2",
        ##
        "-Wl,-u,vkGetInstanceProcAddr",
        "-Wl,-u,vkEnumerateInstanceExtensionProperties",
        "-Wl,-u,vkEnumerateInstanceLayerProperties",
        "-Wl,-u,vkEnumerateInstanceVersion",
        "-Wl,-u,vkCreateInstance",
        "-Wl,-u,vkCreateWin32SurfaceKHR",
        "-Wl,-u,vkCreateWaylandSurfaceKHR",
        "-Wl,-u,vkCreateAndroidSurfaceKHR",
        "-Wl,-u,vkCreateXlibSurfaceKHR",
        "-Wl,-u,vkCreateXcbSurfaceKHR",
        "-Wl,-u,vkCreateMetalSurfaceEXT",
        "-Wl,-u,vkCreateMacOSSurfaceMVK",
        "-Wl,-u,vkCreateScreenSurfaceQNX",
        "-Wl,-u,vkCreateDisplayPlaneSurfaceKHR",
        "-Wl,-u,vkCreateDirectFBSurfaceEXT",
        "-Wl,-u,vkCreateStreamDescriptorSurfaceGGP",
        "-Wl,-u,vkCreateDebugReportCallbackEXT",
        "-Wl,-u,vkCreateDevice",
        "-Wl,-u,vkDestroyDebugReportCallbackEXT",
        "-Wl,-u,vkDestroyInstance",
        "-Wl,-u,vkDestroySurfaceKHR",
        "-Wl,-u,vkEnumerateDeviceExtensionProperties",
        "-Wl,-u,vkGetDisplayModePropertiesKHR",
        "-Wl,-u,vkGetDisplayPlaneCapabilitiesKHR",
        "-Wl,-u,vkGetDisplayPlaneSupportedDisplaysKHR",
        "-Wl,-u,vkGetPhysicalDeviceDisplayPlanePropertiesKHR",
        "-Wl,-u,vkGetPhysicalDeviceDisplayPropertiesKHR",
        "-Wl,-u,vkGetPhysicalDeviceFeatures",
        "-Wl,-u,vkGetPhysicalDeviceFormatProperties",
        "-Wl,-u,vkGetPhysicalDeviceMemoryProperties",
        "-Wl,-u,vkGetPhysicalDeviceProperties",
        "-Wl,-u,vkGetPhysicalDeviceQueueFamilyProperties",
        "-Wl,-u,vkGetPhysicalDeviceSurfaceCapabilitiesKHR",
        "-Wl,-u,vkGetPhysicalDeviceSurfaceFormatsKHR",
        "-Wl,-u,vkGetPhysicalDeviceSurfacePresentModesKHR",
        "-Wl,-u,vkGetPhysicalDeviceSurfaceSupportKHR",
        "-Wl,-u,vkGetPhysicalDeviceVideoCapabilitiesKHR",
        "-Wl,-u,vkGetPhysicalDeviceSurfaceFormats2KHR",
        "-Wl,-u,vkGetPhysicalDeviceSurfaceCapabilities2KHR",
        "-Wl,-u,vkGetPhysicalDeviceVideoFormatPropertiesKHR",
        "-Wl,-u,vkEnumeratePhysicalDeviceGroupsKHR",
        "-Wl,-u,vkGetDeviceGroupPresentCapabilitiesKHR",
        "-Wl,-u,vkGetPhysicalDeviceImageFormatProperties",
        "-Wl,-u,vkGetPhysicalDeviceProperties2KHR",
        "-Wl,-u,vkGetPhysicalDeviceMemoryProperties2KHR",
        "-Wl,-u,vkGetPhysicalDeviceFeatures2KHR",
        "-Wl,-u,vkGetPhysicalDeviceQueueFamilyProperties2KHR",
        "-Wl,-u,vkEnumeratePhysicalDevices",
        "-Wl,-u,vkGetPhysicalDeviceSurfaceCapabilities2EXT",
        "-Wl,-u,vkGetPhysicalDeviceToolPropertiesEXT",
        "-Wl,-u,vkGetPhysicalDeviceFormatProperties2KHR",
        "-Wl,-u,vkGetPhysicalDeviceCooperativeMatrixPropertiesKHR",
        "-Wl,-u,vkGetPhysicalDeviceCalibrateableTimeDomainsKHR",
        "-Wl,-u,vkGetPhysicalDeviceFragmentShadingRatesKHR",
        "-Wl,-u,vkGetPhysicalDeviceMultisamplePropertiesEXT",
        "-Wl,-u,vkCreateImage",
        "-Wl,-u,vkGetImageMemoryRequirements",
        "-Wl,-u,vkDestroyImage",
        "-Wl,-u,vkDestroyDevice",

        # "-Wl,-u,vk_common_EnumerateInstanceVersion",
        # "-Wl,-u,wsi_EnumerateInstanceVersion",
        "/tmp/workdir/src/dlopen.o",

        # "-DVK_ONLY_EXPORTED_PROTOTYPES",
        "$(pkg-config --libs --static xau)",
        "$(pkg-config --libs --static xcb)",
        "$(pkg-config --libs --static x11)",
        "$(pkg-config --libs --static x11-xcb)",
        "$(pkg-config --libs --static wayland-client)",
        "$(pkg-config --libs --static vulkan_radeon)",
        "-lVkLayer_MESA_device_select",
        # "-ldl_vulkan",
        "-lvulkan",
        "-lc++",
        "-lc",
        # "-l:libVkLayer_MESA_device_select.a",
        # "-Wl,-u,vk_common_GetPhysicalDeviceProperties2",
        # "-Wl,-u,vk_common_CreateSamplerYcbcrConversion",
        # "-Wl,-u,radv_CreateSampler",
        # "-Wl,-u,radv_CreateDescriptorPool",
        # "-Wl,-u,vk_common_CreateFramebuffer",
        # "-Wl,-u,vk_common_CmdCopyBufferToImage",
        # "-Wl,-u,radv_CmdCopyBufferToImage2",
        # "-Wl,-u,radv_AllocateDescriptorSets",
        # "-Wl,-u,radv_GetInstanceProcAddr",
        # "$(pkg-config --libs --static vulkan_radeon)",
      ],
    },
    cmakeExtraArgsRecord = {
      "-DBUILD_CUBE" = false,
    },
    llvmProvider | priority 1 = drvs.llvmFullDebug,
    muslProvider = drvs.muslBothRenamedDl,
    debug = true,

    biDrvs = [
      drvs.gnupatch & { priority = 1 },
      drvs.libelf,
      drvs.libdrmDebug,
      drvs.zlibNg,
      drvs.pythonMako,
      drvs.pythonPackaging,
      drvs.pythonMarkupsafe,
      drvs.libpciaccess,
      drvs.libffi,
      drvs.bison,
      drvs.flex,
      drvs.linuxHeaders,
      drvs.m4,
      drvs.git,
      drvs.pyyaml,
      drvs.llvmConfigStatic,
      drvs.spirvToolsDebug,
      drvs.glslangDebug,
      drvs.spirvLlvmTranslatorDebug,
      drvs.waylandWeaksyms2,
      drvs.waylandProtocols,
      drvs.libxcursor,
      drvs.xorgMacros,
      drvs.xorgproto,
      drvs.xtrans,
      drvs.libxcb,
      drvs.xcbProto,
      drvs.libxau,
      drvs.libx11,
      drvs.libxrender,
      drvs.libxfixes,
      drvs.xcbRenderutil,
      drvs.libxfont2,
      drvs.libfontenc,
      drvs.libxcvt,
      drvs.libxshmfence,
      # drvs.xwayland,
      drvs.libxkbfile,
      drvs.openssl,
      drvs.xcbUtilWm,
      drvs.xcbUtilErrors,
      drvs.libxext,
      drvs.libxf86vm,
      drvs.libxrandr,
      drvs.zstd,
      drvs.mesaFullDl,
      drvs.vulkanHeaders,
      drvs.vulkanLoaderDl,
      # drvs.libdl_vulkan,
    ]
  }
}
