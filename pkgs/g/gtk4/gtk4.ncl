{
  lib,
  drvs,
  gtk4 | lib.MesonPackage = {
    singleSource = {
      uri = "https://download.gnome.org/sources/gtk/4.18/gtk-4.18.6.tar.xz",
      sha256sum = "e1817c650ddc3261f9a8345b3b22a26a5d80af154630dedc03cc7becefffd0fa",
    },
    llvmProvider = drvs.llvmFull,
    biDrvs = [
      drvs.fontconfig,
      drvs.freetype,
      drvs.zlibNg,
      drvs.gperf,
      drvs.pixman,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.libffi,
      drvs.libxkbcommon,
      drvs.expat,
      drvs.linuxHeaders,
      drvs.ncurses,
      drvs.readline,
      drvs.pcre2,
      drvs.pango,
      drvs.cairo,
      drvs.libpng,
      drvs.glibDynamic,
      drvs.muslShared,
      drvs.hwdata,
      drvs.gobjectDynamic,
      drvs.cairoGobject,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.libjpegTurbo,
      drvs.libepoxy,
      drvs.atSpi2Core,
      drvs.mesa2,
      drvs.libelf,
      drvs.libdrm,
      drvs.libpciaccess,
      drvs.llvmConfigStatic,
      drvs.spirvTools,
      drvs.spirvLlvmTranslator,
      drvs.libtiff,
      drvs.graphene,
      drvs.harfbuzzFull,
    ],

    extraMesonArgs = [
      "-Dwayland-backend=true",
      "-Dx11-backend=false",
      "-Dmedia-gstreamer=disabled",
      "-Dvulkan=disabled",
      "-Df16c=disabled",
      "-Dintrospection=disabled",
      "-Dbuild-demos=false",
      "-Dbuild-testsuite=false",
      "-Dbuild-examples=false",
      "-Dbuild-tests=false",

      # "-Dgtk_doc=false",
    ],
    preConfigurePhase = [
      "sed -i 's@shared_library@library@g' ${SRC}/gtk/meson.build"
    ]
  }
}
