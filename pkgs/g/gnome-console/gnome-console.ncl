{
  lib,
  drvs,

  gnomeConsole | lib.MesonPackage = {
    singleSource = {
      uri = "https://gitlab.gnome.org/GNOME/console/-/archive/47.2.1/console-47.2.1.tar.gz",
      sha256sum = "954d346b4ad4c6f1089e68088d2112c7d1e2e1b52232d323ea411acc73dc75c9",
      # uri = "https://gitlab.gnome.org/GNOME/console/-/archive/49.1/console-49.1.tar.bz2",
      # sha256sum = "970f195dc3743a92f6662fc94d1ba4732b9effeccbfbb92760c07fcd7aa82514",
    },

    patches = [
      {
        sha256sum = "0a7591e5e2cb0e8fc1216906384c58c05807760cb2c1948ee6968c88fb9cd32f",
        file = "0001-locale.patch",
      }
    ],

    buildEnv.EXTRA_LDFLAGS = [
      "-lc++",
      "-ldl_factory",
      "$(pkg-config --static --libs egl)",
    ],
    preConfigurePhase = [
      m%"echo '%{import "./kgx_symbols.c" as 'Text}' > ${SRC}/kgx_symbols.c"%,
      "${CC} ${CFLAGS} -c ${SRC}/kgx_symbols.c -o ${SRC}/symbols.o",
      m%"sed -i "s@c_args: kgx_cargs,@c_args: kgx_cargs,\nlink_args: '/tmp/workdir/src/symbols.o',@g" ${SRC}/src/meson.build"%,
    ],
    llvmProvider = drvs.llvmFull,

    muslProvider = drvs.muslBothRenamedDl,
    biDrvs = [
      drvs.libdlFactory,

      #drvs.harfbuzz,
      drvs.atSpi2Core,
      drvs.cairo,
      drvs.cairoGobject,
      drvs.eudev,
      drvs.expat,
      drvs.feedbackd,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.gettext,
      # drvs.glibDynamic,
      # drvs.glibDynamic2,
      # drvs.glib,
      drvs.glibPatched,
      drvs.gmobile,
      drvs.gnomeDesktop,
      drvs.gobjectDynamic,
      drvs.gperf,
      drvs.graphene,
      drvs.gsettingsDesktopSchemas,
      drvs.gsound,
      drvs.gtk4_21,
      drvs.gudev,
      drvs.harfbuzzFull,
      drvs.hwdata,
      drvs.isoCodes,
      drvs.jsonGlib,
      drvs.kmod,
      drvs.libbsd,
      drvs.libcanberra,
      drvs.libdrm,
      drvs.libelf,
      drvs.libepoxy,
      drvs.libffi,
      drvs.libgtop,
      drvs.libjpegTurbo,
      drvs.libmd,
      drvs.libogg,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libportal,
      drvs.libpsl,
      drvs.librsvg,
      drvs.libseccomp,
      drvs.libtiff,
      drvs.libtool,
      drvs.libvorbis,
      drvs.libxkbcommon,
      drvs.libxml2,
      drvs.libxmlb,
      drvs.libyaml,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.mesa2,
      drvs.ncurses,
      drvs.openssl,
      drvs.pango,
      drvs.pcre2,
      drvs.pixman,
      drvs.readline,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.utilLinux,
      drvs.vala,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.xkeyboardConfig,
      drvs.xz,
      drvs.zlibNg,
      drvs.zstd,
      drvs.libadwaitaShared_181,
      drvs.curl,
      drvs.appstream,
      drvs.vte,
      drvs.lz4,
      drvs.desktopFileUtils,
      drvs.simdutf,
      drvs.fmt,
      drvs.gmp,
      drvs.libtasn1,
      drvs.nettleGmp,
      drvs.gnutls,
    ],
  }
}
