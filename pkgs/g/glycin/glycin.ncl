{
  lib,
  drvs,
  glycin | lib.CargoPackage = {
    singleSource = {
      uri = "https://gitlab.gnome.org/GNOME/glycin/-/archive/2.1.1/glycin-2.1.1.tar.bz2",
      sha256sum = "ce7044dea45e23e4cf7b2dca4d39a875865e761268944d22376778f8df474c6c",
    },

    crates = lib.functions.filterCrates (import "glycin-crates.json" as 'Json),

    buildPhase =
      let extraMesonArgs = [
        "-Dglycin-loaders=false",
        "-Dintrospection=false",
        "-Dvapi=false",
        "-Dcapi_docs=false",
        "-Dglycin-thumbnailer=false",
        "-Dlto=false",
      ]
      in
      let mesonArgs = lib.constants.mesonArgs @ extraMesonArgs in
      [
        m%"sed -i "s@'--target-dir'@'--verbose','--target=x86_64-unknown-linux-musl', '--target-dir'@g" ${SRC}/libglycin/meson.build"%,
        m%"sed -i "s@rust_target@'x86_64-unknown-linux-musl' / rust_target@g" ${SRC}/libglycin/meson.build"%,
        # m%"sed -i "s@env: cargo_env_module,@# env: cargo_env_module,@g" ${SRC}/libglycin/meson.build"%,
        "sed -i 's|cdylib|staticlib|g' ${SRC}/libglycin/Cargo.toml",
        m%"sed -i "s@\.so@\.a@g" ${SRC}/libglycin/meson.build"%,
        m%"sed -i "s@soversion@# soversion@g" ${SRC}/libglycin/meson.build"%,
        m%"sed -i "s@= library@= static_library@g" ${SRC}/libglycin/meson.build"%,
        "sed -i 's|cdylib|staticlib|g' ${SRC}/libglycin/libglycin-gtk4/Cargo.toml",
        m%"sed -i "s|println|\/\/ println|g" ${SRC}/libglycin/build.rs"%,
        m%"sed -i "s|println|\/\/ println|g" ${SRC}/libglycin/libglycin-gtk4/build.rs"%,
        # m%"sed -i "s@\.so@\.a@g" ${SRC}/libglycin/libglycin-gtk4/meson.build"%,
        "mkdir bin",
        lib.functions.writeFile "bin/cargo" (import "cargo.sh" as 'Text),
        "chmod +x bin/cargo",
        "export PATH=\"$(pwd)/bin:$PATH\"",
        "echo \"cargo=$(which cargo)\"",
        "meson setup %{std.string.join " " mesonArgs} build",
        "(cd build && meson compile --verbose)",
      ],
    installPhase = [
      "(cd build && meson install --destdir ${DEST})",
    ],
    llvmProvider = drvs.llvmFull,

    biDrvs = [
      drvs.samurai,
      drvs.pythonFull,
      drvs.meson,
      drvs.musl,
      drvs.libseccomp,
      drvs.lcms,
      drvs.atSpi2Core,
      drvs.cairo,
      drvs.cairoGobject,
      drvs.expat,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.glibDynamic,
      drvs.gobjectDynamic,
      drvs.gperf,
      drvs.graphene,
      drvs.gtk4,
      drvs.harfbuzzFull,
      drvs.hwdata,
      drvs.libdrm,
      drvs.libelf,
      drvs.libepoxy,
      drvs.libffi,
      drvs.libjpegTurbo,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libtiff,
      drvs.libxkbcommon,
      drvs.libxml2,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.mesa2,
      #   drvs.muslShared,
      drvs.ncurses,
      drvs.pango,
      drvs.pcre2,
      drvs.pixman,
      drvs.readline,
      drvs.sharedMimeInfo,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.zlibNg,
      #   drvs.rust,
    ]
  }
}
