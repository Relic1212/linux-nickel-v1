{
  lib,
  fontconfig,
  freetype,
  zlibNg,
  gperf,
  pixman,
  wayland,
  waylandProtocols,
  libffi,
  libxkbcommon,
  expat,
  linuxHeaders,
  ncurses,
  readline,
  pcre2,
  pango,
  cairo,
  libpng,
  harfbuzz,
  glibDynamic,
  muslShared,
  hwdata,
  gobjectDynamic,
  cairoGobject,
  fribidi,
  gdkPixbufFull,
  libjpegTurbo,
  libepoxy,
  atSpi2Core,
  mesa2,
  libelf,
  libdrm,
  libpciaccess,
  llvmConfigStatic,
  spirvTools,
  spirvLlvmTranslator,
  gtk3,
  gtkLayerShell,
  jsonC,
  seatd,
  libdisplayinfo,
  libinput,
  libevdev,
  mtdev,
  eudev,
  xz,
  openssl,
  kmod,
  zstd,
  llvmFull,

  gtkgreet | lib.MesonPackage = {
    singleSource = {
      uri = "https://git.sr.ht/~kennylevinsen/gtkgreet/archive/ac3f9ec05ee2fdd116081869b808a429538816a5.tar.gz",
      sha256sum = "90b0f6df134c04ca8169c4d3a53e1aca66368379f2209736de2a6812c351d95e",
    },

    llvmProvider = lib.singleBiMap llvmFull,

    biDrvs =
      lib.biMap [
        fontconfig,
        freetype,
        zlibNg,
        gperf,
        pixman,
        wayland,
        waylandProtocols,
        libffi,
        libxkbcommon,
        expat,
        linuxHeaders,
        ncurses,
        readline,
        pcre2,
        pango,
        cairo,
        libpng,
        harfbuzz,
        glibDynamic,
        muslShared,
        hwdata,
        gobjectDynamic,
        cairoGobject,
        fribidi,
        gdkPixbufFull,
        libjpegTurbo,
        libepoxy,
        atSpi2Core,
        mesa2,
        libelf,
        libdrm,
        libpciaccess,
        llvmConfigStatic,
        spirvTools,
        spirvLlvmTranslator,
        gtk3,
        gtkLayerShell,
        jsonC,
        seatd,
        libdisplayinfo,
        libinput,
        libevdev,
        mtdev,
        eudev,
        xz,
        openssl,
        kmod,
        zstd,
      ],
    preConfigurePhase = [
      m%"sed -i 's@werror=true@werror=false@g' ${SRC}/meson.build"%
    ],
  }
}
