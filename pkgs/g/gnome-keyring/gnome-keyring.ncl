let src = {
  uri = "https://download.gnome.org/sources/gnome-keyring/48/gnome-keyring-48.0.tar.xz",
  sha256sum = "f20518c920e9ea3f9c9b8b44be8c50d8d7feecd0dd5624960f77bd2ca4fbeb9d"
}
in
{
  lib,
  drvs,
  distro,
  gnomeKeyring | lib.MesonPackage = {
    singleSource = src,

    extraMesonArgs = [
      "-Dsystemd=disabled",
      "-Dpam=%{std.to_string distro.pam}",
      "-Ddebug-mode=false",
      "-Dmanpage=false",
    ],

    preConfigurePhase = [
      m%"
      for f in $(find ${SRC} -type f); do
        sed -i 's@http://docbook.sourceforge.net/release/xsl/current@/usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2@g' ${f}
      done
      "%,
      "sed -i 's|shared_library|library|g' ${SRC}/pam/meson.build",
    ],

    # https://github.com/alpinelinux/aports/blob/a63e52c3637744fd4c066463c98b821946360721/community/gnome-keyring/libgkm-source-gkm-marshal.patch#L7
    patches = [
      {
        file = "0001-gnome-keyring.patch",
        sha256sum = "f6f6ebbcac6f3349c366e3cd5ff83f61210c82ad0b944eadd15fd6f03e377146"
      },
      {
        sha256sum = "f1931d05410c2fdbb23bec07113b429711b8fa1442f271b328d2629193924520",
        file = "0002-pam.patch"
      }
    ],

    biDrvs =
      [
        drvs.gpgme,
        drvs.libassuan,
        drvs.libgpgError,
        drvs.libgcrypt,
        drvs.openssl,
        drvs.glib,
        drvs.libxslt,
        drvs.gnupg2,
        drvs.fontconfig,
        drvs.freetype,
        drvs.zlibNg,
        drvs.gperf,
        drvs.pixman,
        drvs.wayland,
        drvs.waylandProtocols,
        drvs.libffi,
        drvs.libxkbcommon,
        drvs.expat,
        drvs.linuxHeaders,
        drvs.ncurses,
        drvs.readline,
        drvs.pcre2,
        drvs.pango,
        drvs.cairo,
        drvs.libpng,
        drvs.hwdata,
        drvs.gobjectDynamic,
        drvs.cairoGobject,
        drvs.fribidi,
        drvs.gdkPixbufFull,
        drvs.libjpegTurbo,
        drvs.libepoxy,
        drvs.atSpi2Core,
        drvs.mesa2,
        drvs.libelf,
        drvs.libdrm,
        drvs.libpciaccess,
        drvs.llvmConfigStatic,
        drvs.spirvTools,
        drvs.spirvLlvmTranslator,
        drvs.libtiff,
        drvs.graphene,
        drvs.harfbuzzFull,
        drvs.gtk4,
        drvs.p11Kit,
        drvs.libsecret,
        drvs.gcr,
        drvs.gettext,
        drvs.docbookXslNons,
      ]
      @ (
        if distro.pam then
          [
            drvs.libpam,
          ]
        else
          []
      ),
  }
}
& {
  lib,
  drvs,
  gcr4 | lib.MesonPackage = {
    singleSource = {
      uri = "https://gitlab.gnome.org/GNOME/gcr/-/archive/4.4.0.1/gcr-4.4.0.1.tar.gz",
      sha256sum = "be1fd6ec369ed4eb42e309ef7933a6fb925b08296e0a04a21bb979954d5586e3"
    },
    preConfigurePhase = [
      m%"sed -i "s@shared_library@library@g" ${SRC}/gck/meson.build"%,
      m%"sed -i "s@shared_library@library@g" ${SRC}/gcr/meson.build"%,
    ],
    llvmProvider = drvs.llvmFull,
    biDrvs = [
      drvs.gpgme,
      drvs.libassuan,
      drvs.libgpgError,
      drvs.libgcrypt,
      drvs.openssl,
      drvs.glib,
      drvs.libxslt,
      drvs.gnupg2,
      drvs.fontconfig,
      drvs.freetype,
      drvs.zlibNg,
      drvs.gperf,
      drvs.pixman,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.libffi,
      drvs.libxkbcommon,
      drvs.expat,
      drvs.linuxHeaders,
      drvs.ncurses,
      drvs.readline,
      drvs.pcre2,
      drvs.pango,
      drvs.cairo,
      drvs.libpng,
      drvs.hwdata,
      drvs.gobjectDynamic,
      drvs.cairoGobject,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.libjpegTurbo,
      drvs.libepoxy,
      drvs.atSpi2Core,
      drvs.mesa2,
      drvs.libelf,
      drvs.libdrm,
      drvs.libpciaccess,
      drvs.llvmConfigStatic,
      drvs.spirvTools,
      drvs.spirvLlvmTranslator,
      drvs.libtiff,
      drvs.graphene,
      drvs.harfbuzzFull,
      drvs.gtk4,
      drvs.p11Kit,
      drvs.libsecret,

      # drvs.openssh,
    ],

    extraMesonArgs = [
      "-Dintrospection=false",
      "-Dvapi=false",
      "-Dgtk_doc=false",
      "-Dssh_agent=false",
    ]
  }
}
