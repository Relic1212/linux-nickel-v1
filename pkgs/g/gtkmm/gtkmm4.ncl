{
  lib,
  fontconfig,
  freetype,
  zlibNg,
  gperf,
  pixman,
  wayland,
  waylandProtocols,
  libffi,
  libxkbcommon,
  expat,
  linuxHeaders,
  ncurses,
  readline,
  pcre2,
  pango_1_56,
  cairo,
  libpng,
  harfbuzzFull,
  glibDynamic,
  muslShared,
  hwdata,
  gobjectDynamic,
  cairoGobject,
  fribidi,
  gdkPixbufFull,
  libjpegTurbo,
  libepoxy,
  atSpi2Core,
  mesa2,
  libelf,
  libdrm,
  libpciaccess,
  llvmConfigStatic,
  spirvTools,
  spirvLlvmTranslator,
  gtk4,
  libsigcpp,
  cairomm_1_16,
  pangomm_2_48,
  glibmm_2_82,
  libtiff,
  graphene,
  libxslt,
  m4,
  gettext,
  graphviz,
  llvmFull,
  pythonDynamic,
  pythonSetuptools,

  gtkmm4 | lib.MesonPackage = {
    singleSource = {
      #uri = "https://gitlab.gnome.org/GNOME/gtkmm/-/archive/4.16.0/gtkmm-4.16.0.tar.gz",
      #sha256sum = "a5e5fa6abab2b57a5c9e2b48741b117b54c3a87e60597aef57a075ae649e3704",
      uri = "https://download.gnome.org/sources/gtkmm/4.16/gtkmm-4.16.0.tar.xz",
      sha256sum = "3b23fd3abf8fb223b00e9983b6010af2db80e38c89ab6994b8b6230aa85d60f9",
    },

    llvmProvider = lib.singleBiMap llvmFull,
    pythonProvider = lib.singleBiMap pythonDynamic,

    biDrvs =
      lib.biMap [
        fontconfig,
        freetype,
        zlibNg,
        gperf,
        pixman,
        wayland,
        waylandProtocols,
        libffi,
        libxkbcommon,
        expat,
        linuxHeaders,
        ncurses,
        readline,
        pcre2,
        pango_1_56,
        cairo,
        libpng,
        harfbuzzFull,
        glibDynamic,
        muslShared,
        hwdata,
        gobjectDynamic,
        cairoGobject,
        fribidi,
        gdkPixbufFull,
        libjpegTurbo,
        libepoxy,
        atSpi2Core,
        mesa2,
        libelf,
        libdrm,
        libpciaccess,
        llvmConfigStatic,
        spirvTools,
        spirvLlvmTranslator,
        gtk4,
        #libsigcpp2,
        libsigcpp,
        cairomm_1_16,
        pangomm_2_48,
        glibmm_2_82,
        (pythonSetuptools & { priority = 1 }),
        libtiff,
        graphene,
        libxslt,
        m4,
        gettext,
        graphviz,
      ],
    extraMesonArgs = [
      "-Dbuild-demos=false",
      "-Dbuild-tests=false",
      "-Dmsvc14x-parallel-installable=false",
    ],
    preConfigurePhase = [
      #"mkdir ${SRC}/untracked/build_scripts",
      #"touch ${SRC}/untracked/generate-binding.py"

      #"sed -i 's@not import@import@g' ${SRC}/meson.build"
    ]
  }
}
