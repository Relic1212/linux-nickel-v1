{
  lib,
  fontconfig,
  freetype,
  zlibNg,
  gperf,
  pixman,
  wayland,
  waylandProtocols,
  libffi,
  libxkbcommon,
  expat,
  linuxHeaders,
  ncurses,
  readline,
  pcre2,
  pango,
  cairo,
  libpng,
  harfbuzz,
  glibDynamic,
  muslShared,
  hwdata,
  gobjectDynamic,
  cairoGobject,
  fribidi,
  gdkPixbufFull,
  libjpegTurbo,
  libepoxy,
  atSpi2Core,
  mesa2,
  libelf,
  libdrm,
  libpciaccess,
  llvmConfigStatic,
  spirvTools,
  spirvLlvmTranslator,
  gtk3,
  libsigcpp2,
  cairomm_1_0,
  pangomm,
  glibmm,
  llvmFull,
  pythonDynamic,
  pythonSetuptools,

  gtkmm3 | lib.MesonPackage = {
    singleSource = {
      uri = "https://download.gnome.org/sources/gtkmm/3.24/gtkmm-3.24.9.tar.xz",
      sha256sum = "30d5bfe404571ce566a8e938c8bac17576420eb508f1e257837da63f14ad44ce"
    },

    llvmProvider = lib.singleBiMap llvmFull,
    pythonProvider = lib.singleBiMap pythonDynamic,

    biDrvs =
      lib.biMap [
        fontconfig,
        freetype,
        zlibNg,
        gperf,
        pixman,
        wayland,
        waylandProtocols,
        libffi,
        libxkbcommon,
        expat,
        linuxHeaders,
        ncurses,
        readline,
        pcre2,
        pango,
        cairo,
        libpng,
        harfbuzz,
        glibDynamic,
        muslShared,
        hwdata,
        gobjectDynamic,
        cairoGobject,
        fribidi,
        gdkPixbufFull,
        libjpegTurbo,
        libepoxy,
        atSpi2Core,
        mesa2,
        libelf,
        libdrm,
        libpciaccess,
        llvmConfigStatic,
        spirvTools,
        spirvLlvmTranslator,
        gtk3,
        libsigcpp2,
        cairomm_1_0,
        pangomm,
        glibmm,
        (pythonSetuptools & { priority = 1 }),
      ],
    extraMesonArgs = [
      "-Dbuild-demos=false",
      "-Dbuild-tests=false",
      "-Dbuild-atkmm-api=false",
    ]
  }
}
