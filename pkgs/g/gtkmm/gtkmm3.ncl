{
  lib,
  drvs,
  gtkmm3 | lib.MesonPackage = {
    singleSource = {
      uri = "https://download.gnome.org/sources/gtkmm/3.24/gtkmm-3.24.9.tar.xz",
      sha256sum = "30d5bfe404571ce566a8e938c8bac17576420eb508f1e257837da63f14ad44ce"
    },

    llvmProvider = drvs.llvmFull,
    pythonProvider = drvs.pythonDynamic,

    biDrvs = [
      drvs.fontconfig,
      drvs.freetype,
      drvs.zlibNg,
      drvs.gperf,
      drvs.pixman,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.libffi,
      drvs.libxkbcommon,
      drvs.expat,
      drvs.linuxHeaders,
      drvs.ncurses,
      drvs.readline,
      drvs.pcre2,
      drvs.pango,
      drvs.cairo,
      drvs.libpng,
      drvs.harfbuzz,
      drvs.glibDynamic,
      drvs.muslShared,
      drvs.hwdata,
      drvs.gobjectDynamic,
      drvs.cairoGobject,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.libjpegTurbo,
      drvs.libepoxy,
      drvs.atSpi2Core,
      drvs.mesa2,
      drvs.libelf,
      drvs.libdrm,
      drvs.libpciaccess,
      drvs.llvmConfigStatic,
      drvs.spirvTools,
      drvs.spirvLlvmTranslator,
      drvs."gtk+3",
      drvs."libsigc++2",
      drvs."cairomm-1.0",
      drvs."pangomm",
      drvs.glibmm,
      (drvs.pythonSetuptools & { priority = 1 }),
    ],
    extraMesonArgs = [
      "-Dbuild-demos=false",
      "-Dbuild-tests=false",
      "-Dbuild-atkmm-api=false",
    ]
  }
}
