{
  lib,
  drvs,
  gnomeAutoar | lib.MesonPackage = {
    singleSource = {
      uri = "https://gitlab.gnome.org/GNOME/gnome-autoar/-/archive/0.4.5/gnome-autoar-0.4.5.tar.bz2?ref_type=tags",
      sha256sum = "d0fc83b5a09ed00ae192f90367485509b3d3d2002e8400de05680bd4e1543a67",
    },
    extraMesonArgs = [
      "-Dgtk=false",
      "-Dintrospection=disabled",
      "-Dvapi=false",
    ],
    preConfigurePhase = [
      m%"sed -i 's|shared_library|library|g' ${SRC}/gnome-autoar/meson.build"%,
    ],

    llvmProvider = drvs.llvmFull,

    biDrvs = [
      # drvs.gtk3,
      drvs.lz4,
      drvs.zstd,
      drvs.libarchive,
      drvs.pcre2,
      drvs.libffi,
      drvs.zlibNg,
      drvs.glib,

      #   drvs.atSpi2Core,
      #   drvs.cairo,
      #   drvs.cairoGobject,
      #   drvs.expat,
      #   drvs.fontconfig,
      #   drvs.freetype,
      #   drvs.fribidi,
      #   drvs.gdkPixbufFull,
      #   drvs.glibDynamic,
      #   drvs.gobjectDynamic,
      #   drvs.gperf,
      #   drvs.graphene,
      #   drvs.gtk4,
      #   drvs.harfbuzzFull,
      #   drvs.hwdata,
      #   drvs.libdrm,
      #   drvs.libelf,
      #   #   drvs.libepoxy,
      #   drvs.libffi,
      #   drvs.libjpegTurbo,
      #   drvs.libpciaccess,
      #   drvs.libpng,
      #   drvs.libtiff,
      #   drvs.libxkbcommon,
      #   drvs.libxml2,
      #   drvs.linuxHeaders,
      #   drvs.llvmConfigStatic,
      #   drvs.mesa2,
      #   #   drvs.muslShared,
      #   drvs.ncurses,
      #   drvs.pango,
      #   drvs.pcre2,
      #   drvs.pixman,
      #   drvs.readline,
      #   drvs.sharedMimeInfo,
      #   drvs.spirvLlvmTranslator,
      #   drvs.spirvTools,
      #   drvs.wayland,
      #   drvs.waylandProtocols,
      #   drvs.zlibNg,
    ]
  }
}
