      drvs.libelf,
      drvs.libepoxyX11,
      drvs.libffi,
      drvs.libfontenc,
      drvs.libjpegTurbo,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libx11,
      drvs.libxau,
      drvs.libxcb,
      drvs.libxcursor,
      drvs.libxcvt,
      drvs.libxfixes,
      drvs.libxfont2,
      drvs.libxkbcommon,
      drvs.libxkbfile,
      drvs.libxrender,
      drvs.libxshmfence,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.mesa2,
      drvs.muslShared,
      drvs.ncurses,
      drvs.openssl,
      drvs.pango,
      drvs.pcre2,
      drvs.pixman,
      drvs.readline,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.xcbProto,
      drvs.xcbRenderutil,
      drvs.xcbUtilWm,
      drvs.xorgMacros,
      drvs.xorgproto,
      drvs.xtrans,
      # drvs.xwayland,
      drvs.zlibNg,
      drvs.isoCodes,
      drvs.libxext,
      drvs.libxf86vm,
      drvs.libxrandr,
      drvs.libxi,
      drvs.dbus,
    ],

    extraMesonArgs = [
      "-Dgtk_doc=false",
      "-Dtests=false",
      "-Ddemos=false",
      "-Dexamples=false",
      "-Dintrospection=false",
      "-Dcloudproviders=false",
      "-Dcolord=yes",
      # "-Dopengl=false",
      "-Dtracker3=false",
      "-Dwayland_backend=true",
      "-Dx11_backend=true",
      "-Dbuiltin_immodules=all",
      "-Dbroadway_backend=false",
      "-Dwin32_backend=false",
      "-Dquartz_backend=false",
