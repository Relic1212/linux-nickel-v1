{
  lib,
  drvs,
  cwcwm | lib.MesonPackage = {
    singleSource = {
      uri = "https://github.com/Cudiph/cwcwm/archive/refs/tags/v0.3.0.tar.gz",
      sha256sum = "c7f78ec67bc2219e5125c9b39c87b28ae080839020bd91b68801efa6427ab275",
    },

    buildEnv = {
      EXTRA_LDFLAGS = [
        "-lc++",
        "$(pkg-config --libs --static hyprlang hyprutils libzip tomlplusplus)",
      ],
    },

    preConfigurePhase = [
      "sed -i 's|shared_module|library|g' ${SRC}/plugins/meson.build",
      # m%"sed -i 's@path = @print("p =", p)\n    path = @g' ${SRC}/cwctl/gen.py"%,
      m%"sed -i 's@, p)@, p).removeprefix("_src")@g' ${SRC}/cwctl/gen.py"%,
      # m%"sed -i 's|#include <wlr/xwayland.h>||g' ${SRC}/src/input/cursor.c"%,
    ],

    llvmProvider = drvs.llvmFull,
    biDrvs = [
      drvs.expat,
      drvs.jsonC,
      drvs.pcre2,
      drvs.mesa2,
      drvs.spirvTools,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.libelf,
      drvs.libpciaccess,
      drvs.libdrm,
      drvs.libxkbcommon,
      drvs.pixman,
      drvs.eudev,
      drvs.libdisplayinfo,
      drvs.libinput,
      drvs.libffi,
      drvs.libevdev,
      drvs.mtdev,
      drvs.pango,
      drvs.cairo,
      drvs.libpng,
      drvs.freetype,
      drvs.fontconfig,
      drvs.zlibNg,
      drvs.harfbuzz,
      drvs.glib,
      drvs.hwdata,
      drvs.linuxHeaders,
      drvs.gdkPixbufFull,
      drvs.libjpegTurbo,
      drvs.basu,
      drvs.lcms,
      drvs.scdoc,
      ##
      drvs.libxcursor,
      drvs.xorgMacros,
      drvs.xorgproto,
      drvs.xtrans,
      drvs.libxcb,
      drvs.xcbProto,
      drvs.libxau,
      drvs.libx11,
      drvs.libxrender,
      drvs.libxfixes,
      drvs.xcbRenderutil,
      drvs.libxfont2,
      drvs.libfontenc,
      drvs.libxcvt,
      drvs.libxshmfence,
      drvs.xwayland,
      drvs.libxkbfile,
      ##
      drvs.openssl,
      drvs.xcbUtilWm,
      drvs.wlroots19xwayland,
      drvs.xxhash,
      drvs.luajit,
      drvs.git,
      drvs.hyprlang,
      drvs.hyprutils,
      drvs.tomlplusplus,
      drvs.libzip,
      drvs.hyprcursor,
    ],

    propagatedBuildInputs = [
      drvs.seatd,
    ]
  }
}
