{
  lib,
  drvs,
  cursorClip | lib.CargoPackage = {
    singleSource = {
      uri = "https://github.com/Sirulex/cursor-clip/archive/d0783431cb6b9d60ce51bd78a971abc6072d4794.tar.gz",
      sha256sum = "97f485a5a53cb6918c2ccb1111a0259f0fce72332b4671f8afab648b32d72381",
    },
    extraEnv = {
      # PKGCONFIG = "\"pkg-config --static\"",

      EXTRA_RUSTFLAGS = [
        "-C link-arg=/tmp/workdir/src/dlopen.o",
        # "-C link-arg=-no-pie",
        # "-C relocation-model=static",

        # "-C link-arg=-l:libdl_ashell",
        # "-C link-arg=$(clang --print-file-name=libclang_rt.builtins-x86_64.a)",
        "-C link-arg=-lc++",
        m%"$(for l in $(pkg-config --libs --static xkbcommon libpulse egl wayland-client wayland-egl);do printf " -C link-arg=$l ";done)"%,
      ],
    },

    extraCargoFlags = [
      # "--verbose",
    ],
    configurePhase = [
      "echo '%{import "../../i/ironbar/ironbar_dlopen.c" as 'Text}' > ${SRC}/dlopen.c",
      "echo '%{import "constructor.c" as 'Text}' >> ${SRC}/dlopen.c",
      "${CC} ${CFLAGS} -c ${SRC}/dlopen.c -o ${SRC}/dlopen.o",
      "cargo tree --target=x86_64-unknown-linux-musl -e features",
    ],
    # debug = true,
    crates = lib.functions.filterCrates (import "cursor-clip-crates.json"),
    muslProvider = drvs.muslBothRenamedDl,
    llvmProvider = drvs.llvmFull,
    biDrvs = [
      drvs.atSpi2Core,
      drvs.cairo,
      drvs.cairoGobject,
      drvs.cairomm_1_16,
      drvs.dbus,
      drvs.expat,
      drvs.eudev,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.glibPatched,
      # drvs.glibNoExportDynamic,
      drvs.glibmm_2_82,
      drvs.gobjectDynamic,
      drvs.gperf,
      drvs.graphene,
      drvs.gtk4,
      drvs.gtk4LayerShell,
      drvs.gtkmm4,
      drvs.harfbuzzFull,
      drvs.hwdata,
      drvs.libdrm,
      drvs.libelf,
      drvs.libepoxy,
      drvs.libevdev,
      drvs.libffi,
      drvs.libjpegTurboStatic,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libsigcpp,
      drvs.libtiff,
      drvs.libxkbcommon,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.mesaExp,
      drvs.ncurses,
      drvs.pango,
      drvs.pangomm_2_48,
      drvs.pcre2,
      drvs.pixman,
      drvs.readline,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.waylandGtk4LayerShell,
      drvs.waylandProtocols,
      drvs.zlibNg,
      #
      drvs.kmod,
      drvs.xz,
      drvs.openssl,
      drvs.zstd,
      drvs.utilLinux,
      #
      drvs.luajitStatic,
      #
      drvs.libinput,
      drvs.mtdev,
      #
      drvs.alsaLibs,
      drvs.bluez,
      drvs.sbc,
      drvs.ffmpeg,
      drvs.speex,
      drvs.speexdsp,
      drvs.check,
      drvs.pulseaudio17,
      #
      drvs.appstream,
      drvs.curl,
      drvs.feedbackd,
      # drvs.gettext,
      # drvs.glibDynamic,
      drvs.gmobile,
      drvs.gnomeDesktop,
      drvs.gsettingsDesktopSchemas,
      drvs.gsound,
      drvs.gudev,
      drvs.isoCodes,
      drvs.jsonGlib,
      drvs.libbsd,
      drvs.libcanberra,
      drvs.libgtop,
      drvs.libmd,
      drvs.libogg,
      drvs.libportal,
      drvs.libpsl,
      drvs.libseccomp,
      drvs.libtool,
      drvs.libvorbis,
      drvs.libxml2,
      drvs.libxmlb,
      drvs.libyaml,
      # drvs.mesa2,
      # drvs.muslShared,
      # drvs.sassc,
      # drvs.wayland,
      drvs.xkeyboardConfig,
      drvs.libadwaitaFixedSyms,
    ],
  }
}
