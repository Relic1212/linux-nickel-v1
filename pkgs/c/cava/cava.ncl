{
  lib,
  drvs,
  cava | lib.AutomakePackage = {
    # generator = "Ninja",
    singleSource = {
      uri = "https://github.com/karlstav/cava/archive/refs/tags/0.10.4.tar.gz",
      sha256sum = "5a2efedf2d809d70770f49349f28a5c056f1ba9b3f5476e78744291a468e206a"
    },
    buildEnv.EXTRA_LDFLAGS = ["-lc++"],

    llvmProvider = drvs.llvmFull,

    biDrvs = [
      drvs.dbus,
      drvs.alsaLibs,
      drvs.fontconfig,
      drvs.freetype,
      drvs.zlibNg,
      drvs.gperf,
      drvs.pixman,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.libffi,
      drvs.libxkbcommon,
      drvs.expat,
      drvs.linuxHeaders,
      drvs.ncurses,
      drvs.readline,
      drvs.pcre2,
      drvs.pango,
      drvs.cairo,
      drvs.libpng,
      drvs.harfbuzz,
      drvs.glib,
      drvs.muslShared,
      drvs.hwdata,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.libjpegTurbo,
      drvs.libepoxy,
      drvs.mesa2,
      drvs.libelf,
      drvs.libdrm,
      drvs.libpciaccess,
      drvs.llvmConfigStatic,
      drvs.spirvTools,
      drvs.spirvLlvmTranslator,
      drvs.eudev,
      drvs.kmod,
      drvs.xz,
      drvs.openssl,
      drvs.zstd,
      drvs.utilLinux,
      drvs.libevdev,
      drvs.libsndfile,
      drvs.libopus,
      drvs.lua,
      drvs.bluez,
      drvs.sbc,
      drvs.libusb,
      drvs.ffmpeg,
      drvs.jansson,
      drvs.libfreeaptx,
      drvs.fdkAac,
      drvs.ldacbt,
      drvs.libyaml,
      drvs.pipewire,
      drvs.fftw,
      drvs.iniparser,
    ]
  }
}
