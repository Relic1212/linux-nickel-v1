  freetype,
  fontconfig,
  zlibNg,
  harfbuzz,
  glib,
  hwdata,
  linuxHeaders,
  wlroots18,
  llvmFull,

  cage | lib.MesonPackage = {

    sourceInputs = [
      {
        src = {
          uri = "https://github.com/cage-kiosk/cage/archive/refs/tags/v0.2.0.tar.gz",
          sha256sum = "9d3f659e0f19636a958f9e1bf4d22268d7e2705d7e2989888401ec443c1cb6c3",
        }
      },
    ],

    llvmProvider = lib.singleBiMap llvmFull,
    biDrvs =
      lib.biMap [
        expat,
        jsonC,
        pcre2,
        mesa2,
        wayland,
        waylandProtocols,
        libelf,
        libpciaccess,
        libdrm,
        libxkbcommon,
        pixman,
        # eudev,
        libudevZero,
        seatd,
        libdisplayinfo,
        libinput,
        libffi,
        libevdev,
        mtdev,
        pango,
        cairo,
        libpng,
        freetype,
        fontconfig,
        zlibNg,
        harfbuzz,
        glib,
        hwdata,
        linuxHeaders,
        wlroots18,
      ],

    buildEnv = {
      EXTRA_LDFLAGS = [
        "-lc++"
      ],
    },
  }
}
