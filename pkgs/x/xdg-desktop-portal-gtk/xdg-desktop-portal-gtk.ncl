{
  lib,
  drvs,
  xdgDesktopPortalGtk | lib.MesonPackage = {
    options = {
      elogind | default = true
    },

    singleSource = {
      uri = "https://github.com/flatpak/xdg-desktop-portal-gtk/releases/download/1.15.3/xdg-desktop-portal-gtk-1.15.3.tar.xz",
      sha256sum = "47a3743d2419a8601e691db37e85bb5fac5ae4b26842177065cd5f22ada23b37"
    },

    extraMesonArgs = [
      "-Dsettings=enabled",
      "-Dappchooser=enabled",
      "-Dlockdown=disabled",
    ],

    # libcamera needs this
    buildEnv = {
      EXTRA_LDFLAGS = [
        "-lc++",
        "-ldl_factory",
      ],
    },
    llvmProvider = drvs.llvmFull,
    muslProvider = drvs.muslBothRenamedDl,
    biDrvs =
      [
        drvs.libdlFactory,
        drvs.alsaLibs,
        drvs.appstream,
        drvs.atSpi2Core,
        drvs.bison,
        drvs.bluez,
        drvs.bubblewrap,
        drvs.cairo,
        drvs.cairoGobject,
        drvs.curl,
        drvs.dbus,
        drvs.docutils,
        drvs.eudev,
        drvs.expat,
        drvs.fdkAac,
        drvs.ffmpeg,
        drvs.fontconfig,
        drvs.freetype,
        drvs.fribidi,
        drvs.fuse,
        drvs.gdkPixbufFull,
        drvs.glibPatched,
        drvs.gobjectDynamic,
        drvs.gperf,
        drvs.gpgme,
        drvs.gsettingsDesktopSchemas,
        drvs.gtk3,
        drvs.gudev,
        drvs.harfbuzz,
        drvs.hwdata,
        drvs.isoCodes,
        drvs.jansson,
        drvs.jsonGlib,
        drvs.kmod,
        drvs.ldacbt,
        drvs.libarchive,
        drvs.libassuan,
        drvs.libcap,
        drvs.libdrm,
        drvs.libelf,
        drvs.libepoxy,
        drvs.libevdev,
        drvs.libffi,
        drvs.libfreeaptx,
        drvs.libgpgError,
        drvs.libjpegTurbo,
        drvs.libopus,
        drvs.libpciaccess,
        drvs.libpng,
        drvs.libpsl,
        drvs.libseccomp,
        drvs.libsndfile,
        drvs.libusb,
        drvs.libxkbcommon,
        drvs.libxml2,
        drvs.libxmlb,
        drvs.libxslt,
        drvs.libyaml,
        drvs.linuxHeaders,
        drvs.llvmConfigStatic,
        drvs.lua,
        drvs.lz4,
        drvs.m4,
        drvs.mesa2,
        # drvs.muslShared,
        drvs.ncurses,
        drvs.openssl,
        drvs.ostree,
        drvs.pango,
        drvs.pcre2,
        drvs.pipewire,
        drvs.pixman,
        drvs.readline,
        drvs.sbc,
        drvs.spirvLlvmTranslator,
        drvs.spirvTools,
        drvs.utilLinux,
        drvs.wayland,
        drvs.waylandProtocols,
        drvs.xdgDbusProxy,
        drvs.xkeyboardConfig,
        drvs.xz,
        drvs.zlibNg,
        drvs.zstd,
        drvs.gnomeDesktop,
        drvs.xdgDesktopPortal,
        drvs.gettext,
        drvs.inih,
        drvs.flatpak,
      ]
      @ (
        if options.elogind then
          [
            drvs.elogindWithPolkit,
            drvs.polkit,
          ]
        else
          [
            drvs.basuUdevCompatible,
          ]
      ),
  }
}
