{
  lib,
  pixman,
  expat,
  libffi,
  libevdev,
  mtdev,
  pango,
  cairo,
  libpng,
  freetype,
  fontconfig,
  zlibNg,
  harfbuzz,
  glib,
  hwdata,
  linuxHeaders,
  hyprwaylandScanner,
  aquamarine,
  hyprUtils,
  hyprlang,
  hyprcursor,
  libjpegTurboStatic,
  libspng,
  file,
  libwebp,
  qtdeclarative,
  qtbase,
  qtshadertools,
  qtwayland,
  mesa2,
  pkgconf,
  libelf,
  libdrm,
  pythonMako,
  pythonPackaging,
  pythonMarkupsafe,
  libpciaccess,
  bison,
  flex,
  wayland,
  waylandProtocols,
  m4,
  pyyaml,
  llvmConfigStatic,
  spirvTools,
  spirvLlvmTranslator,
  jsonC,
  pcre2,
  libxkbcommon,
  openssl,
  kmod,
  zstd,
  xz,
  eudev,
  libinput,
  llvmFull,

  hyprlandQtSupport | lib.CmakePackage = {
    generator = "Ninja",

    singleSource = {
      uri = "https://github.com/hyprwm/hyprland-qt-support/archive/refs/tags/v0.1.0.tar.gz",
      sha256sum = "cac1f980bd088b890097f3f999cfdf03e73ee94c53f3c92d0b3bc23baa9e7b2c"
    },
    llvmProvider = lib.singleBiMap llvmFull,

    biDrvs =
      lib.biMap [
        pixman,
        expat,
        libffi,
        libevdev,
        mtdev,
        pango,
        cairo,
        libpng,
        freetype,
        fontconfig,
        zlibNg,
        harfbuzz,
        glib,
        hwdata,
        linuxHeaders,
        hyprwaylandScanner,
        aquamarine,
        hyprUtils,
        hyprlang,
        hyprcursor,
        libjpegTurboStatic,
        libspng,
        file,
        libwebp,
        qtdeclarative,
        qtbase,
        qtshadertools,
        qtwayland,
        mesa2,
        # pkgconf,
        libelf,
        libdrm,
        pythonMako,
        pythonPackaging,
        pythonMarkupsafe,
        libpciaccess,
        bison,
        flex,
        wayland,
        waylandProtocols,
        m4,
        pyyaml,
        llvmConfigStatic,
        spirvTools,
        spirvLlvmTranslator,
        ###
        jsonC,
        pcre2,
        libxkbcommon,
        openssl,
        kmod,
        zstd,
        xz,
        eudev,
        libinput,
      ],
    preConfigurePhase = [
      "sed -i 's@SHARED@STATIC@g' ${SRC}/src/style/CMakeLists.txt",
      "sed -i 's@SHARED@STATIC@g' ${SRC}/src/style/impl/CMakeLists.txt",
    ],
    buildEnv = {
      EXTRA_LDFLAGS = [
        "$(pkg-config --libs --static gbm glesv2 egl dri wayland-client)",
      ]
    },
    cmakeExtraArgsRecord = {
      "-DINSTALL_QML_PREFIX" = "/lib/qt6/qml",
      "-DCMAKE_MODULE_LINKER_FLAGS:STRING" = "\"-static --static -fuse-ld=lld -stdlib=libc++ -rtlib=compiler-rt -unwindlib=libunwind -lc++ -lglapi -ldrm $(pkg-config --libs --static dri glesv2 gbm egl wayland-client)\""
    },
  }
}
