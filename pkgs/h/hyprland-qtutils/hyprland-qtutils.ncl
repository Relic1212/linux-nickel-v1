{
  lib,
  pixman,
  expat,
  libffi,
  libevdev,
  mtdev,
  pango,
  cairo,
  libpng,
  freetype,
  fontconfig,
  zlibNg,
  harfbuzz,
  glib,
  hwdata,
  linuxHeaders,
  hyprwaylandScanner,
  aquamarine,
  hyprUtils,
  hyprlang,
  hyprcursor,
  libjpegTurboStatic,
  libspng,
  file,
  libwebp,
  dbusForQt,
  qtdeclarative,
  qtbase,
  qtshadertools,
  qtwayland,
  mesa2,
  pkgconf,
  libelf,
  libdrm,
  pythonMako,
  pythonPackaging,
  pythonMarkupsafe,
  libpciaccess,
  bison,
  flex,
  wayland,
  waylandProtocols,
  m4,
  pyyaml,
  llvmConfigStatic,
  spirvTools,
  spirvLlvmTranslator,
  jsonC,
  pcre2,
  libxkbcommon,
  openssl,
  kmod,
  zstd,
  xz,
  eudev,
  libinput,
  llvmFull,

  hyprlandQtutils | lib.CmakePackage = {
    generator = "Ninja",
    singleSource = {
      uri = "https://github.com/hyprwm/hyprland-qtutils/archive/refs/tags/v0.1.3.tar.gz",
      sha256sum = "3e57617ebd849ebf074c492bf828efa37a5b47fd6d43b392462874069170c5ed"
    },
    llvmProvider = lib.singleBiMap llvmFull,

    biDrvs =
      lib.biMap [
        pixman,
        expat,
        libffi,
        libevdev,
        mtdev,
        pango,
        cairo,
        libpng,
        freetype,
        fontconfig,
        zlibNg,
        harfbuzz,
        glib,
        hwdata,
        linuxHeaders,
        hyprwaylandScanner,
        aquamarine,
        hyprUtils,
        hyprlang,
        hyprcursor,
        libjpegTurboStatic,
        libspng,
        file,
        libwebp,
        dbusForQt,
        qtdeclarative,
        qtbase,
        qtshadertools,
        qtwayland,
        mesa2,
        # pkgconf,
        libelf,
        libdrm,
        pythonMako,
        pythonPackaging,
        pythonMarkupsafe,
        libpciaccess,
        bison,
        flex,
        wayland,
        waylandProtocols,
        m4,
        pyyaml,
        llvmConfigStatic,
        spirvTools,
        spirvLlvmTranslator,
        ###
        jsonC,
        pcre2,
        libxkbcommon,
        openssl,
        kmod,
        zstd,
        xz,
        eudev,
        libinput,
      ],
    buildEnv = {
      EXTRA_LDFLAGS = [
        "$(pkg-config --libs --static gbm glesv2 egl dri wayland-client)",
      ]
    },
    cmakeExtraArgsRecord = {
      "-DQT_DEBUG_FIND_PACKAGE" = "ON",
      "-DCMAKE_MODULE_LINKER_FLAGS:STRING" = "\"-static --static -fuse-ld=lld -stdlib=libc++ -rtlib=compiler-rt -unwindlib=libunwind -lc++ -lglapi -ldrm $(pkg-config --libs --static dri glesv2 gbm egl wayland-client)\""
    },

    patches = [
      {
        sha256sum = "fa1305ef55b815c9f130f90cf55553baa9a39670fbc7e08a1a3f602d2fc594da",
        file = "hyprland-qtutils.patch",
      }
    ],
    cmakeExtraArgsRecord = {
      "-DCMAKE_BUILD_TYPE" | priority 1 = "Release",
    },
  }
}
& (import "./hyprland-qt-support.ncl")
