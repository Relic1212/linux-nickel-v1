{
  lib,
  drvs,
  imv | lib.MesonPackage = {
    singleSource = {
      uri = "https://git.sr.ht/~exec64/imv/archive/v5.0.1.tar.gz",
      sha256sum = "8949c1df4b933b1d324e02ce49f1834a4b73dd25fa8103579e0ed105149e080e",
    },
    buildEnv = {
      EXTRA_LDFLAGS = [
        "-lc++",
      ],
    },
    extraMesonArgs = [
      "-Dwindows='wayland'",
    ],

    llvmProvider = drvs.llvmFull,
    biDrvs = [
      drvs.cairo,
      drvs.expat,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.glib,
      drvs.harfbuzz,
      drvs.libdrm,
      drvs.libelf,
      drvs.libffi,
      drvs.libicu,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libxkbcommon,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.mesaGlx,
      drvs.pango,
      drvs.pcre2,
      drvs.pixman,
      drvs.spirvHeaders,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.zlibNg,
      drvs.inih,
      drvs.libxcursor,
      drvs.xorgMacros,
      drvs.xorgproto,
      drvs.xtrans,
      drvs.libxcb,
      drvs.xcbProto,
      drvs.libxau,
      drvs.libx11,
      drvs.libxrender,
      drvs.libxfixes,
      drvs.xcbRenderutil,
      drvs.libxfont2,
      drvs.libfontenc,
      drvs.libxcvt,
      drvs.libxshmfence,
      drvs.libxkbfile,
      drvs.openssl,
      drvs.xcbUtilWm,
      drvs.xcbUtilErrors,
      drvs.libxext,
      drvs.libxf86vm,
      drvs.libxrandr,
    ]
  }
}
