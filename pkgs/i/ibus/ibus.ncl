{
  lib,
  drvs,
  ibus | lib.AutotoolsPackage = {
    singleSource = {
      # uri = "https://github.com/ibus/ibus/archive/refs/tags/1.5.33.tar.gz",
      # sha256sum = "a777068caba4ba7599a3214e2966f564daec01bba94cd7f2ca63062107e0604f",
      # uri = "https://github.com/ibus/ibus/archive/refs/tags/1.5.32.tar.gz",
      # sha256sum = "fa367d991d88f88a538a55626fb1456b8db7c483dc6dee11f04858c161191c8b",

      uri = "https://github.com/ibus/ibus/releases/download/1.5.33/ibus-1.5.33-rc2.tar.gz",
      sha256sum = "bd157ecbf07b1f213832a8fda0cb4a8aaae795c6ba6fe360ef0ff62a91285842",
    },
    extraEnv = {
      CC_FOR_BUILD = ["clang", "-static"],
      LDFLAGS_FOR_BUILD = ["-static"],
    },
    buildEnv = {
      EXTRA_LDFLAGS = [
        "-ldl_factory",
      ],
    },
    extraConfigureFlags = [
      "--disable-gtk2",
      "--disable-gtk-doc",
      "--disable-gtk3",
      "--disable-xim",
      "--disable-systemd-services",
      "--disable-python2",
      "--disable-emoji-dict",
      "--disable-unicode-dict",
      "--enable-wayland",
      "--disable-nls",
      "--disable-vala",
      "--disable-glibtest",
      "--disable-introspection",
      "--disable-schemas-compile",
      "--disable-tests",
      "--disable-install-tests",
    ],
    # separateBuildDir = false,
    configureFlags,
    # configurePhase = [
    #   # "touch ChangeLog"
    #         "./autogen.sh" ++ " " ++ (std.string.join lib.constants.buildFlagSep configureFlags),

    # ],
    llvmProvider = drvs.llvmFull,
    muslProvider = drvs.muslBothRenamedDl,
    biDrvs = [
      drvs.libdlFactory,
      drvs.perl,
      drvs.m4,
      drvs.libtool,
      drvs.pkgconfMeson,
      drvs.basefiles,
      drvs.muslShared,
      drvs.fontconfig,
      drvs.atSpi2Core,
      #   drvs.cairo,
      drvs.cairoGobject,
      drvs.expat,
      drvs.flex,
      drvs.freetype,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.gettext,
      drvs.glibPatched,
      drvs.gobjectDynamic,
      drvs.gperf,
      drvs.graphene,
      drvs.gtk4,
      drvs.gtk3,
      drvs.gtkDoc,
      drvs.harfbuzzFull,
      drvs.hwdata,
      drvs.isoCodes,
      drvs.libdrm,
      drvs.libelf,
      drvs.libepoxy,
      drvs.libffi,
      drvs.libjpegTurbo,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libtiff,
      drvs.libxkbcommon,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.mesa2,
      drvs.ncurses,
      drvs.pango,
      drvs.pcre2,
      drvs.pixman,
      drvs.pythonDynamic,
      drvs.readline,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.zlibNg,
      drvs.dbusmenuGtk,
      drvs.gudev,
      # drvs.vala,
      drvs.libpsl,
      drvs.libxml2,
      drvs.jsonGlib,
      drvs.libyaml,
      drvs.libxmlb,
      drvs.libvorbis,
      drvs.libogg,
      drvs.libcanberra,
      drvs.gsound,
      drvs.dbus,
      drvs.dconf,
      drvs.libnotify,

      ## X
      drvs.libxcursor,
      drvs.xorgMacros,
      drvs.xorgproto,
      drvs.xtrans,
      drvs.libxcb,
      drvs.xcbProto,
      drvs.libxau,
      drvs.libx11,
      drvs.libxrender,
      drvs.libxfixes,
      drvs.xcbRenderutil,
      drvs.libxfont2,
      drvs.libfontenc,
      drvs.libxcvt,
      drvs.libxshmfence,
      drvs.libxkbfile,
      ## -X

      ## py
