{
  lib,
  drvs,
  distro,
  networkmanager | lib.MesonPackage = {
    singleSource = {
      uri = "https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/archive/1.54.1/NetworkManager-1.54.1.tar.bz2",
      sha256sum = "da7a7f8197580a34c5e346338b0fe1f951f369568e0e0b361f23cb281d301e75"
    },

    sourceInputs = [
      {
        src = singleSource,
      },
      {
        src = {
          uri = "/run/data/user/Projects/test-static-linking/extern-sym/lib.c",
          sha256sum = "802d8bf8504c0b6ba72170da7afea8fd056ed2eec4a05918cf111ce554971653",
        },
        dest = "lib"
      }
    ],
    patches = [
      {
        sha256sum = "fcdc1d6f5d81d7c3510dba4af47149b8ec3a3078a076840085091da541b93857",
        file = "networkmanager-all.patch"
      },
    ],

    debug = true,

    extraMesonArgs = [
      "-Dtests=no",
      "-Dsession_tracking=elogind",
      "-Dsession_tracking_consolekit=false",
      "-Dpolkit=false",
      "-Dintrospection=false",
      "-Dsystemd_journal=false",
      "-Dsystemdsystemunitdir=no",
      "-Dselinux=false",
      "-Dlibaudit=no",
      "-Dcrypto=gnutls",
      "-Dmodem_manager=false",
      "-Dovs=false",
      "-Dnm_cloud_setup=false",
      "-Dnbft=false",
      "-Dppp=true",
      "-Dpppd='/usr/bin/pppd'",
      "-Diwd=true",
      # "-Djansson=true",
      "-Dkernel_firmware_dir='/usr/lib/firmware'",
      "-Diptables='/usr/bin/iptables'",
      "-Dip6tables='/usr/bin/ip6tables'",
      "-Dnft='/usr/bin/nft'",
      "-Dudev_dir='/usr/lib/udev'",
      "-Dconfig_wifi_backend_default=iwd",
      # "-Ddocs=true",
    ],

    buildEnv = {
      # https://bugs.gentoo.org/915819
      EXTRA_LDFLAGS = [
        # "-Wl,--undefined-version",
        "-lncursesw",
        "${SRC}/lib/libdl_fake.a",
        "$(pkg-config --static --libs gnutls)",
      ]
    },
    preConfigurePhase =
      [
        m%"sed -i "s|subdir('nm-initrd-generator')||g" ${SRC}/src/meson.build"%,
        m%"for f in $(find ${SRC} -name meson.build); do sed -i 's@shared_library@library@g' ${f};done"%,
        m%"for f in $(find ${SRC} -name meson.build); do sed -i 's@shared_module@library@g' ${f};done"%,
        m%"for f in $(find ${SRC}/tools -name '*.sh' -type f); do sed -i 's@\/bin\/bash@\/usr\/bin\/bash@g' ${f};done"%,
      ]
      @ [
        "clang  --verbose -g -c ${SRC}/lib/lib.c -o ${SRC}/lib/lib.c.o",
        "llvm-ar rcs ${SRC}/lib/libdl_fake.a ${SRC}/lib/lib.c.o",
        "llvm-ranlib ${SRC}/lib/libdl_fake.a",
      ],
    postInstallPhase = [
      "cd ${DEST}/usr/lib/NetworkManager/1.54.1/",
      "ln -s libnm-device-plugin-wifi.a libnm-device-plugin-wifi.so",
    ],
    # muslProvider = drvs.muslDebug,
    muslProvider = drvs.muslBothRenamedDl,
    biDrvs =
      [
        drvs.iwd,
        drvs.dbus,
        drvs.perl,
        drvs.openssl,
        drvs.ncurses,
        drvs.readline,
        drvs.libxml2,
        drvs.libxslt,
        drvs.utilLinux,
        drvs.eudevNm,
        drvs.libndp,
        drvs.glibDebug,
        drvs.pcre2,
        drvs.libffi,
        drvs.zlibNg,
        drvs.openresolv,
        drvs.ppp,
        drvs.libpsl,
        drvs.curl,
        drvs.newt,
        drvs.slang,
        drvs.linuxHeaders,
        drvs.bash,
        # drvs.jansson,
        drvs.gmp,
        drvs.libtasn1,
        drvs.nettleGmp,
        drvs.gnutls,
      ]
      @ (
        if distro.elogind then
          [
            drvs.elogindNm,
            drvs.libpam,
            drvs.libcap,
          ]
        else
          []
      ),
  },
}
& {
  lib,
  drvs,
  eudev,
  eudevNm =
    eudev
    & {
      postInstallPhase | priority 1 =
        eudev.postInstallPhase
        @ (
          let symbols = [
            "cescape_char",
            "close_many",
            "close_nointr",
            "endswith",
            "fopen_mode_to_flags",
            "format_timespan",
            "now",
            "octchar",
            "page_size",
            "path_compare",
            "path_extend_internal",
            "read_full_file_full",
            "read_full_stream_full",
            "safe_atoi",
            "safe_atolli",
            "safe_close",
            "strnappend",
            "timespec_load",
            "timespec_store",
            "warn_file_is_world_accessible",
            "cescape",
            "cmsg_close_all",
            "fd_wait_for_event",
            "filename_is_valid",
            "greedy_realloc",
            "hexchar",
            "is_dir",
            "is_main_thread",
            "loop_read",
            "loop_read_exact",
            "unhexchar",
            "unoctchar",
            "mkostemp_safe",
            "tempfn_xxxxxx",
          ]
          in
          std.array.map
            (fun s => "llvm-objcopy --redefine-sym %{s}=udev_private__%{s} ${DEST}/usr/lib/libudev.a")
            symbols
        )
    },
  elogindWithPolkit,
  elogindNm =
    elogindWithPolkit
    & {
      postInstallPhase | priority 10 =
        elogindWithPolkit.postInstallPhase
        @ (
          let symbols = [
            "cescape_length",
            "utf8_is_valid_n",
            "cunescape_one",
            "utf8_escape_invalid",
            "safe_close_pair",
            "ascii_is_valid_n",
            "close_many_and_free",
            "fclose_nointr",
            "safe_fclose",
            "decchar",
            "undecchar",
            "hexmem",
            "memdup_suffix0",
            "unhexmem_full",
            "fd_nonblock",
            "fd_cloexec",
            "greedy_realloc0",
            "greedy_realloc_append",
            "unbase64char",
            "unbase64mem_full",
            "unlink_tempfilep",
            "parse_boolean",
            "dual_timestamp_now",
            "safe_atollu_full",
            "triple_timestamp_now",
            "parse_ifindex",
            "map_clock_usec",
            "dual_timestamp_from_realtime",
            "parse_fd",
            "triple_timestamp_by_clock",
            "safe_atou_full",
            "safe_atou_bounded",
            "safe_atou8_full",
            "safe_atou16_full",
            "safe_atoi16",
            "verify_timezone",
            "clock_supported",
            "readlinkat_malloc",
            "fd_get_path",
            "fd_move_above_stdio",
            "stat_inode_same",
            "is_fs_type",
            "startswith",
            "startswith_no_case",
            "endswith_no_case",
            "readlink_value",
            "is_fs_type_at",
            "xstatfsat",
            "tmp_dir",
            "stat_verify_linked",
            "xopenat_full",
            "fd_verify_linked",
            "stat_verify_regular",
            "fd_verify_regular",
            "strv_find_case",
            "strv_find_startswith",
            "strv_free_erase",
            "first_word",
            "stat_inode_same",
            "is_fs_type",
            "is_fs_type_at",
            "xstatfsat",
            "fd_get_path",
            "stat_verify_linked",
            "fd_move_above_stdio",
            "fd_verify_linked",
            "stat_verify_regular",
            "fd_verify_regular",
            "stat_verify_directory",
            "fd_reopen",
            "fd_reopen_condition",
            "fd_verify_directory",
            "proc_mounted",
            "startswith",
            "safe_getcwd",
            "startswith_no_case",
            "path_startswith_strv",
            "path_startswith_full",
            "path_simplify_full",
            "path_find_first_component",
            "path_compare_filename",
            "path_extract_filename",
            "path_find_last_component",
            "last_path_component",
            "path_extract_directory",
            "filename_part_is_valid",
            "dot_or_dot_dot",
            "path_is_valid_full",
            "path_is_normalized",
            "truncate_nl_full",
            "ascii_tolower",
            "ascii_strlower",
            "string_has_cc",
            "strv_free_many",
            "strv_copy_n",
            "strv_copy_unless_empty",
            "strextend_with_separator_internal",
            "strv_new_internal",
            "truncate_nl_full",
            "ascii_tolower",
            "ascii_strlower",
            "string_has_cc",
            "strextend_with_separator_internal",
            "path_simplify_full",
            "strextendf_with_separator",
            "path_find_first_component",
            "path_compare_filename",
            "memeqbyte",
            "path_extract_filename",
            "path_find_last_component",
            "last_path_component",
            "path_extract_directory",
            "filename_part_is_valid",
            "dot_or_dot_dot",
            "path_is_valid_full",
            "path_is_normalized",
            "free_and_strdup",
            "free_and_strndup",
            "string_is_safe",
            "string_replace_char",
            "getenv_bool",
            "make_cstring",
            "strspn_from_end",
            "startswith_strv",
            "set_unset_env",
            "version_is_valid",
            "strlevenshtein",
            "ifname_valid_char",
            "ifname_valid_full",
            "next_datagram_size_fd",
            "cmsg_find",
            "sockaddr_un_set_path",
            "recvmsg_safe",
            "connect_unix_path",
            "socket_address_parse_unix",
            "reset_cached_pid",
            "getpid_cached",
            "ppoll_usec",
            "strv_extend_strv",
            "strv_split_newlines_full",
            "strv_split_full",
