            "strv_join_full",
            "string_replace_char",
            "make_cstring",
            "strspn_from_end",
            "strv_push_with_size",
            "fdopen_unlocked",
            "startswith_strv",
            "take_fdopen_unlocked",
            "strv_push_pair",
            "version_is_valid",
            "take_fdopen",
            "strv_insert",
            "ppoll_usec",
            "strv_consume_with_size",
            "strv_consume_prepend",
            "strv_extend_with_size",
            "strv_fnmatch_full",
            "strv_skip",
            "strv_extend_n",
            "strv_extend_assignment",
            "take_fdopendir",
            "open_memstream_unlocked",
            "fmemopen_unlocked",
            "read_virtual_file_fd",
            "fflush_and_check",
            "xfopenat_full",
            "read_virtual_file_at",
            "expand_to_usable",
            "expand_to_usable",
            "strv_fnmatch_full",
            "strv_skip",
            "strv_extend_n",
            "strv_extend_assignment",
            "take_fdopendir",
            "open_memstream_unlocked",
            "fmemopen_unlocked",
            "read_virtual_file_fd",
            "fflush_and_check",
            "xfopenat_full",
            "read_virtual_file_at",
          ]
          in

          std.array.map
            (fun s => "llvm-objcopy --redefine-sym %{s}=elogind_private__%{s} ${DEST}/usr/lib/libelogind.a")
            symbols
        )
    }
}
