{
  lib,
  iwd,
  dbus,
  perl,
  openssl,
  ncurses,
  readline,
  libxml2,
  libxslt,
  utilLinux,
  eudev,
  libndp,
  glib,
  pcre2,
  libffi,
  zlibNg,
  openresolv,
  ppp,
  libpsl,
  curl,
  newt,
  slang,
  linuxHeaders,

  networkmanager | lib.MesonPackage = {
    singleSource = {
      uri = "https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/archive/1.48.12/NetworkManager-1.48.12.tar.gz",
      sha256sum = "d041000b20e172fe4d93b7a12913422b58e8873fb9693c597938198313cc438c"
    },
    biDrvs =
      lib.biMap [
        iwd,
        dbus,
        perl,
        openssl,
        ncurses,
        readline,
        libxml2,
        libxslt,
        utilLinux,
        eudev,
        libndp,
        glib,
        pcre2,
        libffi,
        zlibNg,
        openresolv,
        ppp,
        libpsl,
        curl,
        newt,
        slang,
        linuxHeaders,
      ],
    extraMesonArgs = [
      "-Dtests=no",
      "-Dsession_tracking=no",
      "-Dpolkit=false",
      "-Dintrospection=false",
      "-Dsystemd_journal=false",
      "-Dsystemdsystemunitdir=no",
      "-Dselinux=false",
      "-Dlibaudit=no",
      "-Dcrypto=null",
      "-Dmodem_manager=false",
      "-Dovs=false",
    ]
  }
}
