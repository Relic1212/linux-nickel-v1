{
  lib,
  drvs,
  nwgLook | lib.MakePackage = {
    singleSource = {
      uri = "https://github.com/nwg-piotr/nwg-look/archive/refs/tags/v1.0.6.tar.gz",
      sha256sum = "ddaba674253fbbf8f3ee7392315e51408af445adb85ed4b0f70e50301801720d"
    },

    sourceInputs = [
      { src = singleSource },
      {
        src = {
          uri = "https://slackware.lngn.net/pub/source/nwg-look/nwg-look-vendor-1.0.6.tar.xz",
          sha256sum = "2851c2589bce9c1b4f3925ded6b7a9712361c66ac178266bc715a5215e28266c"
        },
        dest = "vendor",
      }
    ],
    llvmProvider = drvs.llvmFull,
    symlinkBuldInputs = true,
    biDrvs = [

      #drvs.pythonFull,
      drvs.atSpi2Core,
      drvs.basu,
      drvs.cairo,
      drvs.cairoGobject,
      drvs.dbus,
      drvs.eudev,
      drvs.expat,
      drvs.findutils,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.gettext,
      drvs.glib,
      drvs.glibDynamic,
      drvs.go_1_24,
      drvs.gobjectDynamic,
      drvs.gperf,
      drvs.gtk3,
      drvs.harfbuzz,
      drvs.hwdata,
      drvs.jsonC,
      drvs.lcms,
      drvs.libcanberra,
      drvs.libdisplayinfo,
      drvs.libdrm,
      drvs.libelf,
      drvs.libepoxy,
      drvs.libevdev,
      drvs.libffi,
      drvs.libfontenc,
      drvs.libinput,
      drvs.libjpegTurbo,
      drvs.libogg,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libtool,
      drvs.libvorbis,
      drvs.libx11,
      drvs.libxau,
      drvs.libxcb,
      drvs.libxcursor,
      drvs.libxcvt,
      drvs.libxext,
      drvs.libxf86vm,
      drvs.libxfixes,
      drvs.libxfont2,
      drvs.libxkbcommon,
      drvs.libxkbfile,
      drvs.libxrandr,
      drvs.libxrender,
      drvs.libxshmfence,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.mesa2,
      drvs.mpdecimal,
      drvs.mtdev,
      drvs.muslShared,
      drvs.ncurses,
      drvs.openssl,
      drvs.pango,
      drvs.pcre2,
      drvs.pixman,
      drvs.pkgconf,
      drvs.pythonDynamicPic,
      drvs.pythonSetuptools,
      drvs.readline,
      drvs.scdoc,
      drvs.seatd,
      drvs.simde,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.symbolsNerdFont,
      drvs.vala,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.xcbProto,
      drvs.xcbRenderutil,
      drvs.xcbUtilErrors,
      drvs.xcbUtilWm,
      drvs.xorgMacros,
      drvs.xorgproto,
      drvs.xtrans,
      drvs.xwayland,
      drvs.xxhash,
      drvs.zlibNg,
    ],

    separateBuildDir = false,
    configurePhase = [
      "export GOROOT=/usr/lib/go",
      "export GOMODCACHE=${SRC}/go-mod",
      "export CGO_ENABLED=1",
      "mkdir /tmp/home",
      "export HOME=/tmp/home",
    ],

    buildPhase = [
      "go build"
    ],
    installPhase = [],
  }
}
