{
  lib,
  drvs,
  swaync | lib.MesonPackage = {
    singleSource = {
      uri = "https://github.com/ErikReider/SwayNotificationCenter/archive/refs/tags/v0.12.6.tar.gz",
      sha256sum = "0c844eb5c9524f924495bd4145e5db575096de36f3ec87fb37e4c1ed6eacb897",
    },

    buildEnv = {
      EXTRA_LDFLAGS = [
        # missing from libpulse so would ideally be fixed there instead
        "$(pkg-config --libs --static dbus-1)",
        "$(pkg-config --libs --static wayland-client gtk4-layer-shell-0)",
        "$(pkg-config --libs --static libadwaita-1)",
        "/tmp/workdir/src/dlopen.o",
        "/tmp/workdir/src/constructor.o",
      ],
    },
    preConfigurePhase = [
      "echo '%{import "swaync_dlopen.c" as 'Text}' > ${SRC}/dlopen.c",
      "echo '%{import "constructor.c" as 'Text}' > ${SRC}/constructor.c",
      "${CC} ${CFLAGS} -c ${SRC}/dlopen.c -o ${SRC}/dlopen.o",
      "${CC} ${CFLAGS} -c ${SRC}/constructor.c -o ${SRC}/constructor.o",
    ],

    muslProvider = drvs.muslBothRenamedDl,
    llvmProvider = drvs.llvmFull,
    pythonProvider = drvs.pythonDynamic,
    biDrvs = [
      drvs.muslShared,
      drvs.atSpi2Core,
      drvs.cairo,
      drvs.cairoGobject,
      drvs.cairomm_1_16,
      drvs.dbus,
      drvs.expat,
      drvs.eudev,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.gdkPixbufIntrospectionDynamic & { priority = -1 },
      drvs.glibPatched,
      drvs.glibGobjectDynamic & { priority = -2 },
      drvs.glibmm_2_82,
      drvs.gobjectDynamic,
      drvs.gobjectDynamicCairo2 & { priority = -1 },
      drvs.gperf,
      drvs.grapheneIntrospection,
      drvs.gtk4,
      drvs.gtk4IntrospectionDynamic & { priority = -1 },
      drvs.gtk4LayerShell,
      drvs.gtk4LayerShellIntrospection & { priority = -1 },
      drvs.gtkmm4,
      drvs.harfbuzzFull,
      drvs.harfbuzzGobjectDynamic & { priority = -1 },
      drvs.hwdata,
      drvs.libdrm,
      drvs.libelf,
      drvs.libepoxy,
      drvs.libevdev,
      drvs.libffi,
      drvs.libjpegTurbo,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libsigcpp,
      drvs.libtiff,
      drvs.libxkbcommon,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.mesaExp,
      drvs.ncurses,
      drvs.pango,
      drvs.pangoGobject & { priority = -1 },
      drvs.pangomm_2_48,
      drvs.pcre2,
      drvs.pixman,
      drvs.readline,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.vala,
      drvs.waylandGtk4LayerShell,
      drvs.waylandProtocols,
      drvs.zlibNg,
      #
      drvs.kmod,
      drvs.xz,
      drvs.openssl,
      drvs.zstd,
      drvs.utilLinux,
      #
      drvs.luajitStatic,
      #
      drvs.libinput,
      drvs.mtdev,
      #
      drvs.alsaLibs,
      drvs.bluez,
      drvs.sbc,
      drvs.ffmpeg,
      drvs.speex,
      drvs.speexdsp,
      drvs.check,
      drvs.pulseaudio17,
      #
      drvs.sassc,
      drvs.blueprintCompiler,
      drvs.pythonPygobject,
      drvs.jsonGlib,
      drvs.granite7,
      drvs.libadwaita,
      drvs.libadwaitaIntrospection & { priority = -1 },
      drvs.libgee,
      drvs.appstream,
      drvs.curl,
      drvs.libpsl,
      drvs.libxml2,
      drvs.libxmlb,
      drvs.libyaml,
      drvs.scdoc,
    ],
  }
}
