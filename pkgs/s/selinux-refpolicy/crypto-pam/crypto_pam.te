### with permissive ###
require {
	type var_log_t;
	type init_runtime_t;
	type init_t;
	type udev_t;
	type system_dbusd_t;
	type setfiles_t;
	type kmod_t;
	class file { append getattr ioctl };
	class fd use;
}

#============= kmod_t ==============
allow kmod_t init_runtime_t:file { append getattr };

#============= setfiles_t ==============
allow setfiles_t init_runtime_t:file { append ioctl };

#============= system_dbusd_t ==============
allow system_dbusd_t var_log_t:file append;

#============= udev_t ==============
allow udev_t init_runtime_t:file { append ioctl };
allow udev_t init_t:fd use;
