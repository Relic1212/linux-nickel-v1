{
  lib,
  drvs,
  system76Scheduler | lib.CargoPackage = {
    singleSource = {
      uri = "https://github.com/pop-os/system76-scheduler/archive/refs/tags/2.0.2.tar.gz",
      sha256sum = "8fc1845136fd2b346617599d3e01df32584d6d1974381ce36c8e33338d1a2867",
    },

    crates = lib.functions.filterCrates (import "system76-scheduler-crates.json"),

    extraEnv.EXTRA_RUSTFLAGS = [
      # "-C link-arg=-L/usr/lib/clang/21/lib/linux",
      # "-C link-arg=-lclang_rt.builtins-x86_64",
      "-C link-arg=$(clang --print-file-name=libclang_rt.builtins-x86_64.a)",
      "-C link-arg=-lLLVMAnalysis",
    ],
    llvmProvider = drvs.llvmFull,
    biDrvs = [
      drvs.dbus,
      drvs.alsaLibs,
      drvs.fontconfig,
      drvs.freetype,
      drvs.zlibNg,
      drvs.gperf,
      drvs.pixman,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.libffi,
      drvs.libxkbcommon,
      drvs.expat,
      drvs.linuxHeaders,
      drvs.ncurses,
      drvs.readline,
      drvs.pcre2,
      drvs.pango,
      drvs.cairo,
      drvs.libpng,
      drvs.harfbuzz,
      drvs.glibDynamic,
      drvs.muslShared,
      drvs.hwdata,
      drvs.gobjectDynamic,
      drvs.cairoGobject,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.libjpegTurbo,
      drvs.libepoxy,
      drvs.atSpi2Core,
      drvs.mesa2,
      drvs.libelf,
      drvs.libdrm,
      drvs.libpciaccess,
      drvs.spirvTools,
      drvs.spirvLlvmTranslator,
      drvs.gtk3,
      drvs.eudev,
      drvs.kmod,
      drvs.xz,
      drvs.openssl,
      drvs.zstd,
      drvs.utilLinux,
      drvs.libevdev,
      (drvs.findutils & { priority = 1 }),
      drvs.libsndfile,
      drvs.libopus,
      drvs.lua,
      drvs.bluez,
      drvs.sbc,
      drvs.libusb,
      drvs.ffmpeg,
      drvs.jansson,
      drvs.fdkAac,
      drvs.ldacbt,
      # 
      drvs.libyaml,
      drvs.llvmConfigStatic,
      drvs.libstdcppCompat,
    ],
    allowDubplicateBuldInputs = true,

    propagatedBuildInputs = [
      drvs.pipewire
    ],

    configurePhase = [
      m%"sed -i 's@"runtime"@"static"@g' ${SRC}/vendor/bindgen-*/Cargo.toml"%,
      m%"sed -i 's@"logging",@@g' ${SRC}/vendor/bindgen-*/Cargo.toml"%,
      m%"sed -i 's@"which-rustfmt",@@g' ${SRC}/vendor/bindgen-*/Cargo.toml"%,
      m%"sed -i 's@runtime = @# runtime = @g' ${SRC}/vendor/bindgen-*/Cargo.toml"%,
      m%"sed -i 's@"runtime"@"static"@g' ${SRC}/vendor/libspa-sys*/Cargo.toml"%,
      m%"sed -i 's@default-features = false@@g' ${SRC}/vendor/libspa-sys*/Cargo.toml"%,
      m%"sed -i 's@default-features = false@@g' ${SRC}/vendor/pipewire-sys*/Cargo.toml"%,
      m%"sed -i 's@"runtime"@"static"@g' ${SRC}/vendor/pipewire-sys*/Cargo.toml"%,
      m%"sed -i 's@"runtime"@"static","libcpp"@g' ${SRC}/vendor/clang-sys*/Cargo.toml"%,
      m%"sed -i 's|target_env = "musl", target_os = "emscripten"|target_os = "emscripten"|g' ${SRC}/vendor/libc-0.2.141/src/unix/linux_like/mod.rs"%,
      m%"sed -i 's|open64|open|g' ${SRC}/vendor/libc-0.2.141/src/unix/linux_like/mod.rs"%,
      m%"sed -i 's|open64|open|g' ${SRC}/vendor/getrandom-0.2.8/src/util_libc.rs"%,

      #   "export LIBCLANG_STATIC_PATH=/usr/lib",
      #   "export "
      "export EXECSNOOP_PATH=/usr/bin/execsnoop-bpfcc"
    ],
    postInstallPhase = [
      "mkdir -p ${DEST}/etc/system76-scheduler/process-scheduler",
      "install -Dm0644 data/config.kdl ${DEST}/etc/system76-scheduler/config.kdl",
      "install -Dm0644 data/pop_os.kdl ${DEST}/etc/system76-scheduler/process-scheduler/pop_os.kdl",
      "install -Dm0644 data/com.system76.Scheduler.service ${DEST}/usr/lib/systemd/system/com.system76.Scheduler.service",
      "install -Dm0644 data/com.system76.Scheduler.conf ${DEST}/etc/dbus-1/system.d/com.system76.Scheduler.conf",
    ]
  }
}
