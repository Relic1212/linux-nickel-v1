{
  lib,
  expat,
  jsonC,
  pcre2,
  mesa2,
  wayland,
  waylandProtocols,
  libelf,
  libpciaccess,
  libdrm,
  libxkbcommon,
  pixman,
  eudev,
  libudevZero,
  seatd,
  libdisplayinfo,
  libinput,
  libffi,
  libevdev,
  mtdev,
  pango,
  cairo,
  libpng,
  freetype,
  fontconfig,
  zlibNg,
  harfbuzz,
  glib,
  hwdata,
  linuxHeaders,
  wlroots18,
  llvmFull,

  sov | lib.MesonPackage = {
    singleSource = {
      uri = "https://github.com/milgra/sov/archive/19809ae535f8417098020f86ceefa25dbd3c5a90.zip",
      sha256sum = "fbc7ea12239a4c12d6f2d83541dd30a44f03360c530aa3c5d9f81be1595231b8",
    },
    buildEnv.EXTRA_LDFLAGS = ["-lc++"],
    llvmProvider = lib.singleBiMap llvmFull,
    biDrvs =
      lib.biMap [
        expat,
        jsonC,
        pcre2,
        mesa2,
        wayland,
        waylandProtocols,
        libelf,
        libpciaccess,
        libdrm,
        libxkbcommon,
        pixman,
        eudev,
        # libudevZero,
        seatd,
        libdisplayinfo,
        libinput,
        libffi,
        libevdev,
        mtdev,
        pango,
        cairo,
        libpng,
        freetype,
        fontconfig,
        zlibNg,
        harfbuzz,
        glib,
        hwdata,
        linuxHeaders,
        # wlroots18,
      ],
  }
}
