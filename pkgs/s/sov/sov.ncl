{
  lib,
  drvs,
  sov | lib.MesonPackage
    = {
      singleSource = {
        uri = "https://github.com/milgra/sov/archive/19809ae535f8417098020f86ceefa25dbd3c5a90.zip",
        sha256sum = "fbc7ea12239a4c12d6f2d83541dd30a44f03360c530aa3c5d9f81be1595231b8",
      },
      buildEnv.EXTRA_LDFLAGS = ["-lc++"],
      llvmProvider = drvs.llvmFull,
      biDrvs = [
        drvs.expat,
        drvs.jsonC,
        drvs.pcre2,
        drvs.mesa2,
        drvs.wayland,
        drvs.waylandProtocols,
        drvs.libelf,
        drvs.libpciaccess,
        drvs.libdrm,
        drvs.libxkbcommon,
        drvs.pixman,
        # drvs.eudev,
        drvs.libudevZero,
        drvs.seatd,
        drvs.libdisplayinfo,
        drvs.libinput,
        drvs.libffi,
        drvs.libevdev,
        drvs.mtdev,
        drvs.pango,
        drvs.cairo,
        drvs.libpng,
        drvs.freetype,
        drvs.fontconfig,
        drvs.zlibNg,
        drvs.harfbuzz,
        drvs.glib,
        drvs.hwdata,
        drvs.linuxHeaders,
        # drvs."wlroots-18",
      ],
    }
}
