{
  lib,
  drvs,
  satty | lib.CargoPackage = {
    singleSource = {
      uri = "https://github.com/Satty-org/Satty/archive/refs/tags/v0.20.1.tar.gz",
      sha256sum = "86e85e8abdcfee925f0b95d424bd9eed9ad78aeb537707132e77ccb63133ac97",
    },
    crates = lib.functions.filterCrates (import "satty-crates.json"),

    buildEnv = {
      EXTRA_LDFLAGS = [
        "-Wl,--allow-multiple-definition",
        # m%"$(for l in $(pkg-config --libs --static egl epoxy);do printf " -C link-arg=$l ";done)"%,
      ],
    },
    extraEnv = {
      EXTRA_RUSTFLAGS = [
        "-C link-arg=-Wl,--allow-multiple-definition",
        "-C link-arg=/tmp/workdir/src/dlopen.o",
        "-C link-arg=-lc++",
        m%"$(for l in $(pkg-config --libs --static glesv2 egl epoxy);do printf " -C link-arg=$l ";done)"%,
      ],
    },

    configurePhase = [
      lib.functions.writeFile "${SRC}/dlopen.c" (import "satty_dlopen.c" as 'Text),
      "cat >>${SRC}/dlopen.c << 'EOF'\n%{(import "constructor.c" as 'Text)}\nEOF\n",
      "${CC} ${CFLAGS} -Werror -c ${SRC}/dlopen.c -o ${SRC}/dlopen.o",
      "cargo tree --target=x86_64-unknown-linux-musl -e features",
    ],
    linkSelfContained = "no",

    llvmProvider = drvs.llvmFull,
    muslProvider = drvs.muslBothRenamedDlRelease,

    biDrvs = [
      drvs.appstream,
      drvs.atSpi2Core,
      drvs.cairo,
      drvs.cairoGobject,
      drvs.curl,
      drvs.eudev,
      drvs.expat,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.gettext,
      drvs.glib,
      # drvs.glibDynamic,
      drvs.gmobile,
      drvs.gnomeDesktop,
      drvs.gobjectDynamic,
      drvs.gperf,
      drvs.graphene,
      drvs.gsettingsDesktopSchemas,
      drvs.gsound,
      drvs.gtk4,
      drvs.gudev,
      drvs.harfbuzzFull,
      drvs.hwdata,
      drvs.isoCodes,
      drvs.jsonGlib,
      drvs.kmod,
      drvs.libbsd,
      drvs.libadwaita,
      drvs.libcanberra,
      drvs.libdrm,
      drvs.libelf,
      drvs.libepoxy,
      drvs.libffi,
      drvs.libgtop,
      drvs.libjpegTurbo,
      drvs.libmd,
      drvs.libogg,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libportal,
      drvs.libpsl,
      drvs.libseccomp,
      drvs.libtiff,
      drvs.libtool,
      drvs.libvorbis,
      drvs.libxkbcommon,
      drvs.libxml2,
      drvs.libxmlb,
      drvs.libyaml,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.mesa2,
      # drvs.muslShared,
      drvs.ncurses,
      drvs.openssl,
      drvs.pango,
      drvs.pcre2,
      drvs.pixman,
      drvs.readline,
      # drvs.sassc,
      drvs.sharedMimeInfo,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.utilLinux,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.xkeyboardConfig,
      drvs.xz,
      drvs.zlibNg,
      drvs.zstd,
    ],
  }
}
