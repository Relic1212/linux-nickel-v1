{
  lib,
  drvs,
  systemd259 | lib.MesonPackage = {
    debug = true,
    singleSource = {
      uri = "https://github.com/systemd/systemd/archive/refs/tags/v259-rc2.tar.gz",
      sha256sum = "639f1f6453bce3412feb8c4471355c3839765e254afe2638f885fd7de99a37f0"
    },
    patches = [
      #   {
      #     sha256sum = "7a4631d2a63058622b36e1debc5fea6c11d56fd8b6089a0b5868f128e843996f",
      #     file = "systemd-link-kmod-3.patch"
      #   },
      # { file ="systemd-259-dl.patch", sha256sum="ab7fba45a13c02837d53e2a22b08f98df04586c696ae43e7658ebc5b078eecd6" },
      { file = "systemd-259-pam.patch", sha256sum = "b17134446fc10c7104bc3fb25b87bd147661511ccaa10a1ccdea5908eecf30e4" },
    ],
    extraMesonArgs =
      [
        "-Dlibc=musl",
        "-Dtests=false",
        # "-Dstatic-libudev=no-pic",
        "-Dpamconfdir=no",
        "-Dsplit-bin=false",
      ]
      @ (
        std.array.map
          (fun l => "-Dlink-%{l}-shared=false")
          [
            "udev",
            "executor",
            "systemctl",
            "networkd",
            "timesyncd",
            "journalctl",
            "boot",
            "portabled"
          ]
      ),
    preConfigurePhase = [
      m%"sed -i "s|libshared = shared_library(|libshared = shared_library( 'shared' +|g" ${SRC}/src/shared/meson.build"%,
      m%"sed -i "s|libcore = shared_library(|libcore = shared_library( 'shared' +|g" ${SRC}/src/core/meson.build"%,
      m%"sed -i "s|libudev = shared_library(|libudev = shared_library( 'shared' + |g" ${SRC}/meson.build"%,
      "for f in $(find ${SRC} -name meson.build); do sed -i 's|shared_library|library|g' ${f};done",
      m%"sed -i 's@sym_pam@pam@g' ${SRC}/src/core/exec-invoke.c"%,
      m%"sed -i 's@dlopen_libpam()@1@g' ${SRC}/src/core/exec-invoke.c"%,
      m%"sed -i 's@dlopen_libpam()@1@g' ${SRC}/src/login/pam_systemd.c"%,
      m%"sed -i 's@sym_pam@pam@g' ${SRC}/src/shared/pam-util.c"%,
      m%"sed -i 's@DLSYM_PROTOTYPE@// DLSYM_PROTOTYPE@g' ${SRC}/src/shared/pam-util.c"%,
      m%"sed -i "s@int dlopen_libpam(void)@#ifdef NO_SUCH_MACRO\n@g" ${SRC}/src/shared/pam-util.c"%,
      m%"sed -i "s@void pam_log_setup(void)@#endif\nvoid pam_log_setup(void)@g" ${SRC}/src/shared/pam-util.c"%,
      # m%"sed -i 's@DLSYM_ARG@// DLSYM_ARG@g' ${SRC}/src/shared/pam-util.c"%,
      # m%"sed -i "s@DLSYM_ARG(pam_vsyslog)@DLSYM_ARG(pam_vsyslog)\n@g" ${SRC}/src/shared/pam-util.c"%,
      # m%"sed -i "s@LOG_DEBUG,\n@LOG_DEBUG\n                 //@g" ${SRC}/src/shared/pam-util.c"%,
      m%"sed -i 's@extern DLSYM_PROTOTYPE@// extern DLSYM_PROTOTYPE@g' ${SRC}/src/shared/pam-util.h"%,
      m%"sed -i 's@sym_pam@pam@g' ${SRC}/src/shared/pam-util.h"%,
      m%"sed -i 's|pam_sm_close_session|pam_systemd_pam_sm_close_session|g' ${SRC}/src/login/pam_systemd.sym"%,
      # m%"sed -i 's|pam_sm_open_session|pam_systemd_pam_sm_open_session|g' ${SRC}/src/login/pam_systemd.sym"%,
      # m%"sed -i "s@'version-script'@# 'version-script'@g" ${SRC}/src/login/meson.build"%,
      # m%"sed -i "s@'-Wl,--version-script=' + d@# '-Wl,--version-script=' + d@g" ${SRC}/meson.build"%,
      # m%"sed -i "s@dict.get('version-script')@# dict.get('version-script')@g" ${SRC}/meson.build"%,
      m%"sed -i 's@local@global@g' ${SRC}/src/login/pam_systemd.sym"%,
    ],
    postInstallPhase =
      (
        let symbols = [
          "ascii_strlower",
          "ascii_tolower",
          "base64char",
          "cellescape",
          "cescape_char",
          "cescape_length",
          "chmod_and_chown_at",
          "cmp_int",
          "cmp_uint16",
          "cunescape_length_with_prefix",
          "cunescape_one",
          "decchar",
          "delete_chars",
          "delete_trailing_chars",
          "ellipsize_mem",
          "emoji_enabled",
          "env_assignment_is_valid",
          "env_name_is_valid",
          "env_value_is_valid",
          "escape_non_printable_full",
          "expand_to_usable",
          "extract_first_word",
          "fdopen_unlocked",
          "fflush_and_check",
          "fflush_sync_and_check",
          "first_word",
          "fmemopen_unlocked",
          "free_and_strdup",
          "free_and_strndup",
          "get_proc_field",
          "getenv_bool",
          "greedy_realloc_append",
          "greedy_realloc",
          "greedy_realloc0",
          "hexchar",
          "hexdump",
          "hexmem",
          "json_dispatch_user_group_name",
          "json_log_internal",
          "json_tokenize",
          "make_cstring",
          "memdup_suffix0",
          "memdup",
          "memeqbyte",
          "octchar",
          "open_memstream_unlocked",
          "page_size",
          "pam_acquire_bus_connection",
          "pam_bus_data_disconnectp",
          "pam_cleanup_free",
          "pam_syslog_errno",
          "pam_syslog_pam_error",
          "parse_boolean",
          "parse_fd",
          "parse_ifindex",
          "parse_pid",
          "parse_tristate_full",
          "path_make_absolute_cwd",
          "quote_command_line",
          "read_full_file_full",
          "read_full_stream_full",
          "read_line_full",
          "read_one_line_file_at",
          "read_virtual_file_at",
          "readlink_value",
          "readlinkat_malloc",
          "rename_noreplace",
          "safe_atod",
          "safe_atoi",
          "safe_atoi16",
          "safe_atolli",
          "safe_atollu_full",
          "safe_atou_bounded",
          "safe_atou_full",
          "safe_atou16_full",
          "safe_atou8_full",
          "safe_fgetc",
          "set_unset_env",
          "shell_maybe_quote",
          "strdupcspn",
          "streq_skip_trailing_chars",
          "strextend_with_separator_internal",
          "strextendf_with_separator",
          "string_contains_word_strv",
          "string_extract_line",
          "string_has_cc",
          "string_is_safe",
          "string_replace_char",
          "string_truncate_lines",
          "strlevenshtein",
          "strshorten",
          "strspn_from_end",
          "strstrip",
          "strv_compare",
          "strv_consume_prepend",
          "strv_consume_with_size",
          "strv_copy_n",
          "strv_copy_unless_empty",
          "strv_env_replace_consume",
          "strv_env_replace_strdup",
          "strv_env_unset",
          "strv_extend_assignment",
          "strv_extend_n",
          "strv_extend_strv",
          "strv_extend_with_size",
          "strv_find_case",
          "strv_find_startswith",
          "strv_find",
          "strv_fnmatch_full",
          "strv_free_erase",
          "strv_free_many",
          "strv_free",
          "strv_insert",
          "strv_join_full",
          "strv_length",
          "strv_new_ap",
          "strv_new_internal",
          "strv_print_full",
          "strv_push_pair",
          "strv_push_with_size",
          "strv_remove",
          "strv_skip",
          "strv_sort",
          "strv_split_full",
          "strv_split_newlines_full",
          "strv_uniq",
          "strverscmp_improved",
          "take_fdopen_unlocked",
          "take_fdopen",
          "take_fdopendir",
          "truncate_nl_full",
          "unbase64char",
          "unbase64mem_full",
          "undecchar",
          "unhexchar",
          "unhexmem_full",
          "unoctchar",
          "verify_file_at",
          "version_is_valid",
          "warn_file_is_world_accessible",
          "write_string_filef",
          "xescape_full",
          "xfopenat_full",
          "xopendirat",
        ]
        in
        std.array.map
          (fun s => "llvm-objcopy --redefine-sym %{s}=pam_systemd_private__%{s} ${DEST}/usr/lib/security/pam_systemd.a")
        # (fun s => "llvm-objcopy -W %{s} ${DEST}/usr/lib/security/pam_systemd.a")
        # symbols
          []
      )
      @ [
        "(cd ${DEST}/usr/bin && ln -s ../lib/systemd/systemd-udevd udevd)",
        "install -d -m0755 ${DEST}/usr/libexec",
        "(cd ${DEST}/usr/libexec && ln -s ../lib/systemd/systemd-logind elogind)",
        m%"for f in $(find ${DEST}/usr/share/dbus-1/ -type f); do sed -i 's@\/bin\/false@\/usr\/bin\/true@g' ${f};done"%,
        "for symbol in $(llvm-nm ${DEST}/usr/lib/security/pam_systemd.a | grep ' t ' | cut -d ' ' -f3); do echo 'globalizing ${symbol}'; llvm-objcopy --globalize-symbol ${symbol} ${DEST}/usr/lib/security/pam_systemd.a;done",
        "cp ${DEST}/usr/lib/security/pam_systemd.a ${DEST}/usr/lib/libpam_systemd.a",
      ],
    buildEnv = {
      EXTRA_LDFLAGS = [
        "-ldl_systemd",
        "$(pkg-config --static --libs libkmod)",
        "-lpam",
        "-lpam_misc",
      ],
    },
    muslProvider = drvs.muslBothRenamedDl,
    biDrvs = [
      drvs.systemdLibdl,
      drvs.acl,
      drvs.dbus,
      drvs.zlibNg,
      drvs.zstd,
      drvs.xz,
      drvs.gettext,
      drvs.basefiles,
      drvs.gnugrep,
      drvs.kmodRenamedSyms,
      drvs.openssl,
      drvs.libcap,
      drvs.pythonDynamic,
      drvs.pythonJinja2,
      # drvs.bash,
      # drvs.coreutils,
      #   drvs.muslShared,
      drvs.pythonFlitCore,
      drvs.pythonMarkupsafe,
      drvs.linuxHeaders,
      drvs.gperf,
      drvs.pythonElftools,
      drvs.muslGetent,
      drvs.utilLinux,
      drvs.libarchive,
      drvs.libpam,
      #   drvs.busyboxMiscUtils,
    ],
    # pulls in static python otherwise
    baseBuildinputPackages = [
      drvs.bash,
      drvs.coreutils,
      drvs.bashSh,
      drvs.meson,
      drvs.samurai,
      drvs.pkgconf,
      drvs.musl,
      drvs.llvm,
      drvs.ccacheBin,
      muslProvider,
      drvs.diffutils,
      drvs.gnupatch,
      drvs.gnused,
      drvs.findutils,
      drvs.gawk,
    ],
  },
  libpamSystemd | lib.Package = {
    biDrvs = [
      drvs.systemd259,
    ],
    installPhase = [
      "install -dm0755 ${DEST}/usr/lib",
      "install -m0755 /usr/lib/libpam_systemd.a ${DEST}/usr/lib",
    ]
  }
}
& {
  lib,
  drvs,
  systemdLibdl | lib.MakePackage = {
    singleSource = {
      uri = "/home/user/Projects/test-static-linking/kmod",
      sha256sum = "aa9e8def409709c26b36554d9ee1a15cd5089dd1",
      fetchMethod = "git"
    },
    preConfigurePhase = [
      m%"for f in $(find ${SRC}/ -type f); do sed -i 's|stderr|stdout|g' ${f}; done"%,
    ],
  }
}
