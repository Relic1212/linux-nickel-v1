{
  lib,
  drvs,
  busybox,
  busyboxMiscUtils | lib.MakePackage = (
    busybox
    & {
      name = "busybox-misc-utils",
      installPhase | priority 100 = [
        "install -d -m0755 ${DEST}/usr/bin",
        "install -m0755 ${SRC}/busybox ${DEST}/usr/bin",
        "cd ${DEST}/usr/bin",
        "ln -s busybox sed",
        "ln -s busybox awk",
        "ln -s busybox diff",
        "ln -s busybox find",
        "ln -s busybox patch",
      ],
    }
  ),
  systemdBoot | lib.MesonPackage = {
    name = "systemd-boot",
    sourceInputs = [
      {
        src = {
          uri = "https://github.com/systemd/systemd/archive/refs/tags/v257.5.tar.gz",
          sha256sum = "4d65f9482608cf9f7823df42a6d7796f0e0dfcfb94301df75effff86d40da33e",
        }
      }
    ],
    biDrvs = [
      drvs.kmod,
      drvs.libcap,
      drvs.pythonDynamic,
      drvs.pythonJinja2,
      # drvs.bash,
      # drvs.coreutils,
      drvs.muslShared,
      drvs.pythonFlitCore,
      drvs.pythonMarkupsafe,
      drvs.linuxHeaders,
      drvs.gperf,
      drvs.pythonElftools,
      drvs.muslGetent,
      drvs.utilLinux,
      drvs.libarchive,
      drvs.busyboxMiscUtils,
    ],
    # pulls in static python otherwise
    baseBuildinputPackages = [
      drvs.bash,
      drvs.coreutils,
      drvs.bashSh,
      drvs.meson,
      drvs.samurai,
      drvs.pkgconf,
      drvs.musl,
      drvs.llvm,
      drvs.ccacheBin,
    ],

    preConfigurePhase = [
      "sed -i 's@wchar_t@uint16_t@g' ${SRC}/src/boot/efi.h",
      "sed -i 's@wchar_t@uint16_t@g' ${SRC}/src/boot/efi-string.h",
      "sed -i 's@wchar_t@uint16_t@g' ${SRC}/src/boot/efi-string.c",
      "sed -i 's@-lgcc@@g' ${SRC}/src/boot/meson.build",
    ],

    buildPhase = [
      "ninja systemd-boot"
    ],

    installPhase = [
      "install -d -m0755 ${DEST}/usr/lib/systemd/boot/efi",
      "install -m0755 ./src/boot/systemd-bootx64.efi ${DEST}/usr/lib/systemd/boot/efi",
      "install -m0755 ./src/boot/linuxx64.efi.stub ${DEST}/usr/lib/systemd/boot/efi",
      "install -m0755 ./src/boot/addonx64.efi.stub ${DEST}/usr/lib/systemd/boot/efi",
    ],

    extraMesonArgs = [
      "-Dacl=disabled",
      "-Dstoragetm=false",
      "-Dkmod=disabled",
      "-Dselinux=disabled",
      "-Dsysusers=false",
      "-Dtmpfiles=false",
      "-Dadm-group=false",
      "-Danalyze=false",
      "-Dapparmor=disabled",
      "-Daudit=disabled",
      "-Dbacklight=false",
      "-Dbinfmt=false",
      "-Dbpf-framework=disabled",
      "-Dbzip2=disabled",
      "-Dcoredump=false",
      "-Ddbus=disabled",
      "-Delfutils=disabled",
      "-Denvironment-d=false",
      "-Dfdisk=disabled",
      "-Dgcrypt=disabled",
      "-Dglib=disabled",
      "-Dgshadow=false",
      "-Dgnutls=disabled",
      "-Dhibernate=false",
      "-Dhostnamed=false",
      "-Didn=false",
      "-Dima=false",
      "-Dinitrd=false",
      "-Dfirstboot=false",
      "-Dldconfig=false",
      "-Dlibcryptsetup=disabled",
      "-Dlibcurl=disabled",
      "-Dlibfido2=disabled",
      "-Dlibidn=disabled",
      "-Dlibidn2=disabled",
      "-Dlibiptc=disabled",
      "-Dlocaled=false",
      "-Dlogind=false",
      "-Dlz4=disabled",
      "-Dmachined=false",
      "-Dmicrohttpd=disabled",
      "-Dnetworkd=false",
      "-Dnscd=false",
      "-Dnss-myhostname=false",
      "-Dnss-resolve=disabled",
      "-Dnss-systemd=false",
      "-Doomd=false",
      "-Dopenssl=disabled",
      "-Dp11kit=disabled",
      "-Dpam=disabled",
      "-Dpcre2=disabled",
      "-Dpolkit=disabled",
      "-Dportabled=false",
      "-Dpstore=false",
      "-Dpwquality=disabled",
      "-Drandomseed=false",
      "-Dresolve=false",
      "-Drfkill=false",
      "-Dseccomp=disabled",
      "-Dsmack=false",
      "-Dsysext=false",
      "-Dtimedated=false",
      "-Dtimesyncd=false",
      "-Dtpm=false",
      "-Dqrencode=disabled",
      "-Dquotacheck=false",
      "-Duserdb=false",
      "-Dutmp=false",
      "-Dvconsole=false",
      "-Dwheel-group=false",
      "-Dxdg-autostart=false",
      "-Dxkbcommon=disabled",
      "-Dxz=disabled",
      "-Dzlib=disabled",
      "-Dzstd=disabled",
      "-Dtests=false",
      "-Dkernel-install=false",
      "-Dlink-boot-shared=false",
      "-Dstandalone-binaries=true",
      "-Dblkid=disabled",
      "-Defi=true",
      "-Dhwdb=false",
      "-Dvmspawn=disabled",
      "-Dlink-udev-shared=false",
      "-Dlink-systemctl-shared=false",
      "-Dlink-networkd-shared=false",
      "-Dlink-timesyncd-shared=false",
      "-Dlink-journalctl-shared=false",
      "-Dlink-portabled-shared=false",
      "-Dstatic-libudev=true",
      "-Dsplit-bin=false",
      "-Dbootloader=enabled",
      "-Dsbat-distro=Linux",
      "-Dsbat-distro-summary=Linux",
      "-Dsbat-distro-pkgname=Systemd",
      "-Dsbat-distro-version=latest",
      "-Dsbat-distro-url=http://localhost",
    ]
  }
}
& (import "systemd258.ncl")
