{
  lib,
  fontconfig,
  freetype,
  zlibNg,
  gperf,
  pixman,
  wayland,
  waylandProtocols,
  libffi,
  libxkbcommon,
  expat,
  linuxHeaders,
  ncurses,
  readline,
  pcre2,
  pango_1_56,
  cairo,
  libpng,
  harfbuzzFull,
  glibDynamic,
  muslShared,
  hwdata,
  gobjectDynamic,
  cairoGobject,
  fribidi,
  gdkPixbufFull,
  libjpegTurbo,
  libepoxy,
  atSpi2Core,
  mesa2,
  libelf,
  libdrm,
  libpciaccess,
  llvmConfigStatic,
  spirvTools,
  spirvLlvmTranslator,
  gtk4,
  vala,
  pythonSetuptools,
  libtiff,
  graphene,
  gtkmm4,
  libsigcpp,
  cairomm_1_16,
  pangomm_2_48,
  glibmm_2_82,
  gtk4LayerShell,
  pkgconf,
  llvmFull,

  sysboard | lib.MakePackage = {
    singleSource = {
      uri = "https://github.com/System64fumo/sysboard/archive/90ceddb67bcf3a609e7892bc67e8c7ca806b85bc.zip",
      sha256sum = "47ce97a1ddf7e591109de1f60413598432b255c4e5ccfaec9677dcf01dd59202"
    },

    llvmProvider = lib.singleBiMap llvmFull,
    #   pythonProvider = lib.singleBiMap pythonDynamic,

    biDrvs =
      lib.biMap [
        fontconfig,
        freetype,
        zlibNg,
        gperf,
        pixman,
        wayland,
        waylandProtocols,
        libffi,
        libxkbcommon,
        expat,
        linuxHeaders,
        ncurses,
        readline,
        pcre2,
        #pango, #??
        pango_1_56,
        cairo,
        libpng,
        harfbuzzFull,
        glibDynamic,
        muslShared,
        hwdata,
        gobjectDynamic,
        cairoGobject,
        fribidi,
        gdkPixbufFull,
        libjpegTurbo,
        libepoxy,
        atSpi2Core,
        mesa2,
        libelf,
        libdrm,
        libpciaccess,
        llvmConfigStatic,
        spirvTools,
        spirvLlvmTranslator,
        gtk4,
        vala,
        pythonSetuptools,
        libtiff,
        graphene,
        gtkmm4,
        libsigcpp,
        cairomm_1_16,
        pangomm_2_48,
        glibmm_2_82,
        gtk4LayerShell,
        pkgconf,
      ],

    preConfigurePhase = [
      #"sed -i 's@-fno-exceptions@@g' ${SRC}/Makefile",
      "sed -i 's@pkg-config@pkg-config --static@g' ${SRC}/Makefile",
      "sed -i 's@-shared@-static@g' ${SRC}/Makefile",
      "sed -i 's@LDFLAGS += -Wl,-O1,--as-needed,-z,now,-z,pack-relative-relocs@#LDFLAGS += -Wl,-O1,--as-needed,-z,now,-z,pack-relative-relocs@g' ${SRC}/Makefile",
      "sed -i 's@CXXFLAGS += -Os -s -Wall -flto=auto -fno-exceptions -fPIC@#CXXFLAGS += -Os -s -Wall -flto=auto -fno-exceptions -fPIC@g' ${SRC}/Makefile",
      "sed -i 's@libsysboard.so@ libsysboard.a@g' ${SRC}/Makefile",
    ]
  }
}
