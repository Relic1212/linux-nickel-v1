{
  lib,
  drvs,
  stevia | lib.MesonPackage = {
    singleSource = {
      uri = "https://gitlab.gnome.org/World/Phosh/stevia/-/archive/v0.54.0/stevia-v0.54.0.tar.bz2",
      sha256sum = "5261cb56bddd8c33d52f2097bc3588f29744714314331ac5dd962071998a213f",
    },

    buildEnv = {
      EXTRA_LDFLAGS = [
        "-lc++",
      ],
    },

    llvmProvider = drvs.llvmFull,
    biDrvs = [
      drvs.dconf,
      drvs.atSpi2Core,
      drvs.cairo,
      drvs.cairoGobject,
      drvs.eudev,
      drvs.expat,
      drvs.feedbackd,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.gettext,
      # drvs.glibDynamic,
      drvs.glibPatched,
      drvs.gmobile,
      drvs.gnomeDesktop,
      drvs.gobjectDynamic,
      drvs.gperf,
      drvs.graphene,
      drvs.gsettingsDesktopSchemas,
      drvs.gsound,
      drvs.gtk3,
      drvs.gtk4,
      drvs.harfbuzz,
      drvs.harfbuzzFull,
      drvs.hwdata,
      drvs.isoCodes,
      drvs.jsonGlib,
      drvs.kmod,
      drvs.libbsd,
      drvs.libcanberra,
      drvs.libdrm,
      drvs.libelf,
      drvs.libepoxy,
      drvs.libffi,
      drvs.libhandy,
      drvs.libjpegTurbo,
      drvs.libmd,
      drvs.libogg,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libseccomp,
      drvs.libtiff,
      drvs.libvorbis,
      drvs.libxkbcommon,
      drvs.libxml2,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.mesa2,
      drvs.muslShared & { priority = -1 },
      drvs.ncurses,
      drvs.openssl,
      drvs.pango,
      drvs.pcre2,
      drvs.pixman,
      drvs.readline,
      drvs.sharedMimeInfo,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.utilLinux,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.xkeyboardConfig,
      drvs.xz,
      drvs.zlibNg,
      drvs.zstd,
      drvs.hunspell,
    ],
    propagatedBuildInputs = [
      drvs.seatd,
    ],
  }
}
