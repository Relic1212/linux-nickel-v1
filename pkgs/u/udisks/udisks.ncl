{
  lib,
  drvs,
  udisks | lib.AutomakePackage = {
    singleSource = {
      uri = "https://github.com/storaged-project/udisks/archive/refs/tags/udisks-2.11.1.tar.gz",
      sha256sum = "e40ee20e1f24783f30109d7fd20553aeb93c4808ceb67a4c980bf698cfde32d6"
    },
    extraConfigureFlags = [
      "--enable-introspection=no",
      "--disable-nls",
      "--disable-btrfs",
      "--disable-smart",
    ],
    separateBuildDir = false,
    extraMakeArgs = [
      "V=1",
    ],
    preConfigurePhase = [
      m%"for f in $(find ${SRC}/ -type f );do sed -i 's@http://docbook.sourceforge.net/release/xsl/current@/usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2@g' ${f};done"%,
      lib.functions.writeFile "${SRC}/dlopen.c" (import "udisks_dlopen.c" as 'Text),
      "${CC} ${CFLAGS} -c -Werror ${SRC}/dlopen.c -o ${SRC}/dlopen.o",
    ],
    # preBuildPhase =[
    #   m%"for f in $(find . -name Makefile);do sed -i 's|-Wl,--export-dynamic||g' $f;done"%
    # ],
    buildEnv = {
      EXTRA_LDFLAGS = [
        "-lcap",
        "-lblkid",
        # "-ldl_factory",
        # "-lblockdev_dl",
        # "-l:libbd_crypto.a",
        # "-l:libbd_dm.a",
        # "-l:libbd_fs.a",
        # "-l:libbd_loop.a",
        # "-l:libbd_mdraid.a",
        # "-l:libbd_nvme.a",
        # "-l:libbd_part.a",
        # "-l:libbd_smart.a",
        # "-l:libbd_smartmontools.a",
        # "-l:libbd_swap.a",
        # "-l:libbd_utils.a",
        "$(pkg-config --static --libs libkmod glib-2.0 gio-2.0 libudev uuid mount libcryptsetup libnvme fdisk ext2fs e2p bytesize)",
        "-lkeyutils",
        "-lbd_utils",
        "-lbd_mdraid",
        "-lbd_swap",
        "-lbd_loop",
        "-lbd_crypto",
        "-lbd_mdraid",
        "-lbd_part",
        "-lbd_fs",
        "-lbd_nvme",

        # "-l:libblockdev.a",
        # "/usr/lib/libblockdev_symbols.o",
        "/tmp/workdir/src/dlopen.o",
      ],
      # EXTRA_CFLAGS = EXTRA_LDFLAGS
    },
    muslProvider = drvs.muslBothRenamedDl,
    biDrvs = [
      # drvs.libdlFactory,
      # drvs.libblockdevDl,
      drvs.libbytesize,
      drvs.gmp,
      drvs.mpfr,
      # (drvs.muslShared & { priority = -1 }),
      #   drvs.perl,
      drvs.acl,
      drvs.attr,
      drvs.bash,
      drvs.dbus,
      drvs.docbookXml,
      drvs.docbookXslNons,
      drvs.duktape,
      drvs.elogindWithPolkit,
      drvs.eudev,
      drvs.expat,
      drvs.gettext,
      drvs.glibPatched,
      # drvs.gobjectDynamic,
      drvs.gtkDoc,
      drvs.gudev,
      drvs.inih,
      drvs.libatasmart,
      drvs.libblockdev,
      drvs.libcap,
      drvs.libdrm,
      drvs.libevdev,
      drvs.libffi,
      drvs.libinput,
      drvs.libpamFinal,
      drvs.libpciaccess,
      drvs.libxkbcommon,
      drvs.libxslt,
      drvs.linuxHeaders,
      drvs.mtdev,
      drvs.ncurses,
      drvs.pcre2,
      drvs.polkit,
      drvs.scdoc,
      drvs.utilLinux & { priority = 1 },
      drvs.zlibNg,
      drvs.lvm2,
      drvs.e2fsprogs,
      drvs.readline,
      drvs.parted,
      drvs.cryptsetup,
      drvs.popt,
      drvs.jsonC,
      drvs.keyutils,
      drvs.libnvme,
      drvs.pythonFull,
      drvs.xz,
      drvs.openssl,
      drvs.kmod,
      drvs.zstd,
    ],
  }
}
