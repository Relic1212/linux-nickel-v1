{
  lib,
  drvs,
  udisks | lib.AutomakePackage = {
    singleSource = {
      uri = "https://github.com/storaged-project/udisks/archive/refs/tags/udisks-2.10.2.tar.gz",
      sha256sum = "69479fde489f8c5b3908f583f35d38c2273c38572adac3597a8a0ff855b436de"
    },
    extraConfigureFlags = [
      "--enable-introspection=no",
      "--disable-nls",
      "--disable-btrfs",
    ],
    separateBuildDir = false,
    extraMakeArgs = [
      "V=1",
    ],
    preConfigurePhase = [
      m%"for f in $(find ${SRC}/ -type f );do sed -i 's@http://docbook.sourceforge.net/release/xsl/current@/usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2@g' ${f};done"%,
    ],
    # preBuildPhase =[
    #   m%"for f in $(find . -name Makefile);do sed -i 's|-Wl,--export-dynamic||g' $f;done"%
    # ],
    buildEnv = {
      EXTRA_LDFLAGS = [
        "-lcap",
        "-lblkid",
      ],
      EXTRA_CFLAGS = EXTRA_LDFLAGS
    },
    biDrvs = [
      (drvs.muslShared & { priority = -1 }),
      #   drvs.perl,
      drvs.acl,
      drvs.attr,
      drvs.bash,
      drvs.dbus,
      drvs.docbookXml,
      drvs.docbookXslNons,
      drvs.duktape,
      drvs.elogindWithPolkit,
      drvs.eudev,
      drvs.expat,
      drvs.gettext,
      drvs.glib,
      drvs.gobjectDynamic,
      drvs.gtkDoc,
      drvs.gudev,
      drvs.inih,
      drvs.libatasmart,
      drvs.libblockdev,
      drvs.libcap,
      drvs.libdrm,
      drvs.libevdev,
      drvs.libffi,
      drvs.libinput,
      drvs.libpamFinal,
      drvs.libpciaccess,
      drvs.libxkbcommon,
      drvs.libxslt,
      drvs.linuxHeaders,
      drvs.mtdev,
      drvs.ncurses,
      drvs.pcre2,
      drvs.polkit,
      drvs.scdoc,
      drvs.utilLinux & { priority = 1 },
      drvs.zlibNg,
      drvs.lvm2,
      drvs.e2fsprogs,
      drvs.readline,
      drvs.parted,
      drvs.cryptsetup,
      drvs.popt,
      drvs.jsonC,
      drvs.keyutils,
      drvs.libnvme,
      drvs.pythonFull,
      drvs.xz,
      drvs.openssl,
      drvs.kmod,
      drvs.zstd,
    ],
  }
}
