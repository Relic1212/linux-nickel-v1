{
  lib,
  fontconfig,
  freetype,
  zlibNg,
  gperf,
  pixman,
  wayland,
  waylandProtocols,
  libffi,
  libxkbcommon,
  expat,
  linuxHeaders,
  ncurses,
  readline,
  pcre2,
  pango,
  cairo,
  libpng,
  harfbuzz,
  scdoc,
  glib,
  hwdata,

  dmenuWayland | lib.MesonPackage = {
    singleSource = {
      uri = "https://github.com/nyyManni/dmenu-wayland/archive/a380201dff5bfac2dace553d7eaedb6cea6855f9.zip",
      sha256sum = "322825490f933f9b8f18cc450f5559f5a524b8aa66ef9a4cfb10ab7ebe354e9d",
    },
    biDrvs =
      lib.biMap [
        fontconfig,
        freetype,
        zlibNg,
        gperf,
        pixman,
        wayland,
        waylandProtocols,
        libffi,
        libxkbcommon,
        expat,
        linuxHeaders,
        ncurses,
        readline,
        pcre2,
        pango,
        cairo,
        libpng,
        harfbuzz,
        scdoc,
        glib,
        hwdata,
      ],
    postInstallPhase = [
      "cd ${DEST}/usr/bin",
      "ln -s dmenu-wl dmenu",
      "ln -s dmenu-wl_path dmenu_path",
      "ln -s dmenu-wl_run dmenu_run",
    ]
  }
}
