From 513604e0cb15da96e6d3c76b4afc5148b1a8f873 Mon Sep 17 00:00:00 2001
From: "Christian W. Zuckschwerdt" <christian@zuckschwerdt.org>
Date: Wed, 28 May 2025 10:43:23 +0200
Subject: [PATCH] Change from xkbcommon-dl to kbvm

---
 .github/workflows/ci.yml                      |   16 +-
 Cargo.toml                                    |    4 +-
 src/changelog/unreleased.md                   |    2 +
 src/platform_impl/linux/common/xkb/compose.rs |  123 --
 src/platform_impl/linux/common/xkb/keymap.rs  | 1223 ++++++++---------
 src/platform_impl/linux/common/xkb/mod.rs     |  319 ++---
 src/platform_impl/linux/common/xkb/state.rs   |  153 +--
 .../linux/wayland/seat/keyboard/mod.rs        |   11 +-
 .../linux/x11/event_processor.rs              |   71 +-
 src/platform_impl/linux/x11/mod.rs            |    5 +-
 src/platform_impl/windows/dark_mode.rs        |    2 +-
 11 files changed, 774 insertions(+), 1155 deletions(-)
 delete mode 100644 src/platform_impl/linux/common/xkb/compose.rs

diff --git a/Cargo.toml b/Cargo.toml
index d6487655a0..cac7e82f32 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -58,7 +58,7 @@ rustdoc-args = ["--cfg", "docsrs"]
 # Features are documented in either `lib.rs` or under `winit::platform`.
 [features]
 default = ["rwh_06", "x11", "wayland", "wayland-dlopen", "wayland-csd-adwaita"]
-x11 = ["x11-dl", "bytemuck", "percent-encoding", "xkbcommon-dl/x11", "x11rb"]
+x11 = ["x11-dl", "bytemuck", "percent-encoding", "kbvm/x11", "x11rb"]
 wayland = [
     "wayland-client",
     "wayland-backend",
@@ -285,7 +285,7 @@ x11rb = { version = "0.13.0", default-features = false, features = [
     "xinput",
     "xkb",
 ], optional = true }
-xkbcommon-dl = "0.4.2"
+kbvm = { version = "0.1.4", features = ["compose"] }
 
 [target.'cfg(target_os = "redox")'.dependencies]
 orbclient = { version = "0.3.47", default-features = false }
diff --git a/src/changelog/unreleased.md b/src/changelog/unreleased.md
index f3a0f6d2c3..1c793bad08 100644
--- a/src/changelog/unreleased.md
+++ b/src/changelog/unreleased.md
@@ -39,3 +39,5 @@ The migration guide could reference other migration examples in the current
 changelog entry.
 
 ## Unreleased
+
+- On linux, use kbvm instead of xkbcommon.
\ No newline at end of file
