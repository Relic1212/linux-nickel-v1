{
  lib,
  drvs,
  ecm | lib.QtPackage = {
    generator = "Ninja",
    singleSource = {
      uri = "https://invent.kde.org/frameworks/extra-cmake-modules/-/archive/v6.31.0/extra-cmake-modules-v6.31.0.tar.gz",
      sha256sum = "a27ff118cb96af3bacffb289f52e56af3eaa1d73b01f5ca794aa29b760f0204e"
    },
    llvmProvider = drvs.llvmFull,

    pDrvs = [drvs.qtbaseVulkan],
    # biDrvs = [
    #   drvs.pixman,
    #   drvs.expat,
    #   drvs.libffi,
    #   drvs.libevdev,
    #   drvs.mtdev,
    #   drvs.pango,
    #   drvs.cairo,
    #   drvs.libpng,
    #   drvs.freetype,
    #   drvs.fontconfig,
    #   drvs.zlibNg,
    #   drvs.harfbuzz,
    #   drvs.glib,
    #   drvs.hwdata,
    #   drvs.linuxHeaders,
    #   drvs.libjpegTurbo,
    #   drvs.libspng,
    #   drvs.file,
    #   drvs.libwebp,
    #   drvs.qtdeclarative,
    #   drvs.qtbase,
    #   drvs.qtshadertools,
    #   drvs.qtwayland,
    #   drvs.mesa2,
    #   # drvs.pkgconf,
    #   drvs.libelf,
    #   drvs.libdrm,
    #   drvs.pythonMako,
    #   drvs.pythonPackaging,
    #   drvs.pythonMarkupsafe,
    #   drvs.libpciaccess,
    #   drvs.bison,
    #   drvs.flex,
    #   drvs.wayland,
    #   drvs.waylandProtocols,
    #   drvs.m4,
    #   drvs.pyyaml,
    #   drvs.llvmConfigStatic,
    #   drvs.spirvTools,
    #   drvs.spirvLlvmTranslator,
    #   ###
    #   drvs.jsonC,
    #   drvs.pcre2,
    #   drvs.libxkbcommon,
    #   drvs.openssl,
    #   drvs.kmod,
    #   drvs.zstd,
    #   drvs.xz,
    #   drvs.eudev,
    #   drvs.libinput,
    # ],
    buildEnv = {
      EXTRA_LDFLAGS = [
        "$(pkg-config --libs --static gbm glesv2 egl dri wayland-client)",
      ]
    },
    cmakeExtraArgsRecord = {
      "-DBUILD_WITH_QT6" = true,
      "-DCMAKE_MODULE_LINKER_FLAGS:STRING" = "\"-static --static -fuse-ld=lld -stdlib=libc++ -rtlib=compiler-rt -unwindlib=libunwind -lc++ -ldrm $(pkg-config --libs --static dri glesv2 gbm egl wayland-client)\""
    },
  }
}
