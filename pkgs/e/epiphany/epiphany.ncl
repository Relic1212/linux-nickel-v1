{
  lib,
  drvs,
  epiphany | lib.MesonPackage = {
    allowDubplicateBuldInputs = true,

    # debug = true,
    singleSource = {
      uri = "https://download.gnome.org/sources/epiphany/50/epiphany-50.4.tar.xz",
      sha256sum = "1e26f9901f0f08bfe943aa70163c953334c7ec3d4aefc8d354e8a9c140b334a7",
    },

    eofPatches = [
      {
        patch = import "epiphany.patch" as 'Text,
      },
    ],

    buildEnv = {
      EXTRA_LDFLAGS =
        [
          # "-L/usr/lib/webkitgtk-6.0",
          # "-Wl,--allow-multiple-definition",
          # "-Wl,--start-group",
          "-lc++",
          "$(pkg-config --libs --static  icu-uc libjxl gstapp libgcrypt icu-i18n gstreamer-full-1.0 libavif harfbuzz-icu libseccomp libwebp libwebpmux lcms2 libtasn1 gnutls)",
          # "/tmp/workdir/src/skia_debug.o",
          "$(pkg-config --libs --static egl libadwaita-1)",
          "/tmp/workdir/src/dlopen_empty.o",
          "/tmp/workdir/src/constructor.o",
          "/usr/lib/libwebpdemux.a",
          "-lwebkitgtk-missing-symbols",
          "-L/usr/lib/webkitgtk-6.0",
          # "-lANGLE",
          "/usr/lib/webkitgtk-6.0/libGLESv2.a",
          # "-lWTFGTK",
          # "-lbmalloc",
          # # "-lSysProfCapture",
          # "-lWebCore",
          # "-lSkia",
          # "-lxdgmime",
          # "-lPAL",
          # "-lWebKitUIProcess",
        ]
        @ (
          std.array.map
            (fun s => "/usr/lib/webkitgtk-6.0/%{s}")
            [
              # "injected-bundle",
              "libANGLE.a",
              "libGLESv2.a",
              "libJavaScriptCoreJIT.a",
              "libLowLevelInterpreterLib.a",
              "libPAL.a",
              "libSkia.a",
              # "libSysProfCapture.a",
              "libWTFGTK.a",
              "libWebCore.a",
              "libWebCoreDOMAndRendering.a",
              "libWebCoreInspector.a",
              "libWebCoreJSBindings.a",
              "libWebCoreStyle.a",
              "libWebKitGPUProcess.a",
              "libWebKitNetworkProcess.a",
              "libWebKitShared.a",
              "libWebKitUIProcess.a",
              "libWebKitWebProcess.a",
              "libbmalloc.a",
              "libjavascriptcoregtk-6.0.a",
              "libwebkitgtk-6.0.a",
              "libwebkitgtkinjectedbundle.a",
              "libxdgmime.a",
              "injected-bundle/libwebkitgtkinjectedbundle.a"
            ]
        )
        @ [
          "$(pkg-config --libs --static webkitgtk-6.0 sysprof-capture-4)",
          "/usr/lib/gio/modules/libgiognutls-static.a",

          # "-Wl,--end-group",
        ],
    },

    extraMesonArgs = [
      "-Dman-pages=disabled",
      "-Dunit_tests=disabled",
    ],

    preEnvSetupPhase = [
      m%"export PKG_CONFIG_PATH="/usr/lib/pkgconfig:/usr/lib/gstreamer-1.0/pkgconfig""%,
      #  "export PKG_CONFIG_PATH=\"/usr/lib/gstreamer-1.0/pkgconfig:/usr/lib/pkgconfig\"",
    ],
    preConfigurePhase = [
      "sed -i 's|shared_library|library|g' ${SRC}/lib/sync/meson.build",
      "sed -i 's|shared_library|library|g' ${SRC}/lib/meson.build",
      "sed -i 's|shared_library|library|g' ${SRC}/src/meson.build",
      "sed -i 's|shared_library|library|g' ${SRC}/lib/autofill/meson.build",
      "sed -i 's|shared_module|library|g' ${SRC}/embed/web-process-extension/meson.build",
      # lib.functions.writeFile "${SRC}/skia_debug.c" (import "skia_debug.c" as 'Text),
      lib.functions.writeFile "${SRC}/dlopen.c" (import "epiphany_dlopen.c" as 'Text),
      lib.functions.writeFile "${SRC}/dlopen_empty.c" (import "empty_dlopen.c" as 'Text),
      lib.functions.writeFile "${SRC}/constructor.c" (import "epiphany_constructor.c" as 'Text),
      # "${CC} ${CFLAGS} -c ${SRC}/skia_debug.c -o ${SRC}/skia_debug.o",
      "${CC} ${CFLAGS} -c ${SRC}/dlopen.c -o ${SRC}/dlopen.o",
      "${CC} ${CFLAGS} -c ${SRC}/dlopen_empty.c -o ${SRC}/dlopen_empty.o",
      "${CC} ${CFLAGS} $(pkg-config --cflags glib-2.0) -c ${SRC}/constructor.c -o ${SRC}/constructor.o",
      # m%"sed -i "s@dependencies: ephymain_dep\,@dependencies: ephymain_dep\,\nobjects: '/tmp/workdir/src/dlopen.o'" ${SRC}/src/meson.build"%,
    ],

    llvmProvider = drvs.llvmFull,
    pythonProvider = drvs.pythonDynamic,
    # muslProvider = drvs.muslBothWeakDl,
    muslProvider = drvs.muslBothRenamedDl,
    biDrvs = [
      drvs.gettext,
      drvs.itstool,
      drvs.blueprintCompiler22,
      drvs.desktopFileUtils,
      drvs.gtk4IntrospectionDynamic & { priority = 1 },
      drvs.glibGobjectDynamic & { priority = -1 },
      drvs.harfbuzzGobjectDynamic & { priority = 1 },
      drvs.grapheneIntrospection & { priority = 1 },
      drvs.libadwaitaIntrospection & { priority = 1 },
      drvs.gobjectDynamicCairo2 & { priority = 1 },
      drvs.pangoGobject & { priority = 1 },
      drvs.libxml2DynamicCmake & { priority = 1 },
      drvs.gdkPixbufIntrospectionDynamic & { priority = 1 },
      # drvs.muslShared,
      drvs.pythonPygobject,
      # drvs.libepoxyDebug,
      drvs.libelfFixed,
      drvs.libjxlFixed,
      drvs.glibFixed & { priority = 1 },
      drvs.webkitgtkMissingSyms,
    ],
    neverInclude = [
      drvs.harfbuzz,
      # drvs.libepoxy,
      drvs.libelf,
      drvs.libjxl,
      drvs.glib,
    ],
    pDrvs = [
      drvs.webkitgtk,
      drvs.gnomeDesktop4,
      drvs.gcr4,
      # drvs.nettleGmp,
      drvs.jsonGlib,
      drvs.libarchive,
      drvs.libadwaita,
      drvs.libportal,
      drvs.webkitgtkSymlinks,
      # drvs.lcms,
      # drvs.glibNetworking,
    ]
  },
  libjxl,
  libjxlFixed | lib.CmakePackage =
    libjxl
    & {
      postInstallPhase = (
        std.array.map
          (fun s =>
            "llvm-objcopy --redefine-sym=%{s}=libjxl__%{s} ${DEST}/usr/lib/libjxl_cms.a"
          )
          [
            "powf_",
            "skcms_DisableRuntimeCPUDetection",
            "skcms_252_random_bytes",
            "skcms_252_random_bytes",
            "skcms_252_random_bytes",
            "skcms_AdaptToXYZD50",
            "skcms_AdaptToXYZD50",
            "skcms_AdaptToXYZD50",
            "skcms_ApproximateCurve",
            "skcms_ApproximateCurve",
            "skcms_ApproximateCurve",
            "skcms_ApproximatelyEqualProfiles",
            "skcms_ApproximatelyEqualProfiles",
            "skcms_ApproximatelyEqualProfiles",
            "skcms_AreApproximateInverses",
            "skcms_AreApproximateInverses",
            "skcms_AreApproximateInverses",
            "skcms_DisableRuntimeCPUDetection",
            "skcms_DisableRuntimeCPUDetection",
            "skcms_GetCHAD",
            "skcms_GetCHAD",
            "skcms_GetCHAD",
            "skcms_GetInputChannelCount",
            "skcms_GetInputChannelCount",
            "skcms_GetInputChannelCount",
            "skcms_GetTagByIndex",
            "skcms_GetTagByIndex",
            "skcms_GetTagByIndex",
            "skcms_GetTagBySignature",
            "skcms_GetTagBySignature",
            "skcms_GetTagBySignature",
            "skcms_GetWTPT",
            "skcms_GetWTPT",
            "skcms_GetWTPT",
            "skcms_Identity_TransferFunction",
            "skcms_Identity_TransferFunction",
            "skcms_Identity_TransferFunction",
            "skcms_MakeUsableAsDestination",
            "skcms_MakeUsableAsDestination",
            "skcms_MakeUsableAsDestination",
            "skcms_MakeUsableAsDestinationWithSingleCurve",
            "skcms_MakeUsableAsDestinationWithSingleCurve",
            "skcms_MakeUsableAsDestinationWithSingleCurve",
            "skcms_Matrix3x3_concat",
            "skcms_Matrix3x3_concat",
            "skcms_Matrix3x3_concat",
            "skcms_Matrix3x3_invert",
            "skcms_Matrix3x3_invert",
            "skcms_Matrix3x3_invert",
            "skcms_MaxRoundtripError",
            "skcms_MaxRoundtripError",
            "skcms_MaxRoundtripError",
            "skcms_ParseWithA2BPriority",
            "skcms_ParseWithA2BPriority",
            "skcms_ParseWithA2BPriority",
            "skcms_PrimariesToXYZD50",
            "skcms_PrimariesToXYZD50",
            "skcms_PrimariesToXYZD50",
            "skcms_sRGB_Inverse_TransferFunction",
            "skcms_sRGB_Inverse_TransferFunction",
            "skcms_sRGB_Inverse_TransferFunction",
            "skcms_sRGB_profile",
            "skcms_sRGB_profile",
            "skcms_sRGB_TransferFunction",
            "skcms_TransferFunction_eval",
            "skcms_TransferFunction_eval",
            "skcms_TransferFunction_eval",
            "skcms_TransferFunction_getType",
            "skcms_TransferFunction_getType",
            "skcms_TransferFunction_getType",
            "skcms_TransferFunction_invert",
            "skcms_TransferFunction_invert",
            "skcms_TransferFunction_invert",
            "skcms_TransferFunction_isHLGish",
            "skcms_TransferFunction_isHLGish",
            "skcms_TransferFunction_isHLGish",
            "skcms_TransferFunction_isPQish",
            "skcms_TransferFunction_isPQish",
            "skcms_TransferFunction_isPQish",
            "skcms_TransferFunction_isSRGBish",
            "skcms_TransferFunction_isSRGBish",
            "skcms_TransferFunction_isSRGBish",
            "skcms_TransferFunction_makePQish",
            "skcms_TransferFunction_makePQish",
            "skcms_TransferFunction_makePQish",
            "skcms_TransferFunction_makeScaledHLGish",
            "skcms_TransferFunction_makeScaledHLGish",
            "skcms_TransferFunction_makeScaledHLGish",
            "skcms_Transform",
            "skcms_Transform",
            "skcms_Transform",
            "skcms_TRCs_AreApproximateInverse",
            "skcms_TRCs_AreApproximateInverse",
            "skcms_TRCs_AreApproximateInverse",
            "skcms_XYZD50_profile",
          ]
      ),
    },

  webkitgtkSymlinks | lib.Package = {
    installPhase =
      [
        # "install -dm0755 ${DEST}/usr/lib/webkitgtk-6.0",
        # "cd ${DEST}/usr/lib/webkitgtk-6.0",
        "install -dm0755 ${DEST}/usr/lib",
        "cd ${DEST}/usr/lib",
      ]
      @ (
        std.array.map
          (fun s => "ln -s /usr/lib/webkitgtk-6.0/%{s} %{s}"
          )
          [
            "libANGLE.a",
            "libGLESv2.a",
            "libLowLevelInterpreterLib.a",
            "libPAL.a",
            "libSkia.a",
            "libSysProfCapture.a",
            "libWTFGTK.a",
            "libWebCore.a",
            "libWebCoreTestSupport.a",
            "libbmalloc.a",
            "libjavascriptcoregtk-6.0.a",
            "libwebkitgtk-6.0.a",
            "libwebkitgtkinjectedbundle.a",
            "libxdgmime.a",
          ]
      )
  }
}
