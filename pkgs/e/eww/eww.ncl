{
  lib,
  drvs,
  eww | lib.CargoPackage = {
    singleSource = {
      #uri = "https://github.com/elkowar/eww/archive/refs/tags/v0.6.0.tar.gz",
      #sha256sum = "cef361946946c566b79f8ddc6208d1a3f16b4ff9961439a3f86935e1cfa174a1",

      uri = "https://github.com/elkowar/eww/archive/fddb4a09b107237819e661151e007b99b5cab36d.tar.gz",
      sha256sum = "ccba85c51829eeff6da6d147738653b898ec06cb8c739358b3da041b6b3b972e",
    },
    crates = lib.functions.filterCrates (import "eww-crates.json"),
    biDrvs = [
      drvs.fontconfig,
      drvs.freetype,
      drvs.zlibNg,
      drvs.gperf,
      drvs.pixman,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.libffi,
      drvs.libxkbcommonWithRegistry,
      drvs.libxml2,
      drvs.expat,
      drvs.linuxHeaders,
      drvs.ncurses,
      drvs.readline,
      drvs.pcre2,
      drvs.pango,
      drvs.cairo,
      drvs.libpng,
      drvs.harfbuzz,
      drvs.glibDynamic,
      drvs.hwdata,
      drvs.gobjectDynamic,
      drvs.cairoGobject,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.libjpegTurbo,
      drvs.libepoxy,
      drvs.atSpi2Core,
      drvs.mesa2,
      drvs.libelf,
      drvs.libdrm,
      drvs.libpciaccess,
      drvs.llvmConfigStatic,
      drvs.spirvTools,
      drvs.spirvLlvmTranslator,
      drvs.gtk3,
      drvs.libsigcpp2,
      drvs.cairomm_1_0,
      drvs.pangomm,
      drvs.glibmm,
      drvs.pythonSetuptools,
      drvs.gtkmm3,
      drvs.fmt,
      drvs.spdlog,
      drvs.libevdev,
      drvs.jsoncpp,
      drvs.scdoc,
      drvs.gtkLayerShell,
      drvs.libinputFixedSyms,
      drvs.epollShim,
      drvs.mtdev,
      drvs.eudev,
      drvs.sndiod,
      drvs.upower,
      drvs.dbusmenuGtk,
    ],

    extraCargoFlags = [
      "--no-default-features",
      "--features=wayland",
    ],
    extraEnv = {
      EXTRA_RUSTFLAGS = [
        "-l expat",
        "-l epoxy",
        "-l fribidi",
        "-l wayland-cursor",
        "-l xkbcommon",
        "-l wayland-egl",
        "-C target-feature=+crt-static",
        "-C link-arg=-static",
        "-C link-arg=-l:libunwind.a",
      ]
    }
  }
}
