{
  lib,
  drvs,
  qca | lib.CmakePackage = {
    generator = "Ninja",
    singleSource = {
      uri = "https://download.kde.org/stable/qca/2.3.10/qca-2.3.10.tar.xz",
      sha256sum = "1c5b722da93d559365719226bb121c726ec3c0dc4c67dea34f1e50e4e0d14a02"
    },

    cmakeExtraArgsRecord = {
      "-DBUILD_WITH_QT6" = true,
      "-DBUILD_TESTS" = false,
      "-DBUILD_TOOLS" = false,
      # "-DBUILD_PLUGINS" = "none",
      # "-DBUILD_PLUGINS" = "all",
      "-DSTATIC_PLUGINS" = true,
    },

    postInstallPhase = [
      "sed -i 's@6 EQUAL 6 AND NOT @true@' ${DEST}/usr/lib/cmake/Qca-qt6/Qca-qt6Config.cmake"
    ],

    biDrvs = [
      drvs.pixman,
      drvs.expat,
      drvs.libffi,
      drvs.libevdev,
      drvs.mtdev,
      drvs.pango,
      drvs.cairo,
      drvs.libpng,
      drvs.freetype,
      drvs.fontconfig,
      drvs.zlibNg,
      # drvs.harfbuzz,
      drvs.glib,
      drvs.hwdata,
      drvs.linuxHeaders,
      drvs.libjpegTurboStatic,
      drvs.libspng,
      drvs.file,
      drvs.libwebp,
      drvs.dbusForQt,
      drvs.qtdeclarative,
      drvs.qtbase,
      drvs.qtshadertools,
      drvs.qtwayland,
      drvs.qt5compat,
      drvs.qtTools,
      drvs.qtsensors,
      drvs.qtsvg,
      drvs.mesa2,
      # drvs.pkgconf,
      drvs.libelf,
      drvs.libdrm,
      drvs.pythonMako,
      drvs.pythonPackaging,
      drvs.pythonMarkupsafe,
      drvs.libpciaccess,
      drvs.bison,
      drvs.flex,
      drvs.harfbuzzFull,
      drvs.gpgme,
      drvs.libassuan,
      drvs.libgpgError,
      drvs.libgcrypt,
      drvs.openssl,
    ],
  }
}
