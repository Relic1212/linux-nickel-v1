{
  lib,
  drvs,
  qemu | lib.AutotoolsPackage = {
    singleSource = {
      uri = "https://download.qemu.org/qemu-10.1.0.tar.xz",
      sha256sum = "e0517349b50ca73ebec2fa85b06050d5c463ca65c738833bd8fc1f15f180be51",
    },

    llvmProvider = drvs.llvmFull,

    configureFlags = [
      "--prefix=/usr",
      "--static",
      "--target-list=x86_64-softmmu",
      "--enable-slirp",
      "--enable-opengl",
      "--enable-virglrenderer",
    ],

    buildEnv.EXTRA_LDFLAGS = ["-lc++"],

    biDrvs =
      [
        drvs.pkgconf,
        drvs.samurai,
        drvs.pythonDynamic,
      ]
      @ [
        drvs.bash,
        (drvs.muslShared & { priority = -1 }),
        drvs.libslirp,
        drvs.appstream,
        drvs.atSpi2Core,
        drvs.cairo,
        drvs.cairoGobject,
        drvs.curl,
        drvs.eudev,
        drvs.expat,
        drvs.fastFloat,
        drvs.feedbackd,
        drvs.fontconfig,
        drvs.freetype,
        drvs.fribidi,
        drvs.gdkPixbufFull,
        drvs.gettext,
        drvs.glib,
        drvs.gnomeDesktop,
        drvs.gperf,
        drvs.graphene,
        drvs.gsettingsDesktopSchemas,
        drvs.gsound,
        drvs.gtk3,
        drvs.gtk4,
        drvs.gudev,
        drvs.harfbuzzFull,
        drvs.hwdata,
        drvs.isoCodes,
        drvs.jansson,
        drvs.jsonGlib,
        drvs.kmod,
        drvs.libbsd,
        drvs.libcanberra,
        drvs.libcap,
        drvs.libdrm,
        drvs.libelf,
        drvs.libepoxy,
        drvs.libfdt,
        drvs.libffi,
        drvs.libgtop,
        drvs.libjpegTurbo,
        drvs.libmd,
        drvs.libogg,
        drvs.libpciaccess,
        drvs.libpng,
        drvs.libportal,
        drvs.libpsl,
        drvs.libseccomp,
        drvs.libtiff,
        drvs.libtool,
        drvs.libusb,
        drvs.libvorbis,
        drvs.libxkbcommon,
        drvs.libxml2,
        drvs.libxmlb,
        drvs.libyaml,
        drvs.linuxHeaders,
        drvs.llvmConfigStatic,
        drvs.lz4,
        drvs.mesa2,
        drvs.ncurses,
        drvs.openssl,
        drvs.pango,
        drvs.pcre2,
        drvs.pixman,
        drvs.readline,
        drvs.sassc,
        drvs.spirvLlvmTranslator,
        drvs.spirvTools,
        drvs.utilLinux,
        drvs.vala,
        drvs.vte,
        drvs.virglrenderer,
        drvs.wayland,
        drvs.waylandProtocols,
        drvs.xkeyboardConfig,
        drvs.xz,
        drvs.zlibNg,
        drvs.zstd,
      ],
  }
}
