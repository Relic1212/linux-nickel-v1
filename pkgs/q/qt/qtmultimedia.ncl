{
  lib,
  drvs,
  qtmultimedia | lib.QtPackage = {
    generator = "Ninja",
    singleSource = {

      uri = "https://download.qt.io/archive/qt/6.9/6.9.1/submodules/qtmultimedia-everywhere-src-6.9.1.tar.xz",
      sha256sum = "955e36459518ee55f8e2bb79defc6e44aa94dc1edf5ac58a22d7734b2e07391d"
    },
    llvmProvider = drvs.llvmFull,

    biDrvs = [
      drvs.alsaLibs,
      drvs.atSpi2Core,
      drvs.bison,
      drvs.bluez,
      drvs.cairo,
      drvs.cairoGobject,
      drvs.dbus,
      drvs.dbusForQt,
      drvs.elogindWithPolkit,
      drvs.eudev,
      drvs.expat,
      drvs.fdkAac,
      drvs.ffmpeg,
      drvs.flex,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.git,
      # drvs.glib,
      drvs.glibDynamic,
      drvs.gobjectDynamic,
      drvs.gperf,
      drvs.gtk3,
      # drvs.harfbuzz,
      drvs.harfbuzzFull,
      drvs.hwdata,
      drvs.jansson,
      drvs.jsonC,
      drvs.kmod,
      drvs.ldacbt,
      drvs.libcap,
      drvs.libdrm,
      drvs.libelf,
      drvs.libepoxy,
      drvs.libevdev,
      drvs.libffi,
      drvs.libinput,
      drvs.libjpegTurbo,
      drvs.libopus,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libsndfile,
      drvs.libusb,
      drvs.libxkbcommon,
      drvs.libyaml,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.lua,
      drvs.m4,
      drvs.mesa2,
      drvs.muslShared,
      drvs.ncurses,
      drvs.openssl,
      drvs.pango,
      drvs.pcre2,
      drvs.perl,
      drvs.pipewire,
      drvs.pixman,

      # drvs.pythonMako,
      # drvs.pythonMarkupsafe,
      # drvs.pythonPackaging,
      drvs.pyyaml,
      drvs.pulseaudio17,
      drvs.qtbase,
      drvs.qtdeclarative,
      drvs.qtpositioning,
      drvs.qtshadertools,
      drvs.qtsvg,
      drvs.qtwayland,
      drvs.readline,
      drvs.sbc,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.utilLinux,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.xz,
      drvs.zlibNg,
      drvs.zstd,
    ],

    buildEnv = {
      EXTRA_LDFLAGS = [
        "$(pkg-config --libs --static gbm glesv2 egl dri wayland-client glib-2.0 gmodule-2.0 expat)",
      ]
    },
    postInstallPhase =
      std.array.map
        (fun s => "llvm-objcopy --redefine-sym %{s}=qt6multimedia_private__%{s} ${DEST}/usr/lib/libQt6Multimedia.a")
        [
          "pw_check_library_version",
          "pw_deinit",
          "pw_get_library_version",
          "pw_init",
          "pw_properties_free",
          "pw_properties_new_dict",
          "pw_proxy_destroy",
          "pw_stream_add_listener",
          "pw_stream_connect",
          "pw_stream_dequeue_buffer",
          "pw_stream_destroy",
          "pw_stream_disconnect",
          "pw_stream_new",
          "pw_stream_queue_buffer",
          "pw_thread_loop_destroy",
          "pw_thread_loop_get_loop",
          "pw_thread_loop_lock",
          "pw_thread_loop_new",
          "pw_thread_loop_start",
          "pw_thread_loop_stop",
          "pw_context_connect_fd",
          "pw_context_destroy",
          "pw_context_new",
          "pw_core_disconnect",
          "pw_thread_loop_signal",
          "pw_thread_loop_timed_wait",
          "pw_thread_loop_unlock",
        ],
    # cmakeExtraArgsRecord = {
    #   "-DQT_DEBUG_FIND_PACKAGE" = "ON",
    #   # "-DCMAKE_MODULE_LINKER_FLAGS:STRING" = "\"-static --static -fuse-ld=lld -stdlib=libc++ -rtlib=compiler-rt -unwindlib=libunwind -lc++ -lglapi -ldrm $(pkg-config --libs --static dri glesv2 gbm egl)\""
    #   "-DCMAKE_MODULE_LINKER_FLAGS:STRING" | priority 1 = "\"-static --static -fuse-ld=lld -stdlib=libc++ -rtlib=compiler-rt -unwindlib=libunwind -lc++ -lglapi -ldrm $(pkg-config --libs --static dri glesv2 gbm egl wayland-client glib-2.0 gmodule-2.0 expat)\"",
    # },
  }
}
