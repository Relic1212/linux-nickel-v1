{
  lib,
  dbus,
  alsaLibs,
  fontconfig,
  freetype,
  zlibNg,
  gperf,
  pixman,
  wayland,
  waylandProtocols,
  libffi,
  libxkbcommon,
  expat,
  linuxHeaders,
  ncurses,
  readline,
  pcre2,
  pango,
  cairo,
  libpng,
  harfbuzz,
  glibDynamic,
  muslShared,
  hwdata,
  gobjectDynamic,
  cairoGobject,
  fribidi,
  gdkPixbufFull,
  libjpegTurbo,
  libepoxy,
  atSpi2Core,
  mesa2,
  libelf,
  libdrm,
  libpciaccess,
  llvmConfigStatic,
  spirvTools,
  spirvLlvmTranslator,
  gtk3,
  eudev,
  kmod,
  xz,
  openssl,
  zstd,
  utilLinux,
  libevdev,
  libsndfile,
  findutils,

  _pipewire | lib.MesonPackage = {
    singleSource = {
      uri = "https://gitlab.freedesktop.org/pipewire/pipewire/-/archive/1.3.83/pipewire-1.3.83.tar.gz",
      sha256sum = "fb9ffee4c8cece297dd44cb83bc070d9fdf0d264a08858b21b401e17683ca790"
    },
    patches = [
      {
        sha256sum = "86cb1b6ff59ed947f8c2ad01b9c473e0a97946d6dde20b62dedf4f79385ff654",
        file = "pipewire.patch"
      }
    ],
    biDrvs =
      lib.biMap [
        dbus,
        alsaLibs,
        fontconfig,
        freetype,
        zlibNg,
        gperf,
        pixman,
        wayland,
        waylandProtocols,
        libffi,
        libxkbcommon,
        expat,
        linuxHeaders,
        ncurses,
        readline,
        pcre2,
        pango,
        cairo,
        libpng,
        harfbuzz,
        glibDynamic,
        muslShared,
        hwdata,
        gobjectDynamic,
        cairoGobject,
        fribidi,
        gdkPixbufFull,
        libjpegTurbo,
        libepoxy,
        atSpi2Core,
        mesa2,
        libelf,
        libdrm,
        libpciaccess,
        llvmConfigStatic,
        spirvTools,
        spirvLlvmTranslator,
        gtk3,
        eudev,
        kmod,
        xz,
        openssl,
        zstd,
        utilLinux,
        libevdev,
        (findutils & { priority = 1 }),
        libsndfile,
      ],
    extraMesonArgs = [
      "-Dsession-managers=[]",
      "-Dvideotestsrc=disabled",
      "-Dvideoconvert=disabled",
      "-Dv4l2=disabled",
      "-Dsupport=enabled",
      "-Dspa-plugins=enabled",
      "-Dtests=disabled",
      "-Davb=disabled",
      "-Draop=disabled",
      "-Dsndfile=enabled",
    ],
    preConfigurePhase = [
      m%"
            for f in $(find "${SRC}" -name meson.build); do
                sed -i 's@shared_library@library@g' "${f}"
            done
            "%,

      # "sed -i 's@, plugin_dependencies@@g' ${SRC}/src/modules/meson.build",
    ]
  },
  pipewire | lib.MesonPackage =
    _pipewire
    & {
      mesonArgs | force = lib.functions.replaceArrayElem "--buildtype=release" "--buildtype=debug" _pipewire.mesonArgs
    }
}
