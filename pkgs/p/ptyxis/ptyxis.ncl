{
  lib,
  drvs,
  ptyxis | lib.MesonPackage = {
    singleSource = {
      # uri = "https://gitlab.gnome.org/chergert/ptyxis/-/archive/48.5/ptyxis-48.5.tar.gz",
      # sha256sum = "59346391e52f6f9d55f37bdb903b450053c2c67b06f77215092d3742bd715ff7",

      # uri = "https://gitlab.gnome.org/chergert/ptyxis/-/archive/49.2/ptyxis-49.2.tar.bz2",
      # sha256sum = "ee2985a293ff7699d6b627ec6d5f2989a135c4e90cee34566e07c9199d9098b7".
      uri = "https://gitlab.gnome.org/chergert/ptyxis/-/archive/50.1/ptyxis-50.1.tar.bz2",
      sha256sum = "d8e6e7518b270c09a912a38a7053c92b55cdd6081a5c573af0d3d7c05b258c24",
    },

    # extraFiles = [
    #   {
    #     file = "ptyxis_symbols.c",
    #     sha256sum = "78302c16ed72566747e5c3afb8f049f4a2deaba1c34848eada6819da5e7e3e22"
    #   },
    # ],

    buildEnv = {
      EXTRA_LDFLAGS = [
        # "-ldl_factory",
        "$(pkg-config --static --libs egl)",
        # "/tmp/workdir/src/symbols.o",
      ],
    },
    extraMesonArgs = [
      "-Dgeneric=terminal",
      # m%"-Dc_link_args="-lc++ -static --static -ldl_factory $(pkg-config --libs --static gtk4) /tmp/workdir/src/symbols.o""%,
      m%"-Dc_link_args="-lc++ -static --static $(pkg-config --static --libs egl)""%,
    ],

    preConfigurePhase = [
      m%"sed -i "s@target_machine.cpu_family() == 'x86_64'@false@g" ${SRC}/agent/meson.build"%,
      m%"sed -i "s@release_link_args = \[\]@release_link_args = \['-static', '--static', \]@g" ${SRC}/meson.build"%,
      m%"
      sed -i 's@ W_EXITCODE (exit_status, term_sig)@((exit_status) << 8 | (term_sig))@g' ${SRC}/src/ptyxis-application.c
      "%,
      "echo '%{import "ptyxis_dlopen.c" as 'Text}' > ${SRC}/ptyxis_symbols.c",
      "echo '%{import "constructor.c" as 'Text}' >> ${SRC}/ptyxis_symbols.c",
      "${CC} ${CFLAGS} -c ${SRC}/ptyxis_symbols.c -o ${SRC}/symbols.o",
      m%"sed -i "s@c_args: ptyxis_c_args,@c_args: ptyxis_c_args,\n  link_args: '/tmp/workdir/src/symbols.o', @g" ${SRC}/src/meson.build"%,
    ],
    # buildPhase = [
    #         "echo 'ENTERING BUILD PHASE'",
    #         "meson compile 2>&1 >build_log_piped.txt",
    #         "echo 'FINISHED BUILD PHASE'",

    # ]

    llvmProvider = drvs.llvmFull,
    pythonProvider = drvs.pythonDynamic,
    muslProvider = drvs.muslBothWeakDl,
    biDrvs = [
      # drvs.libdlFactoryBig,

      #drvs.harfbuzz,
      drvs.atSpi2Core,
      drvs.cairo,
      drvs.cairoGobject,
      drvs.eudev,
      drvs.expat,
      drvs.feedbackd,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.gettext,
      drvs.glibPatched,
      drvs.gmobile,
      drvs.gnomeDesktop,
      drvs.gobjectDynamic,
      drvs.gperf,
      drvs.graphene,
      drvs.gsettingsDesktopSchemas,
      drvs.gsound,
      drvs.gtk4,
      # drvs.librsvg,
      drvs.gudev,
      drvs.harfbuzzFull,
      drvs.hwdata,
      drvs.isoCodes,
      drvs.jsonGlib,
      drvs.kmod,
      drvs.libbsd,
      drvs.libcanberra,
      drvs.libdrm,
      drvs.libelf,
      drvs.libepoxy,
      drvs.libffi,
      drvs.libgtop,
      drvs.libjpegTurbo,
      drvs.libmd,
      drvs.libogg,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libportal,
      drvs.libpsl,
      drvs.libseccomp,
      drvs.libtiff,
      drvs.libtool,
      drvs.libvorbis,
      drvs.libxkbcommon,
      drvs.libxml2,
      drvs.libxmlb,
      drvs.libyaml,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.mesa2,
      drvs.ncurses,
      drvs.openssl,
      drvs.pango,
      drvs.pcre2,
      drvs.pixman,
      drvs.readline,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.utilLinux,
      drvs.vala,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.xkeyboardConfig,
      drvs.xz,
      drvs.zlibNg,
      drvs.zstd,
      drvs.libadwaita,
      drvs.curl,
      drvs.appstream,
      drvs.vte,
      drvs.lz4,
      drvs.desktopFileUtils,
      drvs.fmt,
      drvs.simdutf,
      drvs.gmp,
      drvs.libtasn1,
      drvs.nettleGmp,
      drvs.gnutls,
    ],
  }
}
& {
  lib,
  drvs,
  libgtop | lib.AutotoolsPackage = {
    singleSource = {
      uri = "https://download.gnome.org/sources/libgtop/2.41/libgtop-2.41.3.tar.xz",
      sha256sum = "775676df958e2ea2452f7568f28b2ea581063d312773dd5c0b7624c1b9b2da8c"
    },
    biDrvs = [
      drvs.pcre2,
      drvs.libffi,
      drvs.zlibNg,
      drvs.glib,
      drvs.gettext,
      drvs.linuxHeaders,
      drvs.perl,
      drvs.bison,
      drvs.flex,
      drvs.m4,
      drvs.pkgconf,
    ],

    extraConfigureFlags = [
      "--disable-introspection",
      "--without-x",
      "--without-examples",
      "--disable-nls",
      "--disable-gtk-doc",
      # "--docdir=no",
    ],
    # preConfigurePhase = [
    # "sed -i 's@ docs@@g' Makefile.in",
    #"sed -i 's@ doc@@g' ${SRC}/Makefile.am",
    #"sed -i 's@doc/Makefile\n@@g' ${SRC}/configure.ac",
    #"sed -i 's@doc/reference/Makefile\n@@g' ${SRC}/configure.ac",
    #"sed -i 's@doc/reference/version.xml\n@@g' ${SRC}/configure.ac",
    #"rm -rf ${SRC}/doc",
    # ],
  }
}
& {
  lib,
  drvs,
  libportal | lib.MesonPackage = {
    singleSource = {
      uri = "https://github.com/flatpak/libportal/releases/download/0.9.1/libportal-0.9.1.tar.xz",
      sha256sum = "de801ee349ed3c255a9af3c01b1a401fab5b3fc1c35eb2fd7dfb35d4b8194d7f"
    },

    llvmProvider = drvs.llvmFull,

    biDrvs = [
      drvs.fontconfig,
      drvs.freetype,
      drvs.zlibNg,
      drvs.gperf,
      drvs.pixman,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.libffi,
      drvs.libxkbcommon,
      drvs.expat,
      drvs.linuxHeaders,
      drvs.ncurses,
      drvs.readline,
      drvs.pcre2,
      # drvs.pango,
      drvs.cairo,
      drvs.libpng,
      drvs.glibDynamic,
      drvs.muslShared,
      drvs.hwdata,
      drvs.gobjectDynamic,
      drvs.cairoGobject,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.libjpegTurbo,
      drvs.libepoxy,
      drvs.atSpi2Core,
      drvs.mesa2,
      drvs.libelf,
      drvs.libdrm,
      drvs.libpciaccess,
      drvs.llvmConfigStatic,
      drvs.spirvTools,
      drvs.spirvLlvmTranslator,
      drvs.libtiff,
      drvs.graphene,
      drvs.harfbuzzFull,
      drvs.gtk4,
      drvs.pango,
    ],
    extraMesonArgs = [
      "-Dintrospection=false",
      "-Dvapi=false",
      "-Ddocs=false",
      "-Dtests=false",
      "-Dbackend-gtk4=enabled",
    ]
  }
}
