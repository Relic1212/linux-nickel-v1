{
  lib,
  drvs,
  pavucontrol | lib.MesonPackage = {
    singleSource = {
      uri = "http://freedesktop.org/software/pulseaudio/pavucontrol/pavucontrol-6.2.tar.xz",
      sha256sum = "e93a7836c7307dcbc989e95fc7ec0878322514c475fabd90e89ed52fd4f15d32"
    },

    buildEnv = {
      EXTRA_LDFLAGS = [
        "-ldbus-1",
        "${SRC}/dlopen.o",
      ],
    },
    preConfigurePhase = [
      "echo '%{import "dlopen.c" as 'Text}' > ${SRC}/dlopen.c",
      "${CC} ${CFLAGS} -c ${SRC}/dlopen.c -o ${SRC}/dlopen.o",
    ],

    llvmProvider = drvs.llvmFull,
    muslProvider = drvs.muslBothRenamedDl,
    # pythonProvider = drvs.pythonDynamic,

    biDrvs = [
      drvs.alsaLibs,
      drvs.atSpi2Core,
      drvs.bluez,
      drvs.cairo,
      drvs.cairoGobject,
      drvs.cairomm_1_16,
      drvs.check,
      drvs.dbus,
      drvs.eudev,
      drvs.expat,
      drvs.ffmpeg,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.gettext,
      drvs.glibPatched,
      # drvs.glibDynamic,
      drvs.glibmm_2_82,
      drvs.gobjectDynamic,
      drvs.gperf,
      drvs.graphene,
      drvs.graphviz,
      drvs.gtk4,
      drvs.gtkmm4,
      # drvs.harfbuzz,
      drvs.harfbuzzFull,
      drvs.hwdata,
      drvs.kmod,
      drvs.libcap,
      drvs.libdrm,
      drvs.libelf,
      drvs.libepoxy,
      drvs.libffi,
      drvs.libjpegTurbo,
      drvs.libogg,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libsigcpp,
      drvs.libsndfile,
      drvs.libtiff,
      drvs.libtool,
      drvs.libvorbis,
      drvs.libxkbcommon,
      drvs.libxslt,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.m4,
      drvs.mesa2,
      # drvs.muslShared,
      drvs.ncurses,
      drvs.openssl,
      drvs.pango,
      drvs.pangomm_2_48,
      drvs.pcre2,
      # drvs.perlDynamic,
      # drvs.perlXmlParserDynamic,
      drvs.pixman,
      drvs.pkgconf,
      drvs.readline,
      drvs.sbc,
      drvs.speex,
      drvs.speexdsp,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.utilLinux,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.xz,
      drvs.zlibNg,
      drvs.zstd,
      drvs.libcanberra,
      drvs.pulseaudio17,
      drvs.jsonGlib,
    ],
  }
}
