{
  lib,
  drvs,
  kitty | lib.MakePackage = {
    # https://github.com/gentoo/gentoo/blob/master/x11-terms/kitty/kitty-0.42.2-r1.ebuild
    singleSource = {
      uri = "https://github.com/kovidgoyal/kitty/archive/refs/tags/v0.42.2.tar.gz",
      sha256sum = "6d16d4832e63f03ff2afca31681433f779ed148b4c6a8f09da3a09c97b0e0017"
    },

    sourceInputs = [
      { src = singleSource },
      {
        src = {
          uri = "https://dev.gentoo.org/~ionen/distfiles/kitty-0.42.2-vendor.tar.xz",
          sha256sum = "4b14b91410c5e4c5c8f42bd308d346f30481b8a485bb66c13b67a09eb693484c"
        },
        dest = "vendor-new",
      }
    ],
    llvmProvider = drvs.llvmFull,
    biDrvs = [
      drvs.expat,
      drvs.jsonC,
      drvs.pcre2,
      drvs.mesa2,
      drvs.spirvTools,
      drvs.wayland,
      #drvs.waylandProtocols_1_41,
      drvs.waylandProtocols,
      drvs.libelf,
      drvs.libpciaccess,
      drvs.libdrm,
      drvs.libxkbcommon,
      drvs.pixman,
      drvs.eudev,
      drvs.seatd,
      drvs.libdisplayinfo,
      drvs.libinput,
      drvs.libffi,
      drvs.libevdev,
      drvs.mtdev,
      drvs.pango,
      drvs.cairo,
      drvs.libpng,
      drvs.freetype,
      drvs.fontconfig,
      drvs.zlibNg,
      drvs.harfbuzz,
      drvs.glib,
      drvs.hwdata,
      drvs.linuxHeaders,
      drvs.gdkPixbufFull,
      drvs.libjpegTurbo,
      drvs.basu,
      drvs.lcms,
      drvs.scdoc,
      drvs.libxcursor,
      drvs.xorgMacros,
      drvs.xorgproto,
      drvs.xtrans,
      drvs.libxcb,
      drvs.xcbProto,
      drvs.libxau,
      drvs.libx11,
      drvs.libxrender,
      drvs.libxfixes,
      drvs.xcbRenderutil,
      drvs.libxfont2,
      drvs.libfontenc,
      drvs.libxcvt,
      drvs.libxshmfence,
      drvs.xwayland,
      drvs.libxkbfile,
      drvs.openssl,
      drvs.xcbUtilWm,
      drvs.go_1_24,
      drvs.findutils,
      drvs.pythonDynamicPic,
      drvs.muslShared,
      # drvs.pythonFull,
      drvs.pythonSetuptools,
      drvs.vala,
      drvs.libtool,
      drvs.gettext,
      drvs.pkgconf,
      drvs.libogg,
      drvs.libvorbis,
      drvs.libcanberra,
      drvs.xcbUtilErrors,
      drvs.libxext,
      drvs.libxf86vm,
      drvs.libxrandr,
      drvs.xxhash,
      drvs.dbus,
      drvs.ncurses,
      drvs.symbolsNerdFont,
      drvs.simde,
      drvs.mpdecimal,
    ],

    separateBuildDir = false,
    configurePhase = [
      "export GOROOT=/usr/lib/go",
      "export GOMODCACHE=${SRC}/go-mod",
      "export CGO_ENABLED=1",
      "mkdir /tmp/home",
      "export HOME=/tmp/home",
      "rm -rf vendor",
      "mv vendor-new/vendor vendor",
      m%"sed -i "s@pkg_config('gl'@pkg_config('egl'@g" ${SRC}/setup.py"%,
      m%"sed -i "s@'x11 wayland'@'wayland'@g" ${SRC}/setup.py"%,
      m%"sed -i "s@ldflags.append('-shared')@@g" ${SRC}/setup.py"%,
      m%"sed -i "s@LINKFORSHARED@STUPID_PLACEHOLDER_FOR_LINKFORSHARED_random@g" ${SRC}/setup.py"%,
      m%"sed -i 's@for kitten, sources, all_headers, dest, includes, libraries in @return\n    for kitten, sources, all_headers, dest, includes, libraries in @g' ${SRC}/setup.py"%,
      m%"sed -i "s@ans.cflags.append('-fPIC')@@g" ${SRC}/glfw/glfw.py"%,
    ],

    buildPhase = [
      # "python setup.py linux-package",
      #"python setup.py build-static-binaries",
      #"python setup.py build-launcher",
      "python setup.py linux-package --skip-building-kitten --ignore-compiler-warnings",
    ],
    installPhase = [],
  }
}
