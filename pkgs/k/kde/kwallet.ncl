{
  lib,
  drvs,
  kwallet | lib.CmakePackage = {
    generator = "Ninja",
    singleSource = {
      uri = "https://invent.kde.org/frameworks/kwallet/-/archive/v6.11.0/kwallet-v6.11.0.tar.gz",
      sha256sum = "4b3ff3b81b0a61fd74bac5de48240d93453ab9e82517dc2b115cd8582f21b3c4"
    },
    llvmProvider = drvs.llvmFull,

    biDrvs = [
      drvs.pixman,
      drvs.expat,
      drvs.libffi,
      drvs.libevdev,
      drvs.mtdev,
      drvs.pango,
      drvs.cairo,
      drvs.libpng,
      drvs.freetype,
      drvs.fontconfig,
      drvs.zlibNg,
      drvs.harfbuzz,
      drvs.glib,
      drvs.hwdata,
      drvs.linuxHeaders,
      drvs.libjpegTurboStatic,
      drvs.libspng,
      drvs.file,
      drvs.libwebp,
      drvs.dbusForQt,
      drvs.qtdeclarative,
      drvs.qtbase,
      drvs.qtshadertools,
      drvs.qtwayland,
      drvs.mesa2,
      # drvs.pkgconf,
      drvs.libelf,
      drvs.libdrm,
      drvs.pythonMako,
      drvs.pythonPackaging,
      drvs.pythonMarkupsafe,
      drvs.libpciaccess,
      drvs.bison,
      drvs.flex,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.m4,
      drvs.pyyaml,
      drvs.llvmConfigStatic,
      drvs.spirvTools,
      drvs.spirvLlvmTranslator,
      ###
      drvs.jsonC,
      drvs.pcre2,
      drvs.libxkbcommon,
      drvs.openssl,
      drvs.kmod,
      drvs.zstd,
      drvs.xz,
      drvs.eudev,
      drvs.libinput,
      drvs.ecm,
      drvs.kcoreaddons,
      drvs.kcodecs,
      drvs.kconfig,
      drvs.kguiaddons,
      drvs.ki18n,
      drvs.gettext,
      drvs.karchive,
      drvs.bzip2,
      drvs.kservice,
      drvs.kwidgetsaddons,
      drvs.kcolorscheme,
      drvs.kconfigwidgets,
      drvs.ksolid,
      drvs.utilLinuxWeak,
      drvs.kcrash,
      drvs.kbookmarks,
      drvs.kcompletion,
      drvs.kiconthemes,
      drvs.breezeIcons,
      drvs.kitemviews,
      drvs.kjobwidgets,
      drvs.knotifications,
      drvs.vala,
      drvs.libtool,
      drvs.libogg,
      drvs.libvorbis,
      drvs.libcanberra,
      drvs.kwindowsystem,
      drvs.kauth,
      drvs.kdbusaddons,
      drvs.kded,
    ],
    buildEnv = {
      EXTRA_LDFLAGS = [
        "$(pkg-config --libs --static gbm glesv2 egl dri wayland-client)",
      ]
    },
    cmakeExtraArgsRecord = {
      # "-DECM_DIR"="/usr/usr/share/ECM/",
      "-DCMAKE_MODULE_LINKER_FLAGS:STRING" = "\"-static --static -fuse-ld=lld -stdlib=libc++ -rtlib=compiler-rt -unwindlib=libunwind -lc++ -lglapi -ldrm $(pkg-config --libs --static dri glesv2 gbm egl wayland-client)\""
    },
  }
}
