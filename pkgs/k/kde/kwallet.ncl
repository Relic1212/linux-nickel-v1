{
  lib,
  drvs,
  kwallet | lib.CmakePackage = {
    generator = "Ninja",
    singleSource = {
      uri = "https://invent.kde.org/frameworks/kwallet/-/archive/v6.25.0/kwallet-v6.25.0.tar.gz",
      sha256sum = "888460985802d53a8ed2d6aa928bc00077a53250907b8c910f6ca9fa0ce89cb5"
    },
    llvmProvider = drvs.llvmFull,

    preConfigurePhase = [
      "sed -i 's@KF6WalletBackend SHARED@KF6WalletBackend STATIC@g' ${SRC}/src/runtime/kwalletbackend/CMakeLists.txt"
    ],

    biDrvs = [

      ###
      #drvs.harfbuzz,
      #drvs.pkgconf,
      drvs.alsaLibs,
      drvs.bison,
      drvs.breezeIcons,
      drvs.bzip2,
      drvs.cairo,
      drvs.dbusForQt,
      drvs.ecm,
      drvs.eudev,
      drvs.expat,
      drvs.file,
      drvs.flex,
      drvs.fontconfig,
      drvs.freetype,
      drvs.gettext,
      drvs.glib,
      drvs.gpgmeForCmake,
      drvs.harfbuzzFull,
      drvs.hwdata,
      drvs.jsonC,
      drvs.karchive,
      drvs.kauth,
      drvs.kbookmarks,
      drvs.kcodecs,
      drvs.kcolorscheme,
      drvs.kcompletion,
      drvs.kconfig,
      drvs.kconfigwidgets,
      drvs.kcoreaddons,
      drvs.kcrash,
      drvs.kdbusaddons,
      drvs.kded,
      drvs.kguiaddons,
      drvs.ki18n,
      drvs.kiconthemes,
      drvs.kitemviews,
      drvs.kjobwidgets,
      drvs.kmod,
      drvs.knotifications,
      drvs.kservice,
      drvs.solid,
      drvs.kwidgetsaddons,
      drvs.kwindowsystem,
      drvs.libassuan,
      drvs.libcanberra,
      drvs.libdrm,
      drvs.libelf,
      drvs.libevdev,
      drvs.libffi,
      drvs.libgcrypt,
      drvs.libgpgError,
      drvs.libinput,
      drvs.libjpegTurboStatic,
      drvs.libogg,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libsecret,
      drvs.libspng,
      drvs.libtool,
      drvs.libvorbis,
      drvs.libwebp,
      drvs.libxkbcommon,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.m4,
      drvs.mesa2,
      drvs.mtdev,
      drvs.openssl,
      drvs.pango,
      drvs.pcre2,
      drvs.pixman,
      drvs.pythonMako,
      drvs.pythonMarkupsafe,
      drvs.pythonPackaging,
      drvs.pyyaml,
      drvs.qca,
      drvs.qt5compat,
      drvs.qtTools,
      drvs.qtbase,
      drvs.qtdeclarative,
      drvs.qtsensors,
      drvs.qtshadertools,
      drvs.qtsvg,
      drvs.qtwayland,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.utilLinuxWeak,
      drvs.vala,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.xz,
      drvs.zlibNg,
      drvs.zstd,
    ],
    buildEnv = {
      EXTRA_LDFLAGS = [
        "$(pkg-config --libs --static gbm glesv2 egl dri wayland-client glib-2.0 gmodule-2.0 expat gpgme libcanberra vorbisfile)",
      ]
    },
    cmakeExtraArgsRecord = {
      "-DBUILD_KSECRETD" = true,
      "-DBUILD_KWALLETD" = true,
      "-DBUILD_KWALLET_QUERY" = true,
      "-DBUILD_TESTING" = false,
      "-DQT_DEBUG_FIND_PACKAGE" = "ON",
      "-DWITH_X11" = false,

      "-DCMAKE_MODULE_LINKER_FLAGS:STRING" = "\"-static --static -fuse-ld=lld -stdlib=libc++ -rtlib=compiler-rt -unwindlib=libunwind -lc++ -ldrm $(pkg-config --libs --static dri glesv2 gbm egl wayland-client glib-2.0 gmodule-2.0 expat gpgme libcanberra vorbisfile)\"",
    },
  }
}
& (import "./kwin.ncl")
& (import "./kf6.ncl")
