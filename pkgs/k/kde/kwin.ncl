{
  lib,
  pixman,
  expat,
  libffi,
  libevdev,
  mtdev,
  pango,
  cairo,
  libpng,
  freetype,
  fontconfig,
  zlibNg,
  harfbuzz,
  glib,
  hwdata,
  linuxHeaders,
  libjpegTurboStatic,
  libspng,
  file,
  libwebp,
  dbusForQt,
  qtdeclarative,
  qtbase,
  qtshadertools,
  qtwayland,
  qt5compat,
  qtTools,
  qtsensors,
  qtsvg,
  mesa2,
  pkgconf,
  libelf,
  libdrm,
  pythonMako,
  pythonPackaging,
  pythonMarkupsafe,
  libpciaccess,
  bison,
  flex,
  wayland,
  waylandProtocols,
  m4,
  pyyaml,
  llvmConfigStatic,
  spirvTools,
  spirvLlvmTranslator,
  jsonC,
  pcre2,
  libxkbcommon,
  openssl,
  kmod,
  zstd,
  xz,
  eudev,
  libinput,
  ecm,
  kcoreaddons,
  kcodecs,
  kconfig,
  kguiaddons,
  ki18n,
  gettext,
  kwidgetsaddons,
  kcolorscheme,
  kauth,
  kdbusaddons,
  kconfigwidgets,
  karchive,
  kwindowsystem,
  plasmaWaylandProtocols,
  kservice,
  kpackage,
  kglobalaccel,
  kidletime,
  ksvg,
  kcrash,
  kirigami,
  kdecorations,
  llvmFull,

  kwin | lib.CmakePackage = {
    generator = "Ninja",
    singleSource = {
      uri = "https://invent.kde.org/plasma/kwin/-/archive/v6.3.2.1/kwin-v6.3.2.1.tar.gz",
      sha256sum = "2eae36bfc9c451a94bccedcd76b60e664d305a8b02e1a47b4612c85e0b679180"
    },
    llvmProvider = lib.singleBiMap llvmFull,
    symlinkBuldInputs = true,
    biDrvs =
      lib.biMap [
        pixman,
        expat,
        libffi,
        libevdev,
        mtdev,
        pango,
        cairo,
        libpng,
        freetype,
        fontconfig,
        zlibNg,
        harfbuzz,
        glib,
        hwdata,
        linuxHeaders,
        libjpegTurboStatic,
        libspng,
        file,
        libwebp,
        dbusForQt,
        qtdeclarative,
        qtbase,
        qtshadertools,
        qtwayland,
        qt5compat,
        qtTools,
        qtsensors,
        qtsvg,
        mesa2,
        # pkgconf,
        libelf,
        libdrm,
        pythonMako,
        pythonPackaging,
        pythonMarkupsafe,
        libpciaccess,
        bison,
        flex,
        wayland,
        waylandProtocols,
        m4,
        pyyaml,
        llvmConfigStatic,
        spirvTools,
        spirvLlvmTranslator,
        ###
        jsonC,
        pcre2,
        libxkbcommon,
        openssl,
        kmod,
        zstd,
        xz,
        eudev,
        libinput,
        ecm,
        kcoreaddons,
        kcodecs,
        kconfig,
        kguiaddons,
        ki18n,
        gettext,
        kwidgetsaddons,
        kcolorscheme,
        kauth,
        kdbusaddons,
        kconfigwidgets,
        karchive,
        kwindowsystem,
        plasmaWaylandProtocols,
        kservice,
        kpackage,
        kglobalaccel,
        kidletime,
        ksvg,
        kcrash,
        kirigami,
        kdecorations,
      ],
    buildEnv = {
      EXTRA_LDFLAGS = [
        "$(pkg-config --libs --static gbm glesv2 egl dri wayland-client)",
      ]
    },
    cmakeExtraArgsRecord = {

      "-DKWIN_BUILD_DECORATIONS" = false,
      "-DKWIN_BUILD_KCMS" = false,
      "-DKWIN_BUILD_NOTIFICATIONS" = false,
      "-DKWIN_BUILD_SCREENLOCKER" = false,
      "-DKWIN_BUILD_TABBOX" = false,
      "-DKWIN_BUILD_X11" = false,
      "-DKWIN_BUILD_X11_BACKEND" = false,
      "-DKWIN_BUILD_GLOBALSHORTCUTS" = false,
      "-DKWIN_BUILD_RUNNERS" = false,

      "-DCMAKE_MODULE_LINKER_FLAGS:STRING" = "\"-static --static -fuse-ld=lld -stdlib=libc++ -rtlib=compiler-rt -unwindlib=libunwind -lc++ -lglapi -ldrm $(pkg-config --libs --static dri glesv2 gbm egl wayland-client)\""
    },
  }
}
& (import "plasma.ncl")
