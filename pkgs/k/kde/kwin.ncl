{
  lib,
  drvs,
  kwin | lib.CmakePackage = {
    generator = "Ninja",
    singleSource = {
      uri = "https://download.kde.org/stable/plasma/6.4.3/kwin-6.4.3.tar.xz",
      sha256sum = "a13568c918eca7803eb44a3a2778b860edc3f03b36797851c4f3aeeed4b502a8"
    },
    llvmProvider = drvs.llvmFull,
    symlinkBuldInputs = true,
    biDrvs = [
      drvs.pixman,
      drvs.expat,
      drvs.libffi,
      drvs.libevdev,
      drvs.mtdev,
      drvs.pango,
      drvs.cairo,
      drvs.libpng,
      drvs.freetype,
      drvs.fontconfig,
      drvs.zlibNg,
      drvs.harfbuzz,
      drvs.glib,
      drvs.hwdata,
      drvs.linuxHeaders,
      drvs.libjpegTurboStatic,
      drvs.libspng,
      drvs.file,
      drvs.libwebp,
      drvs.dbusForQt,
      drvs.qtdeclarative,
      drvs.qtbase,
      drvs.qtshadertools,
      drvs.qtwayland,
      drvs.qt5compat,
      drvs.qtTools,
      drvs.qtsensors,
      drvs.qtsvg,
      drvs.mesa2,
      # drvs.pkgconf,
      drvs.libelf,
      drvs.libdrm,
      drvs.pythonMako,
      drvs.pythonPackaging,
      drvs.pythonMarkupsafe,
      drvs.libpciaccess,
      drvs.bison,
      drvs.flex,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.m4,
      drvs.pyyaml,
      drvs.llvmConfigStatic,
      drvs.spirvTools,
      drvs.spirvLlvmTranslator,
      ###
      drvs.jsonC,
      drvs.pcre2,
      drvs.libxkbcommon,
      drvs.openssl,
      drvs.kmod,
      drvs.zstd,
      drvs.xz,
      drvs.eudev,
      drvs.libinput,
      drvs.ecm,
      drvs.kcoreaddons,
      drvs.kcodecs,
      drvs.kconfig,
      drvs.kguiaddons,
      drvs.ki18n,
      drvs.gettext,
      drvs.kwidgetsaddons,
      drvs.kcolorscheme,
      drvs.kauth,
      drvs.kdbusaddons,
      drvs.kconfigwidgets,
      drvs.karchive,
      drvs.kwindowsystem,
      drvs.plasmaWaylandProtocols,
      drvs.kservice,
      drvs.kpackage,
      drvs.kglobalaccel,
      drvs.kidletime,
      drvs.ksvg,
      drvs.kcrash,
      drvs.kirigami,
      drvs.kdecorations,
      drvs.kwayland,
    ],
    buildEnv = {
      EXTRA_LDFLAGS = [
        "$(pkg-config --libs --static gbm glesv2 egl dri wayland-client)",
      ]
    },
    cmakeExtraArgsRecord = {

      "-DKWIN_BUILD_DECORATIONS" = false,
      "-DKWIN_BUILD_KCMS" = false,
      "-DKWIN_BUILD_NOTIFICATIONS" = false,
      "-DKWIN_BUILD_SCREENLOCKER" = false,
      "-DKWIN_BUILD_TABBOX" = false,
      "-DKWIN_BUILD_X11" = false,
      "-DKWIN_BUILD_X11_BACKEND" = false,
      "-DKWIN_BUILD_GLOBALSHORTCUTS" = false,
      "-DKWIN_BUILD_RUNNERS" = false,

      "-DCMAKE_MODULE_LINKER_FLAGS:STRING" = "\"-static --static -fuse-ld=lld -stdlib=libc++ -rtlib=compiler-rt -unwindlib=libunwind -lc++ -lglapi -ldrm $(pkg-config --libs --static dri glesv2 gbm egl wayland-client)\""
    },
  }
}
& (import "plasma.ncl")
