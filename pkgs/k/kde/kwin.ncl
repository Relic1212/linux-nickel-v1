{
  lib,
  drvs,
  _plasma_sources,
  kwin | lib.QtPackage = {
    generator = "Ninja",
    singleSource = {
      uri = "https://download.kde.org/stable/plasma/6.5.2/kwin-6.5.2.tar.xz",
      # sha256sum = "decf1cb79127c285c7eda768e7ff4f97c72f314735c82685758f0b956ac151f7"
      sha256sum = _plasma_sources."%{uri}",
    },
    llvmProvider = drvs.llvmFull,
    biDrvs = [
      # drvs.pkgconf,
      ###
      # drvs.harfbuzz,
      # drvs.pkgconf,
      drvs.alsaLibs,
      drvs.attr,
      drvs.bison,
      drvs.breezeIcons,
      drvs.bzip2,
      drvs.cairo,
      drvs.dbusForQt,
      drvs.ecm,
      drvs.eudev,
      drvs.expat,
      drvs.file,
      drvs.flex,
      drvs.fontconfig,
      drvs.freetype,
      drvs.gettext,
      drvs.glib,
      drvs.harfbuzz,
      drvs.harfbuzzFull,
      drvs.hwdata,
      drvs.jsonC,
      drvs.karchive,
      drvs.kauth,
      drvs.kbookmarks,
      drvs.kcmutils,
      drvs.kcodecs,
      drvs.kcolorscheme,
      drvs.kcompletion,
      drvs.kconfig,
      drvs.kconfigwidgets,
      drvs.kcoreaddons,
      drvs.kcrash,
      drvs.kdbusaddons,
      drvs.kdecoration,
      drvs.kded,
      drvs.kglobalaccel,
      drvs.kguiaddons,
      drvs.ki18n,
      drvs.kiconthemes,
      drvs.kidletime,
      drvs.kio,
      drvs.kirigami,
      drvs.kitemviews,
      drvs.kjobwidgets,
      drvs.kmod,
      drvs.knotifications,
      drvs.kpackage,
      drvs.kservice,
      drvs.ksvg,
      drvs.kwallet,
      drvs.kwayland,
      drvs.kwidgetsaddons,
      drvs.kwindowsystem,
      drvs.kxmlgui,
      drvs.lcms,
      drvs.libcanberra,
      drvs.libcap,
      drvs.libdisplayinfo,
      drvs.libdrm,
      drvs.libelf,
      # drvs.libepoxyPatched,
      drvs.libevdev,
      drvs.libffi,
      drvs.libinput,
      drvs.libjpegTurboStatic,
      drvs.libogg,
      drvs.libpciaccess,
      # drvs.libplasma,
      drvs.libpng,
      drvs.libspng,
      drvs.libtool,
      drvs.libvorbis,
      drvs.libwebp,
      drvs.libx11,
      drvs.libxau,
      drvs.libxcb,
      drvs.libxcursor,
      drvs.libxcvt,
      drvs.libxfixes,
      drvs.libxkbcommon,
      drvs.libxrender,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.m4,
      drvs.mesaExpKwin,
      drvs.mtdev,
      drvs.openssl,
      drvs.pango,
      drvs.pcre2,
      drvs.pixman,
      # drvs.plasmaActivities,
      drvs.plasmaWaylandProtocols,
      drvs.pythonFull,
      drvs.pythonMako,
      drvs.pythonMarkupsafe,
      drvs.pythonPackaging,
      drvs.pyyaml,
      drvs.qt5compat,
      drvs.qtTools,
      drvs.qtbase,
      drvs.qtdeclarative,
      # drvs.qtsensors,
      drvs.qtsensorsKwin,
      drvs.qtshadertools,
      drvs.qtsvg,
      drvs.qtwayland,
      drvs.solid,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.switcherooControl,
      drvs.utilLinuxWeak,
      drvs.vala,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.xcbProto,
      drvs.xcbRenderutil,
      drvs.xorgMacros,
      drvs.xorgproto,
      drvs.xtrans,
      drvs.xz,
      drvs.zlibNg,
      drvs.zstd,
      drvs.acl,
      drvs.attica,
      drvs.knewstuff,
      drvs.kdeclarative,
      drvs.kglobalacceld,
      drvs.knighttime,
      drvs.qtpositioning,
      drvs.kholidays,
    ],
    buildEnv = {
      EXTRA_LDFLAGS = [
        # "-Wl,--push-state,--no-as-needed",
        "$(pkg-config --libs --static wayland-client expat glib-2.0 gmodule-2.0 libevdev mtdev gbm egl)",
        "-lEGL",
        "-lgallium_dri",
        # "-Wl,--pop-state",
      ]
    },
    debug = true,
    cmakeExtraArgsRecord = {

      "-DKWIN_BUILD_DECORATIONS" = true,
      "-DKWIN_BUILD_KCMS" = false,
      "-DKWIN_BUILD_NOTIFICATIONS" = true,
      "-DKWIN_BUILD_SCREENLOCKER" = false,
      "-DKWIN_BUILD_TABBOX" = false,
      "-DKWIN_BUILD_X11" = false,
      "-DKWIN_BUILD_X11_BACKEND" = false,
      "-DKWIN_BUILD_GLOBALSHORTCUTS" = false,
      "-DKWIN_BUILD_RUNNERS" = true,

      "-DBUILD_TESTING" = false,
    },
    preConfigurePhase =
      let s =
        (
          std.string.join
            m%"\n"%
            [
              "#include <QtCore/QtPlugin>",
              "#include <QtQml/qqmlextensionplugin.h>",
              "Q_IMPORT_PLUGIN(DmaBufServerBufferIntegrationPlugin)",
              "Q_IMPORT_PLUGIN(DmaBufServerBufferPlugin)",
              "Q_IMPORT_PLUGIN(DrmEglServerBufferIntegrationPlugin)",
              "Q_IMPORT_PLUGIN(DrmEglServerBufferPlugin)",
              "Q_IMPORT_PLUGIN(KWaylandPlugin)",
              "Q_IMPORT_PLUGIN(Plugin)",
              "Q_IMPORT_PLUGIN(PluginFactory)",
              "Q_IMPORT_PLUGIN(Poller)",
              "Q_IMPORT_PLUGIN(QWaylandAdwaitaDecorationPlugin)",
              "Q_IMPORT_PLUGIN(QWaylandBradientDecorationPlugin)",
              "Q_IMPORT_PLUGIN(QWaylandDmabufClientBufferIntegrationPlugin)",
              "Q_IMPORT_PLUGIN(QWaylandEglClientBufferIntegrationPlugin)",
              "Q_IMPORT_PLUGIN(QWaylandEglClientBufferPlugin)",
              "Q_IMPORT_PLUGIN(QWaylandEglStreamClientBufferIntegrationPlugin)",
              "Q_IMPORT_PLUGIN(QWaylandFullScreenShellV1IntegrationPlugin)",
              "Q_IMPORT_PLUGIN(QWaylandIntegrationPlugin)",
              "Q_IMPORT_PLUGIN(QWaylandIviShellIntegrationPlugin)",
              "Q_IMPORT_PLUGIN(QWaylandLayerShellIntegrationPlugin)",
              "Q_IMPORT_PLUGIN(QWaylandQtShellIntegrationPlugin)",
              "Q_IMPORT_PLUGIN(QWaylandWlShellIntegrationPlugin)",
              "Q_IMPORT_PLUGIN(QWaylandXdgShellIntegrationPlugin)",
              "Q_IMPORT_PLUGIN(QmlFolderListModelPlugin)",
              "Q_IMPORT_PLUGIN(QmlShapesPlugin)",
              "Q_IMPORT_PLUGIN(QtLabsPlatformPlugin)",
              "Q_IMPORT_PLUGIN(QtQmlWorkerScriptPlugin)",
              "Q_IMPORT_PLUGIN(QtQuick2Plugin)",
              "Q_IMPORT_PLUGIN(QtQuickControls2BasicStyleImplPlugin)",
              "Q_IMPORT_PLUGIN(QtQuickControls2BasicStylePlugin)",
              "Q_IMPORT_PLUGIN(QtQuickControls2FluentWinUI3StyleImplPlugin)",
              "Q_IMPORT_PLUGIN(QtQuickControls2FluentWinUI3StylePlugin)",
              "Q_IMPORT_PLUGIN(QtQuickControls2FusionStyleImplPlugin)",
              "Q_IMPORT_PLUGIN(QtQuickControls2FusionStylePlugin)",
              "Q_IMPORT_PLUGIN(QtQuickControls2ImagineStyleImplPlugin)",
              "Q_IMPORT_PLUGIN(QtQuickControls2ImagineStylePlugin)",
              "Q_IMPORT_PLUGIN(QtQuickControls2ImplPlugin)",
              "Q_IMPORT_PLUGIN(QtQuickControls2MaterialStyleImplPlugin)",
              "Q_IMPORT_PLUGIN(QtQuickControls2MaterialStylePlugin)",
              "Q_IMPORT_PLUGIN(QtQuickControls2Plugin)",
              "Q_IMPORT_PLUGIN(QtQuickControls2UniversalStyleImplPlugin)",
              "Q_IMPORT_PLUGIN(QtQuickControls2UniversalStylePlugin)",
              "Q_IMPORT_PLUGIN(QtQuickDialogsPlugin)",
              "Q_IMPORT_PLUGIN(QtQuickEffectsPlugin)",
              "Q_IMPORT_PLUGIN(QtQuickLayoutsPlugin)",
              "Q_IMPORT_PLUGIN(QtQuickTemplates2Plugin)",
              "Q_IMPORT_PLUGIN(QtQuick_WindowPlugin)",
              "Q_IMPORT_PLUGIN(ShmServerBufferIntegrationPlugin)",
              "Q_IMPORT_PLUGIN(ShmServerBufferPlugin)",
              "Q_IMPORT_PLUGIN(WaylandBackend)",
              "Q_IMPORT_QML_PLUGIN(QWaylandCompositorPlugin)",
              "Q_IMPORT_QML_PLUGIN(QtQmlCorePlugin)",
              "Q_IMPORT_QML_PLUGIN(QtQmlLabsModelsPlugin)",
              "Q_IMPORT_QML_PLUGIN(QtQmlModelsPlugin)",
              "Q_IMPORT_QML_PLUGIN(QtQmlPlugin)",
              "Q_IMPORT_QML_PLUGIN(QtWayland_Compositor_IviApplicationPlugin)",
              "Q_IMPORT_QML_PLUGIN(QtWayland_Compositor_PresentationTimePlugin)",
              "Q_IMPORT_QML_PLUGIN(QtWayland_Compositor_QtShellPlugin)",
              "Q_IMPORT_QML_PLUGIN(QtWayland_Compositor_WlShellPlugin)",
              "Q_IMPORT_QML_PLUGIN(QtWayland_Compositor_XdgShellPlugin)",
              "Q_IMPORT_QML_PLUGIN(org_kde_layershellPlugin)",
            ]
        )
        ++ m%"\n"%
      in
      [
        m%"sed -i 's@Q_DECLARE_METATYPE(KSharedConfigPtr)@%{s}Q_DECLARE_METATYPE(KSharedConfigPtr)@g' ${SRC}/src/main.cpp"%
      ],
    patches = [
      # https://github.com/celestiamobile/celestia-web/blob/b278e8111a6090bdb023235a086203664d8cb336/patches/gles.patch#L124
      {
        sha256sum = "675af456221c613ce0826dbb6775e2866e020eb79e36d80e7c10e7f3881613aa",
        file = "0001-kwin.patch",
      }
    ]
  },

  qtsensors,
  qtsensorsKwin =
    qtsensors
    & {
      srcName = "qtsensors",
      postInstallPhase = [
        "cd ${DEST}/usr/lib/qt6/plugins/sensors/",
        m%"for sym in $(llvm-nm libqtsensors_iio-sensor-proxy.a | grep OrgFreedesktopDBusPropertiesInterface);do
        echo 'redefining "${sym}"="__qtsensors__${sym}"'
        llvm-objcopy --redefine-sym="${sym}"="__qtsensors__${sym}" libqtsensors_iio-sensor-proxy.a
      done
      "%
        # "objcopy --prefix-symbols=__qtsensors__ ${DEST}/usr/lib/qt6/plugins/sensors/libqtsensors_iio-sensor-proxy.a"
      ]
    }
}
& (import "plasma.ncl")
