{
  lib,
  drvs,
  yad | lib.AutotoolsPackage = {
    singleSource = {
      uri = "https://github.com/v1cont/yad/releases/download/v14.1/yad-14.1.tar.xz",
      sha256sum = "dde047a915cd8d3892c32b6ba031876f5cda673e01882c99613f043867c88133"
    },

    buildEnv = {
      EXTRA_LDFLAGS = [
        "$(pkg-config --libs --static expat gtk+-3.0 epoxy xi)"
      ]
    },

    llvmProvider = drvs.llvmFull,

    biDrvs = [
      drvs.atSpi2Core,
      drvs.cairoXlib,
      drvs.expat,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.glibDynamic,
      drvs.gobjectDynamic,
      drvs.gperf,
      drvs.harfbuzz,
      drvs.hwdata,
      drvs.libdrm,
      drvs.libelf,
      drvs.libepoxyX11,
      drvs.libffi,
      drvs.libfontenc,
      drvs.libjpegTurbo,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libx11,
      drvs.libxau,
      drvs.libxcb,
      drvs.libxcursor,
      drvs.libxcvt,
      drvs.libxfixes,
      drvs.libxfont2,
      drvs.libxkbcommon,
      drvs.libxkbfile,
      drvs.libxrender,
      drvs.libxshmfence,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.mesa2,
      drvs.muslShared,
      drvs.ncurses,
      drvs.openssl,
      drvs.pango,
      drvs.pcre2,
      drvs.pixman,
      drvs.readline,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.xcbProto,
      drvs.xcbRenderutil,
      drvs.xcbUtilWm,
      drvs.xorgMacros,
      drvs.xorgproto,
      drvs.xtrans,
      drvs.xwayland,
      drvs.zlibNg,
      drvs.isoCodes,
      drvs.libxext,
      drvs.libxf86vm,
      drvs.libxrandr,
      drvs.libxi,
      drvs.dbus,
      drvs.intltool,
      drvs.pkgconf,
      drvs.perlDynamic,
      drvs.perlXmlParserDynamic,
      drvs.gettext,
      drvs.gtk3X11,
    ]
  }
}
