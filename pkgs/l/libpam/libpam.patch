+void* _PLACEHOLDER_dlsym(const char* symbol){
+		fprintf(stderr, "(_pam_dlsym) using PLACEHOLDER\n" );
+
+		if (strcmp(symbol,"pam_sm_authenticate")==0){
+			fprintf(stderr, "(_pam_dlsym) returning symbol %s\n",symbol );
+
+			return PLACEHOLDER__pam_sm_authenticate;
+		} else if (strcmp(symbol,"pam_sm_setcred")==0){
+			fprintf(stderr, "(_pam_dlsym) returning symbol %s\n",symbol );
+
+			return PLACEHOLDER__pam_sm_setcred;
+		} else if (strcmp(symbol,"pam_sm_acct_mgmt")==0){
+			fprintf(stderr, "(_pam_dlsym) returning symbol %s\n",symbol );
+
+			return PLACEHOLDER__pam_sm_acct_mgmt;
+		}else if (strcmp(symbol,"pam_sm_open_session")==0){
+			fprintf(stderr, "(_pam_dlsym) returning symbol %s\n",symbol );
+
+			return PLACEHOLDER__pam_sm_open_session;
+		}else if (strcmp(symbol,"pam_sm_close_session")==0){
+			fprintf(stderr, "(_pam_dlsym) returning symbol %s\n",symbol );
+
+			return PLACEHOLDER__pam_sm_close_session;
+		}else if (strcmp(symbol,"pam_sm_chauthtok")==0){
+			fprintf(stderr, "(_pam_dlsym) returning symbol %s\n",symbol );
+
+			return PLACEHOLDER__pam_sm_chauthtok;
+		}
+		return NULL;
+}
