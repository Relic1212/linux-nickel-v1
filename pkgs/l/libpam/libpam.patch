+  
+#endif // HAVE_MODULE_PAM_WHEEL
+#ifdef HAVE_MODULE_PAM_XAUTH
+
+	if (strcmp("/usr/lib/security/xauth.so", (shandle) )==0){
+		fprintf(stderr, "(_pam_dlsym) using xauth\n" );
+
+		f = _pam_unix_dlsym(symbol);
+		if (f){
+			return (servicefn)f;
+		}
+	}
+  
+  
+#endif // HAVE_MODULE_PAM_XAUTH
+
+	
+	fprintf(stderr, "(_pam_dlsym) falling back to libc dlsym for symbol %s (%s)\n",symbol,shandle );
+	
+	return (servicefn)dlsym(handle, symbol);
