{
  lib,
  drvs,
  lxqtXdgDesktopPortal | lib.LxqtPackage = {
    singleSource = {
      uri = "https://github.com/lxqt/xdg-desktop-portal-lxqt/archive/refs/tags/1.3.0.tar.gz",
      sha256sum = "f6bb053091f01baf059e80300e038fb2fa3c2a8c35d377f525735064dbef9b46",
    },
    buildEnv = {
      EXTRA_LDFLAGS = [
        "$(pkg-config --static --libs glib-2.0 gmodule-2.0 expat)",
      ],
    },

    preConfigurePhase = [
      m%"printf "include(/usr/lib/cmake/AddStaticQtPlugins.cmake)\nadd_static_qt_plugins(xdg-desktop-portal-lxqt)\n" >> ${SRC}/src/CMakeLists.txt"%,
    ],

    biDrvs = [
      drvs.acl,
      drvs.alsaLibs,
      drvs.attr,
      drvs.bluez,
      drvs.duktape,
      drvs.ecm,
      drvs.elogindWithPolkit,
      drvs.ffmpeg,
      drvs.kwindowsystem,
      drvs.layerShellQt,
      drvs.libcap,
      drvs.libdbusmenuLxqt,
      drvs.liblxqt,
      drvs.libpamFinalUdev,
      drvs.libqtxdg,
      drvs.libstatgrab,
      drvs.libsysstat,
      drvs.libx11,
      drvs.libxau,
      drvs.libxcb,
      drvs.libxext,
      drvs.libxfixes,
      drvs.libxi,
      drvs.libxrender,
      drvs.libxss,
      drvs.libxtst,
      drvs.lmSensors,
      drvs.lxqtBuildTools,
      drvs.lxqtGlobalkeys,
      drvs.lxqtMenuData,
      drvs.perl,
      drvs.plasmaWaylandProtocols,
      drvs.polkit,
      drvs.polkitQt6,
      drvs.procps,
      drvs.pulseaudio17,
      drvs.qtxdgTools,
      drvs.sbc,
      drvs.solid,
      drvs.speex,
      drvs.speexdsp,
      drvs.xcbProto,
      drvs.xcbUtil,
      drvs.xcbUtilImage,
      drvs.xcbUtilWm,
      drvs.xdgDesktopPortal,
      drvs.xdgUserDirs,
      drvs.xorgMacros,
      drvs.xorgproto,
      drvs.xtrans,
      drvs.libfmExtra,
      drvs.libmenuCache,
      drvs.lxqtLibfmQt,
      drvs.libexif,
      drvs.qtpluginConsumer,
      drvs.libevdev,
      drvs.mtdev,
    ]
  }
}
