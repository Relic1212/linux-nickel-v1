      makeArgs,
      makeInstallArgs,
      enableParallel = false,
      extraMakeArgs = [
        "LLVM=1",
        "CC=clang",
        "HOSTCC='clang -static'",
        "STATIC=true",
        "NLS=false",
        "BINDIR=/usr/bin",
        "SBINDIR=bin",
        "sbindir=/usr/bin",
        "prefix=/usr",
        # "LP64=0",
        # "IS_64_BIT=1",
        "-j1",
        "HOSTLDFLAGS=%{ lib.functions.varToExportvar extraEnv.HOSTLDFLAGS}",
        "HOSTCFLAGS=%{ lib.functions.varToExportvar  extraEnv.HOSTCFLAGS}",
      ],
      extraMakeInstallArgs = [
        "NLS=false",
        "STATIC=true",
        "BINDIR=/usr/bin",
        "SBINDIR=bin",
        "sbindir=/usr/bin",
        "prefix=/usr",
      ],
      buildEnv = {
        LD = "ld.lld"
      },
      extraEnv = {
        KBUILD_BUILD_TIMESTAMP = "''",
        HOSTLDFLAGS = "%{ lib.functions.varToExportvar (buildEnv.LDFLAGS @ ["-lz","-leu"] )}",
        HOSTCFLAGS = "%{ lib.functions.varToExportvar  buildEnv.CFLAGS}",
      },
      buildPhase = [
        "make %{std.string.join " " makeArgs} defconfig",
        "make %{std.string.join " " makeArgs} scripts_basic",
        m%"for tool in %{std.string.join " " tools}; do 
            echo "building tool ${tool}"
            make -C tools %{std.string.join " " makeArgs} "${tool}"
        done    
        "%
      ],
      installPhase = [
        m%"for tool in %{std.string.join " " tools}; do
            echo "intalling tool ${tool}"
            make -C tools %{std.string.join " " makeInstallArgs} "${tool}_install"
        done    
        "%
      ],
      biDrvs = [
        drvs.linuxHeaders,
        drvs.utilLinux,
        drvs.pciutils,
        drvs.popt,
        drvs.bash,
        drvs.pkgconfMeson,
        drvs.diffutils & { priority = 1 },
        drvs.coreutils & { priority = 1 },
        drvs.argpStandalone,
        drvs.muslFts,
        drvs.muslObstack,
        drvs.zlibNg,
        drvs.libelf,
        drvs.flex,
        drvs.bison,
        drvs.m4,
        drvs.libcap,
        drvs.perl,
        drvs.openssl,
        drvs.fuse,
        drvs.pythonFull,
        drvs.ncurses,
        drvs.readline,
        drvs.libnl,
        # drvs.libtraceevent,
        # drvs.libtracefs,
        drvs.basenameCompat,
      ],
    }
