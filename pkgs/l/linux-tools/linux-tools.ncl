{
  lib,
  drvs,
  linux,
  linuxTools | lib.MakePackage =
    let tools = [
      "acpi",
      "counter",
      "cpupower",
      "gpio",
      "hv",
      # "firewire",
      #   "perf",
      #   "selftests",
      "bootconfig",
      "spi",
      "turbostat",
      "usb",
      # "virtio",
      "mm",
      # "bpf",
      "x86_energy_perf_policy",
      "tmon",
      "freefall",
      "iio",
      # "objtool",
      # "kvm_stat",
      "wmi",
      "debugging",
      # "tracing",
      "thermal",
      # "thermometer",
      # "thermal-engine",
      # "ynl"
    ]
    in
    {
      singleSource = linux.singleSource,
      preConfigurePhase =
        [
          #     "export SRC=/tmp/workdir/src/tools",

          #     "cd ${SRC}",
          m%"sed -i 's@#include <error.h>@@g' ${SRC}/tools/power/acpi/tools/acpidbg/acpidbg.c"%,

          # https://bugs.gentoo.org/791364
          m%"sed -i "s@#include <linux/limits.h>@#include <linux/limits.h>\n#include <linux/stddef.h>@g" ${SRC}/tools/hv/vmbus_bufring.c"%,

          #   m%"sed -i "s@#include <assert.h>@#include <assert.h>\n#include <linux/stddef.h>@g" ${SRC}/tools/bootconfig/main.c"%,
          m%"sed -i "s@#include <string.h>@#include <string.h>\n#include <linux/stddef.h>@g" ${SRC}/tools/bootconfig/include/linux/bootconfig.h"%,
          m%"sed -i "s@#include <uuid/uuid.h>@#include <uuid/uuid.h>\n#include <basename.h>@g" ${SRC}/tools/power/acpi/tools/pfrut/pfrut.c"%,
          m%"sed -i 's@bin\/false@usr\/bin\/false@g' ${SRC}/Makefile"%,
          m%"sed -i 's@-Wno-maybe-uninitialized@@g' ${SRC}/tools/virtio/Makefile"%,
          m%"sed -i 's@OBJTOOL_LDFLAGS := @OBJTOOL_LDFLAGS := -lz -leu @g' ${SRC}/tools/objtool/Makefile"%,
          m%"sed -i 's|\/usr||g' ${SRC}/tools/debugging/Makefile"%,
          "sed -i 's@/sbin@/usr/bin@g' tools/hv/hv_set_ifconfig.sh",
        ]
        @ (
          std.array.map
            (fun f => m%"sed -i 's@\/bin\/true@\/usr\/bin\/true@g' ${SRC}/%{f}"%
            )
            [
              "/tools/perf/bench/syscall.c",
              "/tools/power/acpi/Makefile.config",
              "/tools/power/cpupower/Makefile",
              "/tools/testing/selftests/bpf/ima_setup.sh",
              "/tools/testing/selftests/bpf/prog_tests/test_ima.c",
              #   "/tools/testing/selftests/cgroup/with_stress.sh",
              #   "/tools/testing/selftests/exec/non-regular.c",
              "/tools/testing/selftests/tc-testing/creating-testcases/example.json",
              "/tools/testing/selftests/tc-testing/tc-tests/actions/pedit.json",
              "/tools/testing/selftests/tc-testing/tc-tests/qdiscs/qfq.json",
              "/tools/testing/selftests/tc-testing/tc-tests/qdiscs/taprio.json",
            ]
        )
        @ (
          std.array.map
            (fun f => m%"sed -i 's@bin\/bash@usr\/bin\/bash@g' ${SRC}/%{f} || true"%
            )
            [
              "tools/certs/print-cert-tbs-hash.sh",
              "tools/crypto/tcrypt/tcrypt_speed_compare.py",
              "tools/hv/hv_get_dhcp_info.sh",
              "tools/hv/hv_set_ifconfig.sh",
              "tools/memory-model/scripts/checkalllitmus.sh",
              "tools/memory-model/scripts/runlitmushist.sh",
              "tools/mm/slabinfo-gnuplot.sh",
              "tools/net/ynl/ynl-regen.sh",
              "tools/perf/Documentation/examples.txt",
              "tools/perf/Documentation/perf-record.txt",
              "tools/perf/Documentation/perf-script-python.txt",
              "tools/perf/Documentation/perf-stat.txt",
              "tools/perf/check-headers.sh",
              "tools/perf/perf-archive.sh",
              "tools/perf/perf-iostat.sh",
              "tools/perf/scripts/perl/bin/check-perf-trace-record",
              "tools/perf/scripts/perl/bin/failed-syscalls-record",
              "tools/perf/scripts/perl/bin/failed-syscalls-report",
