{
  lib,
  drvs,
  llvm,
  libcxx | lib.CmakePackage = {
    generator = "Ninja",
    singleSource = llvm.singleSource,
    unpackPhase = llvm.unpackPhase,
    cmakeDir = "${SRC}/runtimes",

    buildEnv = {
      EXTRA_CFLAGS = ["-fPIC"],
      EXTRA_CXXFLAGS = ["-fPIC"],
      EXTRA_LDFLAGS = ["-fPIC"],
    },
    cmakeExtraArgsRecord = {
      "-DLLVM_ENABLE_RUNTIMES" = "'%{std.string.join ";"[
                "libcxx",
                "libcxxabi",
                "libunwind",
            ] }'",

      "-DLIBCXX_ENABLE_SHARED" = false,
      "-DLIBCXX_HAS_MUSL_LIBC" = true,
      "-DLIBCXXABI_ENABLE_SHARED" = false,
      "-DLIBCXXABI_ENABLE_STATIC_UNWINDER" = true,
      "-DLLVM_ENABLE_PIC" = true,
    },
    buildPhase = [
      # "ninja cxx cxxabi unwind",
      "ninja cxx cxxabi",
      #   "ninja cxx",
    ],
    installPhase = [
      # "DESTDIR=${DEST} ninja install-cxx install-cxxabi install-unwind",
      "DESTDIR=${DEST} ninja install-cxx install-cxxabi",
      #   "DESTDIR=${DEST} ninja install-cxx",
    ],
    biDrvs = [
      drvs.pythonFull,
      drvs.linuxHeaders,
    ],
  },
  libllvm | lib.CmakePackage =
    let tgt =
      ##
      [
        #   "install-cmake-exports",
        #   "install-distribution",
        "install-LLVMABI",
        "install-LLVMAggressiveInstCombine",
        "install-LLVMAnalysis",
        "install-LLVMAsmParser",
        "install-LLVMAsmPrinter",
        "install-LLVMBinaryFormat",
        "install-LLVMBitReader",
        "install-LLVMBitstreamReader",
        "install-LLVMBitWriter",
        "install-LLVMCAS",
        "install-LLVMCFGuard",
        "install-LLVMCFIVerify",
        "install-LLVMCGData",
        "install-LLVMCodeGen",
        "install-LLVMCodeGenTypes",
        "install-LLVMCore",
        "install-LLVMCoroutines",
        "install-LLVMCoverage",
        "install-LLVMDebugInfoBTF",
        "install-LLVMDebugInfoCodeView",
        "install-LLVMDebuginfod",
        "install-LLVMDebugInfoDWARF",
        "install-LLVMDebugInfoDWARFLowLevel",
        "install-LLVMDebugInfoGSYM",
        "install-LLVMDebugInfoLogicalView",
        "install-LLVMDebugInfoMSF",
        "install-LLVMDebugInfoPDB",
        "install-LLVMDemangle",
        "install-LLVMDiff",
        "install-LLVMDlltoolDriver",
        "install-LLVMDTLTO",
        "install-LLVMDWARFCFIChecker",
        "install-LLVMDWARFLinker",
        "install-LLVMDWARFLinkerClassic",
        "install-LLVMDWARFLinkerParallel",
        "install-LLVMDWP",
        "install-LLVMExecutionEngine",
        "install-LLVMExegesis",
        "install-LLVMExegesisX86",
        "install-LLVMExtensions",
        "install-LLVMFileCheck",
        "install-LLVMFrontendAtomic",
        "install-LLVMFrontendDirective",
        "install-LLVMFrontendDriver",
        "install-LLVMFrontendHLSL",
        "install-LLVMFrontendOffloading",
        "install-LLVMFrontendOpenACC",
        "install-LLVMFrontendOpenMP",
        "install-LLVMFuzzerCLI",
        "install-LLVMFuzzMutate",
        "install-LLVMGlobalISel",
        "install-llvm-headers",
        "install-LLVMHipStdPar",
        "install-LLVMInstCombine",
        "install-LLVMInstrumentation",
        "install-LLVMInterfaceStub",
        "install-LLVMInterpreter",
        "install-LLVMipo",
        "install-LLVMIRPrinter",
        "install-LLVMIRReader",
        "install-LLVMJITLink",
        "install-LLVMLibDriver",
        "install-llvm-libraries",
        "install-LLVMLineEditor",
        "install-LLVMLinker",
        # "install-LLVMLTO",
        "install-LLVMMC",
        "install-LLVMMCA",
        "install-LLVMMCDisassembler",
        "install-LLVMMCJIT",
        "install-LLVMMCParser",
        "install-LLVMMIRParser",
        "install-LLVMObjCARCOpts",
        "install-LLVMObjCopy",
        "install-LLVMObject",
        "install-LLVMObjectYAML",
        "install-LLVMOptDriver",
        "install-LLVMOption",
        "install-LLVMOrcDebugging",
        "install-LLVMOrcJIT",
        "install-LLVMOrcShared",
        "install-LLVMOrcTargetProcess",
        "install-LLVMPasses",
        "install-LLVMPlugins",
        "install-LLVMProfileData",
        "install-LLVMRemarks",
        "install-LLVMRuntimeDyld",
        "install-LLVMSandboxIR",
        "install-LLVMScalarOpts",
        "install-LLVMSelectionDAG",
        "install-LLVMSupport",
        "install-LLVMSupportLSP",
        "install-LLVMSymbolize",
        "install-LLVMTableGen",
        "install-LLVMTableGenBasic",
        "install-LLVMTableGenCommon",
        "install-LLVMTarget",
        "install-LLVMTargetParser",
        "install-LLVMTelemetry",
        "install-LLVMTextAPI",
        "install-LLVMTextAPIBinaryReader",
        "install-LLVMTransformUtils",
        "install-LLVMVectorize",
        "install-LLVMWindowsDriver",
        "install-LLVMWindowsManifest",
        "install-LLVMX86AsmParser",
        "install-LLVMX86CodeGen",
        "install-LLVMX86Desc",
        "install-LLVMX86Disassembler",
        "install-LLVMX86Info",
        "install-LLVMX86TargetMCA",
        "install-LLVMXRay",
        #   "install-LTO",
        #   "install-opt-viewer",
        #   "install-Remarks",
      ]
    ##
    in {
      generator = "Ninja",
      singleSource = llvm.singleSource,
      unpackPhase = llvm.unpackPhase,
      cmakeDir = "${SRC}/llvm",
      cmakeExtraArgsRecord = {
        "-DLLVM_DYLIB_COMPONENTS" = "''",
        #   "-DLLVM_TOOL_LLVM_RTDYLD_BUILD" = false,
        "-DLLVM_ENABLE_PROJECTS" = "''",
        "-DLLVM_ENABLE_RUNTIMES" = "''",
        "-DLLVM_BUILD_LLVM_DYLIB" = "OFF",
        "-DLLVM_BUILD_STATIC" = "ON",
        "-DLLVM_BUILD_TESTS" = "OFF",
        "-DLLVM_BUILD_TOOLS" = false,
        "-DLLVM_BUILD_UTILS" = false,
        "-DLLVM_INCLUDE_TOOLS" = false,
        "-DLLVM_INCLUDE_UTILS" = false,
        "-DLLVM_INCLUDE_RUNTIMES" = false,
        "-DLLVM_BUILD_RUNTIME" = false,
        "-DLLVM_BUILD_RUNTIMES" = false,
        #

        "-DLLVM_ENABLE_SHARED_LIBS" = "OFF",
        "-DLLVM_ENABLE_SPHINX" = "OFF",
        "-DLLVM_ENABLE_TERMINFO" = "OFF",
        "-DLLVM_ENABLE_UNWIND_TABLES" = "OFF",
        "-DLLVM_ENABLE_ZLIB" = "OFF",
        "-DLLVM_ENABLE_ZSTD" = "OFF",
        "-DLLVM_EXPERIMENTAL_TARGETS_TO_BUILD" = "''",
        "-DLLVM_HOST_TRIPLE:STRING" = "x86_64-unknown-linux-musl",
        "-DLLVM_INCLUDE_BENCHMARKS" = "OFF",
        "-DLLVM_INCLUDE_DOCS" = "OFF",
        "-DLLVM_INCLUDE_EXAMPLES" = "OFF",
        "-DLLVM_INCLUDE_TESTS" = "OFF",
        "-DLLVM_INCLUDE_UTILS:BOOL" = "OFF",
        #   "-DLLVM_INSTALL_BINUTILS_SYMLINKS:BOOL" = "ON",
        "-DLLVM_LIBDIR_SUFFIX" = "",
        "-DLLVM_LINK_LLVM_DYLIB" = "OFF",
        "-DLLVM_PARALLEL_COMPILE_JOBS" = "$(nproc)",
        "-DLLVM_PARALLEL_LINK_JOBS" = "2", # "$(nproc)",
        "-DLLVM_TARGETS_TO_BUILD" = "'X86'",
        # "-DLLVM_USE_SPLIT_DWARF" = "ON",
        "-DLLVM_VERSION_SUFFIX" = "''",
        "-DLLVM_CCACHE_BUILD:BOOL" = "ON",
      },

      #   installPhase = [
      #     "export DESTDIR=${DEST}",
      #     "ninja %{std.string.join " " tgt }",
      #   ],

      #   buildPhase =
      #     let b_tgt = (std.array.map (fun s => std.string.replace "install-" "" s) tgt) in
      #     [
      #       "ninja %{std.string.join " " b_tgt }",
      #     ],

      biDrvs = [
        drvs.pythonFull,
        drvs.linuxHeaders,
      ],
    }
}
