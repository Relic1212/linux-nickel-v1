{
  lib,
  drvs,
  distro,
  libnma | lib.MesonPackage = {
    singleSource = {
      uri = "https://gitlab.gnome.org/GNOME/libnma/-/archive/1.10.6/libnma-1.10.6.tar.bz2?ref_type=tags",
      sha256sum = "debd7a5660446fe1bc9e8be2993118017ed1261937a0e71e61d0900753192df0",
    },
    buildEnv = {
      EXTRA_LDFLAGS = [
        "$(pkg-config --libs --static harfbuzz)",
      ],
    },
    extraMesonArgs = [
      "-Dmobile_broadband_provider_info=false",
      "-Dlibnma_gtk4=true",
      "-Dgcr=false",
      "-Dintrospection=false",
      "-Dvapi=false",
      "-Dgtk_doc=false",
    ],
    preConfigurePhase = [
      "echo > ${SRC}/shared/nm-utils/nm-shared-utils.c",
      "sed -i 's@shared_library@library@g' ${SRC}/src/meson.build",
    ],
    biDrvs =
      [
        drvs.atSpi2Core,
        drvs.bash,
        drvs.cairo,
        drvs.cairoGobject,
        drvs.curl,
        drvs.dbus,
        drvs.dnsmasq,
        drvs.docbookXml,
        drvs.docbookXslNons,
        drvs.elogindNm,
        drvs.eudevNm,
        drvs.expat,
        drvs.fontconfig,
        drvs.freetype,
        drvs.fribidi,
        drvs.gdkPixbufFull,
        drvs.gettext,
        drvs.glibDynamic,
        drvs.glibPatched,
        drvs.gmp,
        drvs.gnutls,
        drvs.gobjectDynamic,
        drvs.gperf,
        drvs.gpgme,
        drvs.graphene,
        drvs.gtk3,
        drvs.gtk4,
        # drvs.harfbuzz,
        drvs.harfbuzzFull,
        drvs.hwdata,
        drvs.isoCodes,
        drvs.iwd,
        drvs.libassuan,
        drvs.libcap,
        drvs.libdrm,
        drvs.libedit,
        drvs.libelf,
        drvs.libepoxy,
        drvs.libffi,
        drvs.libgcrypt,
        drvs.libgpgError,
        drvs.libjpegTurbo,
        drvs.libmnl,
        drvs.libndp,
        drvs.libnftnl,
        drvs.libpam,
        drvs.libpciaccess,
        drvs.libpng,
        drvs.libpsl,
        drvs.libsecret,
        drvs.libtasn1,
        drvs.libtiff,
        drvs.libxkbcommon,
        drvs.libxml2,
        drvs.libxslt,
        drvs.linuxHeaders,
        drvs.llvmConfigStatic,
        drvs.mesa2,
        drvs.muslShared,
        drvs.ncurses,
        drvs.nettleGmp,
        drvs.networkmanager,
        drvs.newt,
        drvs.nftables,
        drvs.openresolv,
        drvs.openssl,
        drvs.pango,
        drvs.pcre2,
        drvs.perl,
        drvs.pixman,
        drvs.polkit,
        drvs.readline,
        drvs.sharedMimeInfo,
        drvs.slang,
        drvs.spirvLlvmTranslator,
        drvs.spirvTools,
        drvs.utilLinux,
        drvs.wayland,
        drvs.waylandProtocols,
        drvs.zlibNg,
      ]
      @ (
        if distro.elogind then
          [
            # drvs.elogindNm,
            # drvs.libpam,
            # drvs.libcap,
          ]
        else
          []
      ),
  }
}
