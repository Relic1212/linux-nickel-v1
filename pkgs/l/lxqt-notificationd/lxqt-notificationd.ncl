{
  lib,
  drvs,
  lxqtNotificationd | lib.LxqtPackage = {
    singleSource = {
      uri = "https://github.com/lxqt/lxqt-notificationd/archive/refs/tags/2.3.1.tar.gz",
      sha256sum = "bdaa5d361c66a99f9af03be351d437e896bfb405e8623729d2f7450548d60145",
    },
    buildEnv = {
      EXTRA_LDFLAGS = [
        "$(pkg-config --static --libs glib-2.0 gmodule-2.0 expat)",
      ],
    },
    preConfigurePhase = [
      "cd ${SRC}",
      m%"patch -p1 << 'EOF'%{import "lxqt-notificationd-nox11.patch" as 'Text}EOF"%,
      "cd ${BUILDDIR}",
    ],
    biDrvs = [
      drvs.acl,
      drvs.attr,
      drvs.duktape,
      drvs.elogindWithPolkit,
      drvs.kwindowsystem,
      drvs.layerShellQt,
      drvs.libcap,
      drvs.liblxqt,
      drvs.libpamFinalUdev,
      drvs.libqtxdg,
      drvs.libx11,
      drvs.libxau,
      drvs.libxcb,
      drvs.libxext,
      drvs.libxfixes,
      drvs.libxrender,
      drvs.libxss,
      drvs.lxqtBuildTools,
      drvs.plasmaWaylandProtocols,
      drvs.polkit,
      drvs.polkitQt6,
      drvs.xcbProto,
      drvs.xorgMacros,
      drvs.xorgproto,
      drvs.xtrans,
      drvs.qtxdgTools,
      drvs.xdgUserDirs,
      drvs.procps,
      drvs.perl,
      drvs.libdbusmenuLxqt,
      drvs.lxqtGlobalkeys,
      drvs.lxqtMenuData,
      drvs.libstatgrab,
      drvs.libsysstat,
      drvs.alsaLibs,
      drvs.bluez,
      drvs.sbc,
      drvs.ffmpeg,
      drvs.speex,
      drvs.speexdsp,
      drvs.pulseaudio17,
      drvs.solid,
      drvs.ecm,
      drvs.lmSensors,
      drvs.xcbUtilImage,
      drvs.xcbUtil,
      drvs.xcbUtilWm,
      drvs.libxtst,
      drvs.libxi,
    ],
  }
}
