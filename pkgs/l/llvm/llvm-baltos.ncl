{
  lib,
  drvs,
  llvmFull,
  llvm,
  llvmBaltos | lib.CmakePackage =
    # llvmFull
    # &
    {
      singleSource | priority 1 = {

        uri = "https://github.com/llvm/llvm-project/releases/download/llvmorg-21.1.4/llvm-project-21.1.4.src.tar.xz",
        sha256sum = "a01ad7e5167780c945871d75c0413081d12067607a6de5cf71dc3e8d1a82112c",

        # uri = "https://github.com/llvm/llvm-project/archive/220bac16a417e97bf97fdcb34855e28b2e6dfdf7.tar.gz",
        # sha256sum = "be3b5b3743b27d5cf68726a0138a695fe6935a98651b2adfbb1d4f9ec7e1b6fd",
      },
      generator = "Ninja",
      sourceInputs | priority 1 = [
        {
          src = singleSource,
        },
      ],
      buildEnv = {
        # CC = [
        #   "clang",
        #   "--verbose",
        # ],
        # CXX = [
        #   "clang++",
        #   "--verbose",
        # ],
        # EXTRA_CFLAGS = [
        #   # "--verbose",
        # ],
        # EXTRA_CXXFLAGS = EXTRA_CFLAGS,
      },
      cmakeArgs | priority 1 = lib.cmakeArgsTransform cmakeArgsRecord,
      cmakeExtraArgsRecord | priority 2 = {},
      cmakeArgsRecord | priority 2 = {
        # "-DLLVM_TARGETS_TO_BUILD" | force = "'X86'",
        # "-DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR" | force = true,
        # "-DCMAKE_INSTALL_PREFIX"|priority 1 = "/opt",
        # "-DLLVM_DEFAULT_TARGET_TRIPLE:STRING" = "'i686-unknown-baltos'",
        #   "-DLLVM_ENABLE_PROJECTS"|force="'clang;lld'",
        # "-DLLVM_ENABLE_RUNTIMES"|force = "'compiler-rt;libunwind'",
        ################
        "-DCMAKE_INSTALL_PREFIX" | priority 1 = "/opt",

        "-DCLANG_BUILD_TOOLS" = true,
        "-DCLANG_DEFAULT_CXX_STDLIB" = "libc++",
        "-DCLANG_DEFAULT_LINKER" = "lld",
        "-DCLANG_DEFAULT_RTLIB" = "compiler-rt",
        "-DCLANG_DEFAULT_UNWINDLIB" = "libunwind",
        "-DCMAKE_BUILD_TYPE" = "Release",
        "-DCOMPILER_RT_BUILD_BUILTINS" = true,
        "-DCOMPILER_RT_BUILD_CTX_PROFILE" = false,
        "-DCOMPILER_RT_BUILD_GWP_ASAN" = false,
        "-DCOMPILER_RT_BUILD_LIBFUZZER" = false,
        "-DCOMPILER_RT_BUILD_MEMPROF" = false,
        "-DCOMPILER_RT_BUILD_ORC" = false,
        "-DCOMPILER_RT_BUILD_PROFILE" = false,
        "-DCOMPILER_RT_BUILD_SANITIZERS" = false,
        "-DCOMPILER_RT_BUILD_XRAY" = false,
        "-DCOMPILER_RT_CXX_LIBRARY" = "none",
        "-DCOMPILER_RT_SANITIZERS_TO_BUILD:STRING" = "''",
        "-DCOMPILER_RT_USE_BUILTINS_LIBRARY" = true,
        "-DLIBCXXABI_ENABLE_SHARED" = false,
        "-DLIBCXXABI_USE_COMPILER_RT" = true,
        "-DLIBCXX_ENABLE_SHARED" = false,
        "-DLIBCXX_ENABLE_STATIC_ABI_LIBRARY" = true,
        "-DLIBCXX_USE_COMPILER_RT" = true,
        "-DLLDB_BUILD_INTEL_MPX" = false,
        "-DLLDB_ENABLE_CURSES" = true,
        "-DLLVM_ENABLE_EH" = false,
        "-DLLVM_ENABLE_LIBCXX" = true,
        "-DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR" = true,
        "-DLLVM_ENABLE_PROJECTS" = "'lld;clang;lldb'",
        "-DLLVM_ENABLE_RTTI" = false,
        "-DLLVM_ENABLE_RUNTIMES" = "'compiler-rt'",
        "-DLLVM_ENABLE_UNWIND_TABLES" = false,
        "-DLLVM_ENABLE_ZLIB" = false,
        "-DLLVM_ENABLE_ZSTD" = false,
        "-DLLVM_EXPERIMENTAL_TARGETS_TO_BUILD" = "''",
        "-DLLVM_INSTALL_BINUTILS_SYMLINKS" = true,
        # "-DLLVM_PARALLEL_COMPILE_JOBS=1",
        # "-DLLVM_PARALLEL_LINK_JOBS=1",
        "-DLLVM_TARGETS_TO_BUILD" = "X86",
        "-DLLVM_TOOL_LLVM_DRIVER_BUILD" = true,
        "-DLLVM_TOOL_LTO_BUILD" = false,
        "-DLLVM_RUNTIME_TARGETS" = "'default;x86_64-unknown-barebones;i386-unknown-barebones'",
        "-DRUNTIMES_x86_64-unknown-barebones_COMPILER_RT_USE_BUILTINS_LIBRARY" = false,
        "-DRUNTIMES_x86_64-unknown-barebones_COMPILER_RT_BUILD_BUILTINS" = true,
        "-DRUNTIMES_x86_64-unknown-barebones_COMPILER_RT_BUILD_CTX_PROFILE" = false,
        "-DRUNTIMES_x86_64-unknown-barebones_COMPILER_RT_BUILD_LIBFUZZER" = false,
        "-DRUNTIMES_x86_64-unknown-barebones_COMPILER_RT_BUILD_MEMPROF" = false,
        "-DRUNTIMES_x86_64-unknown-barebones_COMPILER_RT_BUILD_ORC" = false,
        "-DRUNTIMES_x86_64-unknown-barebones_COMPILER_RT_BUILD_PROFILE" = false,
        "-DRUNTIMES_x86_64-unknown-barebones_COMPILER_RT_BUILD_SANITIZERS" = false,
        "-DRUNTIMES_x86_64-unknown-barebones_COMPILER_RT_BUILD_XRAY" = false,
        "-DRUNTIMES_x86_64-unknown-barebones_COMPILER_RT_BAREMETAL_BUILD" = true,
        "-DRUNTIMES_x86_64-unknown-barebones_COMPILER_RT_CXX_LIBRARY" = "none",
        "-DRUNTIMES_x86_64-unknown-barebones_ENABLE_LIBCXX" = false,
        "-DRUNTIMES_x86_64-unknown-barebones_LIBCXX_CXX_ABI" = "none",
        "-DRUNTIMES_x86_64-unknown-barebones_LIBCXX_ENABLE_EXCEPTIONS" = false,
        "-DRUNTIMES_x86_64-unknown-barebones_LIBCXX_ENABLE_FILESYSTEM" = false,
        "-DRUNTIMES_x86_64-unknown-barebones_LIBCXX_ENABLE_LOCALIZATION" = false,
        "-DRUNTIMES_x86_64-unknown-barebones_LIBCXX_ENABLE_THREADS" = false,
        "-DRUNTIMES_x86_64-unknown-barebones_LIBCXX_ENABLE_RTTI" = false,
        "-DRUNTIMES_x86_64-unknown-barebones_LIBCXX_HAS_UNICODE" = false,
        "-DRUNTIMES_x86_64-unknown-barebones_LIBCXXABI_USE_LLVM_UNWINDER" = false,
        "-DRUNTIMES_x86_64-unknown-barebones_SANITIZER_CXX_ABI" = "none",
        "-DRUNTIMES_i386-unknown-barebones_COMPILER_RT_USE_BUILTINS_LIBRARY" = false,
        "-DRUNTIMES_i386-unknown-barebones_COMPILER_RT_BUILD_BUILTINS" = true,
        "-DRUNTIMES_i386-unknown-barebones_COMPILER_RT_BUILD_CTX_PROFILE" = false,
        "-DRUNTIMES_i386-unknown-barebones_COMPILER_RT_BUILD_LIBFUZZER" = false,
        "-DRUNTIMES_i386-unknown-barebones_COMPILER_RT_BUILD_MEMPROF" = false,
        "-DRUNTIMES_i386-unknown-barebones_COMPILER_RT_BUILD_ORC" = false,
        "-DRUNTIMES_i386-unknown-barebones_COMPILER_RT_BUILD_PROFILE" = false,
        "-DRUNTIMES_i386-unknown-barebones_COMPILER_RT_BUILD_SANITIZERS" = false,
        "-DRUNTIMES_i386-unknown-barebones_COMPILER_RT_BUILD_XRAY" = false,
        "-DRUNTIMES_i386-unknown-barebones_COMPILER_RT_BAREMETAL_BUILD" = true,
        "-DRUNTIMES_i386-unknown-barebones_COMPILER_RT_CXX_LIBRARY" = "none",
        "-DRUNTIMES_i386-unknown-barebones_ENABLE_LIBCXX" = false,
        "-DRUNTIMES_i386-unknown-barebones_LIBCXX_CXX_ABI" = "none",
        "-DRUNTIMES_i386-unknown-barebones_LIBCXX_ENABLE_EXCEPTIONS" = false,
        "-DRUNTIMES_i386-unknown-barebones_LIBCXX_ENABLE_FILESYSTEM" = false,
        "-DRUNTIMES_i386-unknown-barebones_LIBCXX_ENABLE_LOCALIZATION" = false,
        "-DRUNTIMES_i386-unknown-barebones_LIBCXX_ENABLE_THREADS" = false,
        "-DRUNTIMES_i386-unknown-barebones_LIBCXX_ENABLE_RTTI" = false,
        "-DRUNTIMES_i386-unknown-barebones_LIBCXX_HAS_UNICODE" = false,
        "-DRUNTIMES_i386-unknown-barebones_LIBCXXABI_USE_LLVM_UNWINDER" = false,
        "-DRUNTIMES_i386-unknown-barebones_SANITIZER_CXX_ABI" = "none",
        "-DRUNTIMES_i386-unknown-barebones_LINKER_SUPPORTS_COLOR_DIAGNOSTICS" = false,
        "-DRUNTIMES_x86_64-unknown-windows_COMPILER_RT_USE_BUILTINS_LIBRARY" = false,
        "-DRUNTIMES_x86_64-unknown-windows_COMPILER_RT_BUILD_BUILTINS" = true,
        "-DRUNTIMES_x86_64-unknown-windows_COMPILER_RT_BUILD_CTX_PROFILE" = false,
        "-DRUNTIMES_x86_64-unknown-windows_COMPILER_RT_BUILD_LIBFUZZER" = false,
        "-DRUNTIMES_x86_64-unknown-windows_COMPILER_RT_BUILD_MEMPROF" = false,
        "-DRUNTIMES_x86_64-unknown-windows_COMPILER_RT_BUILD_ORC" = false,
        "-DRUNTIMES_x86_64-unknown-windows_COMPILER_RT_BUILD_PROFILE" = false,
        "-DRUNTIMES_x86_64-unknown-windows_COMPILER_RT_BUILD_SANITIZERS" = false,
        "-DRUNTIMES_x86_64-unknown-windows_COMPILER_RT_BUILD_XRAY" = false,
        "-DRUNTIMES_x86_64-unknown-windows_COMPILER_RT_CXX_LIBRARY" = "none",
        "-DRUNTIMES_x86_64-unknown-windows_COMPILER_RT_BUILTINS_ENABLE_PIC" = false,
        "-DRUNTIMES_x86_64-unknown-windows_ENABLE_LIBCXX" = false,
        "-DRUNTIMES_x86_64-unknown-windows_LIBCXX_CXX_ABI" = "none",
        "-DRUNTIMES_x86_64-unknown-windows_LIBCXX_ENABLE_EXCEPTIONS" = false,
        "-DRUNTIMES_x86_64-unknown-windows_LIBCXX_ENABLE_FILESYSTEM" = false,
        "-DRUNTIMES_x86_64-unknown-windows_LIBCXX_ENABLE_LOCALIZATION" = false,
        "-DRUNTIMES_x86_64-unknown-windows_LIBCXX_ENABLE_THREADS" = false,
        "-DRUNTIMES_x86_64-unknown-windows_LIBCXX_ENABLE_RTTI" = false,
        "-DRUNTIMES_x86_64-unknown-windows_LIBCXX_HAS_UNICODE" = "Off",
        "-DRUNTIMES_x86_64-unknown-windows_LIBCXXABI_USE_LLVM_UNWINDER" = false,
        "-DRUNTIMES_x86_64-unknown-windows_SANITIZER_CXX_ABI" = "none",
        "-DRUNTIMES_x86_64-unknown-windows_LINKER_SUPPORTS_COLOR_DIAGNOSTICS" = false,
        "-DRUNTIMES_x86_64-unknown-windows_CMAKE_POSITION_INDEPENDENT_CODE" = false,
        "-DLLVM_CCACHE_BUILD" = true,
        "-DBUILD_SHARED_LIBS" = false,
        "-DCOMPILER_RT_SCUDO_STANDALONE_BUILD_SHARED" = false,
        "-DLIBCXXABI_INSTALL_SHARED_LIBRARY" = false,
        "-DLIBCXX_INSTALL_SHARED_LIBRARY" = false,
        "-DLLVM_ENABLE_SHARED_LIBS" = false,
        "-DCMAKE_EXE_LINKER_FLAGS" = "-static",
        "-DCMAKE_LINK_SEARCH_START_STATIC" = false,
        "-DCMAKE_SKIP_INSTALL_RPATH" = true,
        "-DCLANG_ENABLE_ARCMT" = false,
        "-DCLANG_ENABLE_CLANGD" = false,
        "-DCLANG_ENABLE_HLSL" = false,
        "-DCLANG_ENABLE_STATIC_ANALYZER" = false,
        "-DCLANG_INCLUDE_TESTS" = false,
        "-DCLANG_LINK_CLANG_DYLIB" = false,
        "-DCLANG_TOOL_AMDGPU_ARCH_BUILD" = false,
        "-DCLANG_TOOL_APINOTES_TEST_BUILD" = false,
        "-DCLANG_TOOL_ARCMT_TEST_BUILD" = false,
        "-DCLANG_TOOL_CLANG_CHECK_BUILD" = false,
        "-DCLANG_TOOL_CLANG_DIFF_BUILD" = false,
        "-DCLANG_TOOL_CLANG_EXTDEF_MAPPING_BUILD" = false,
        "-DCLANG_TOOL_CLANG_FORMAT_BUILD" = false,
        "-DCLANG_TOOL_CLANG_FORMAT_VS_BUILD" = false,
        "-DCLANG_TOOL_CLANG_FUZZER_BUILD" = false,
        "-DCLANG_TOOL_CLANG_IMPORT_TEST_BUILD" = false,
        "-DCLANG_TOOL_CLANG_INSTALLAPI_BUILD" = false,
        "-DCLANG_TOOL_CLANG_REFACTOR_BUILD" = false,
        "-DCLANG_TOOL_CLANG_REPL_BUILD" = false,
        "-DCLANG_TOOL_CLANG_SCAN_DEPS_BUILD" = false,
        "-DCLANG_TOOL_C_ARCMT_TEST_BUILD" = false,
        "-DCLANG_TOOL_C_INDEX_TEST_BUILD" = false,
        "-DCLANG_TOOL_C_INDEX_TEST_BUILD" = false,
        "-DCLANG_TOOL_LIBCLANG_BUILD" = true,
        "-DCLANG_TOOL_NVPTX_ARCH_BUILD" = false,
        "-DCLANG_TOOL_SCAN_BUILD_BUILD" = false,
        "-DCLANG_TOOL_SCAN_BUILD_PY_BUILD" = false,
        "-DCLANG_TOOL_SCAN_VIEW_BUILD" = false,
        "-DLLVM_INCLUDE_BENCHMARKS" = false,
        "-DLLVM_INCLUDE_DOCS" = false,
        "-DLLVM_INCLUDE_EXAMPLES" = false,
        "-DLLVM_INCLUDE_TESTS" = false,
        "-DLLVM_BUILD_TESTS" = false,
        "-DLLVM_INCLUDE_UTILS" = false,
        "-DLIBCXX_INCLUDE_TESTS" = false,
        "-DLIBCXX_BUILD_TESTS" = false,
        "-DLLVM_BUILD_EXAMPLES" = false,
        "-DCOMPILER_RT_BUILD_ORC" = false,
        "-DLIBCXX_HAS_MUSL_LIBC" = true,
        "-DLLVM_BUILD_TOOLS" = true,
        "-DLLVM_BUILD_UTILS" = true,
        "-DLLVM_DYLIB_COMPONENTS" = "",
        "-DLLVM_ENABLE_BACKTRACES" = false,
        "-DLLVM_ENABLE_BINDINGS" = false,
        "-DLLVM_BUILD_LLVM_DYLIB" = false,
        "-DCLANG_ENABLE_ARCMT" = false,
        "-DCLANG_ENABLE_CLANGD" = false,
        "-DCLANG_ENABLE_HLSL" = false,
        "-DCLANG_ENABLE_STATIC_ANALYZER" = false,
        "-DLLVM_ENABLE_PIC" = false,
      },
      unpackPhase | priority 1 = [
        "tar xf /tmp/workdir/packed/%{singleSource.sha256sum}/%{std.string.split "/" singleSource.uri |>std.array.last } -C /tmp/workdir/src --strip-components=1",
      ],
      cmakeDir = "${SRC}/llvm",

      buildInputs | priority 1 = llvm.buildInputs @ [drvs.gnupatch & { priority = 1 }, drvs.ncurses],
      # patches = [
      #   {
      #     # sha256sum = "a3ac7ebb77f0142b4cf02af04323f42d5428c3fea9275de301f6ff06cc40b224",
      #     # file = "baltos-3.patch",

      #     sha256sum = "12cba9bf078c077fc798e31f05eaec9a70dd85b1d1f192a5f6c1b264ddb957f5",
      #     file = "baltos-1.patch",
      #   }
      # ],
      eofPatches = [
        {
          patch = (import "llvm-baltos/x.patch" as 'Text),
        },
      ],
    }
}
& {
  lib,
  drvs,
  llvmBaltos,
  llvmBaltos2 | lib.CmakePackage =
    llvmBaltos
    & {
      buildInputs | priority 2 = [
        drvs.busyboxStage3,
        drvs.llvmBaltos,
        drvs.musl,
        drvs.samurai,
        drvs.ccacheBin,
        drvs.linuxHeaders,
        drvs.cmake,
        drvs.python,
      ],
      preConfigurePhase = [
        "export PATH=\"/opt/bin:$PATH\"",
      ],

      cmakeArgsRecord = {
        "-DLLVM_DEFAULT_TARGET_TRIPLE:STRING" = "'i686-unknown-baltos'",
        #"-DCMAKE_INSTALL_PREFIX"|priority 1 = "/opt",
      }
    },
}
