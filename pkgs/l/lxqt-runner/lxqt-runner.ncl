{
  lib,
  drvs,
  lxqtRunner | lib.LxqtPackage = {
    singleSource = {
      uri = "https://github.com/lxqt/lxqt-runner/archive/refs/tags/2.3.0.tar.gz",
      sha256sum = "dd1a2c9c6a614911a2b9f2a80b7a8c4d67072a37cf1d46dfb37399f2fc865182",
    },
    buildEnv = {
      EXTRA_LDFLAGS = [
        "$(pkg-config --libs --static glib-2.0 gmodule-2.0 expat)",
      ],
    },
    preConfigurePhase = [
      "cd ${SRC}",
      m%"patch -p1 << 'EOF'%{import "lxqt-runner-nox11.patch" as 'Text}EOF"%,
      "cd ${BUILDDIR}",
      m%"printf "include(/usr/lib/cmake/AddStaticQtPlugins.cmake)\nadd_static_qt_plugins(lxqt-runner)\n" >> ${SRC}/CMakeLists.txt"%,
    ],

    biDrvs = [
      drvs.acl,
      drvs.attr,
      drvs.duktape,
      drvs.elogindWithPolkit,
      drvs.kwindowsystem,
      drvs.layerShellQt,
      drvs.libcap,
      drvs.liblxqt,
      drvs.libpamFinalUdev,
      drvs.libqtxdg,
      drvs.libx11,
      drvs.libxau,
      drvs.libxcb,
      drvs.libxext,
      drvs.libxfixes,
      drvs.libxrender,
      drvs.libxss,
      drvs.lxqtBuildTools,
      drvs.plasmaWaylandProtocols,
      drvs.polkit,
      drvs.polkitQt6,
      drvs.xcbProto,
      drvs.xorgMacros,
      drvs.xorgproto,
      drvs.xtrans,
      drvs.qtxdgTools,
      drvs.xdgUserDirs,
      drvs.procps,
      drvs.perl,
      drvs.libdbusmenuLxqt,
      drvs.lxqtGlobalkeys,
      drvs.lxqtMenuData,
      drvs.libstatgrab,
      drvs.libsysstat,
      drvs.alsaLibs,
      drvs.bluez,
      drvs.sbc,
      drvs.ffmpeg,
      drvs.speex,
      drvs.speexdsp,
      drvs.pulseaudio17,
      drvs.solid,
      drvs.ecm,
      drvs.lmSensors,
      drvs.xcbUtilImage,
      drvs.xcbUtil,
      drvs.xcbUtilWm,
      drvs.libxtst,
      drvs.libxi,
      drvs.muparser,
      drvs.qtpluginConsumer,
      drvs.libevdev,
      drvs.mtdev,
    ]
  }
}
