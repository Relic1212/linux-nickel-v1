{
  lib,
  drvs,
  virglrenderer | lib.MesonPackage = {
    singleSource = {
      uri = "https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/1.2.0/virglrenderer-1.2.0.tar.bz2",
      sha256sum = "f4f52db11297b52b35c8c2d5bf5e21b7997b52f8bfad99ea2b1c155997cff4ad"
    },
    extraMesonArgs = [
      "-Dplatforms=egl",
      # "-Dvideo=true",
    ],

    buildEnv = {
      EXTRA_LDFLAGS = [
        "-Wl,--error-limit=0",
      ],
    },

    preConfigurePhase = [
      m%"sed -i "s@subdir('vtest')@@" ${SRC}/meson.build"%,
    ],

    postInstallPhase =
      let syms = [
        "_mesa_hash_table_clear",
        "_mesa_hash_table_clone",
        "_mesa_hash_table_create",
        "_mesa_hash_table_create_u32_keys",
        "_mesa_hash_table_destroy",
        "_mesa_hash_table_init",
        "_mesa_hash_table_insert",
        "_mesa_hash_table_insert_pre_hashed",
        "_mesa_hash_table_next_entry",
        "_mesa_hash_table_remove",
        "_mesa_hash_table_remove_key",
        "_mesa_hash_table_search",
        "_mesa_hash_table_search_pre_hashed",
        "_mesa_hash_table_set_deleted_key",
        "tgsi_dump",
        "tgsi_dump_instruction",
        "tgsi_dump_instruction_str",
        "tgsi_dump_str",
        "tgsi_dump_to_file",
        "tgsi_swizzle_names",
        "util_hash_table_foreach",
        "util_hash_table_get",
        "_mesa_hash_data",
        "_mesa_hash_data_with_seed",
        "_mesa_hash_int",
        "_mesa_hash_pointer",
        "_mesa_hash_string",
        "_mesa_hash_table_next_entry_unsafe",
        "_mesa_hash_table_random_entry",
        "_mesa_hash_table_reserve",
        "_mesa_hash_table_u64_clear",
        "_mesa_hash_table_u64_create",
        "_mesa_hash_table_u64_destroy",
        "_mesa_hash_table_u64_insert",
        "_mesa_hash_u32",
        "_mesa_hash_uint",
        "_mesa_key_int_equal",
        "_mesa_key_pointer_equal",
        "_mesa_key_string_equal",
        "_mesa_key_u32_equal",
        "_mesa_key_uint_equal",
        "_mesa_pointer_hash_table_create",
        "_mesa_hash_table_u64_remove",
        "_mesa_hash_table_u64_search",
      ]
      in
      std.array.map (fun s => "llvm-objcopy --redefine-sym %{s}=__virglrenderer_private_%{s} ${DEST}/usr/lib/libvirglrenderer.a") syms,

    llvmProvider = drvs.llvmFull,

    biDrvs = [
      #   drvs.libelf,
      #   drvs.libdrm,
      #   drvs.zlibNg,
      #   drvs.libpciaccess,
      #   drvs.libffi,
      #   drvs.bison,
      #   drvs.flex,
      #   drvs.linuxHeaders,
      #   drvs.llvmConfigStatic,
      drvs.spirvTools,
      drvs.spirvLlvmTranslator,
      #   drvs.wayland,
      #   drvs.waylandProtocols,
      #   drvs.mesa2,
      drvs.expat,
      drvs.jsonC,
      drvs.pcre2,
      drvs.mesaGlxEpoxy,
      drvs.wayland,
      drvs.waylandProtocols,
      drvs.libelf,
      drvs.libpciaccess,
      drvs.libdrm,
      drvs.libxkbcommon,
      drvs.pixman,
      drvs.eudev,
      # drvs.libudevZero,
      # drvs.seatd,
      drvs.libdisplayinfo,
      drvs.libinput,
      drvs.libffi,
      drvs.libevdev,
      drvs.mtdev,
      drvs.pango,
      drvs.cairo,
      drvs.libpng,
      drvs.freetype,
      drvs.fontconfig,
      drvs.zlibNg,
      drvs.harfbuzz,
      drvs.glib,
      drvs.hwdata,
      drvs.linuxHeaders,
      drvs.libepoxy,
      drvs.pyyaml,
      drvs.libxcursor,
      drvs.xorgMacros,
      drvs.xorgproto,
      drvs.xtrans,
      drvs.libxcb,
      drvs.xcbProto,
      drvs.libxau,
      drvs.libx11,
      drvs.libxrender,
      drvs.libxfixes,
      drvs.xcbRenderutil,
      drvs.libxfont2,
      drvs.libfontenc,
      drvs.libxcvt,
      drvs.libxshmfence,
      # drvs.xwayland,
      drvs.libxkbfile,
      drvs.xcbUtilWm,
      drvs.xcbUtilErrors,
      drvs.libxext,
      drvs.libxf86vm,
      drvs.libxrandr,
    ],
  }
}
