{
  lib,
  drvs,
  virglrenderer | lib.MesonPackage = {
    debug = true,
    singleSource = {
      # uri = "https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/virglrenderer-1.3.0/virglrenderer-virglrenderer-1.3.0.tar.gz",
      # sha256sum = "56170f8caa1bb642a2624b649e3bcca095ec2834814e5c308efc8a85a709e4ce",

      uri = "https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/0.10.4/virglrenderer-0.10.4.tar.gz",
      sha256sum = "da3fdc59821f645632d986482594410614a95c0c7c703b25bfb3473bd6674214",
    },
    extraMesonArgs =
      [
        "-Dplatforms=egl",
        "-Dvideo=true",
        # "-Ddrm-amdgpu=true",
        # "-Ddrm-renderers='amdgpu-experimental,i915-experimental'",
        # "-Ddrm-renderers='amdgpu-experimental'",
        "-Drender-server-worker='thread'",
        # "-Drender-server-worker='process'",
        # "-Dcheck-gl-errors=false",
        "-Dcheck-gl-errors=true",
      ]
      @ [
        # "-Ddrm=enabled",
        # "-Drender-server=true",
        "-Dtracing=stderr",
      ],

    buildEnv = {
      EXTRA_CPPFLAGS =
        [
          "-D_debug_vprintf=virglrenderer___debug_vprintf",
          "-Ddebug_get_option=virglrenderer__debug_get_option",
          "-Ddebug_get_bool_option=virglrenderer__debug_get_bool_option",
          "-Ddebug_get_num_option=virglrenderer__debug_get_num_option",
          "-Ddebug_get_version_option=virglrenderer__debug_get_version_option",
          "-Ddebug_get_flags_option=virglrenderer__debug_get_flags_option",
          "-Ddebug_dump_enum=virglrenderer__debug_dump_enum",
          "-Ddebug_dump_flags=virglrenderer__debug_dump_flags",
        ]
        @ (
          std.array.map
            (fun s => "-D%{s}=vrglrenderer__%{s}"
            )
            [
              "_mesa_hash_table_clear",
              "_mesa_hash_table_clone",
              "_mesa_hash_table_create",
              "_mesa_hash_table_create_u32_keys",
              "_mesa_hash_table_destroy",
              "_mesa_hash_table_init",
              "_mesa_hash_table_insert",
              "_mesa_hash_table_insert_pre_hashed",
              "_mesa_hash_table_next_entry",
              "_mesa_hash_table_remove",
              "_mesa_hash_table_remove_key",
              "_mesa_hash_table_search",
              "_mesa_hash_table_search_pre_hashed",
              "_mesa_hash_table_set_deleted_key",
              "tgsi_dump",
              "tgsi_dump_instruction",
              "tgsi_dump_instruction_str",
              "tgsi_dump_str",
              "tgsi_dump_to_file",
              "tgsi_swizzle_names",
              "util_hash_table_foreach",
              "util_hash_table_get",
              "_mesa_hash_data",
              "_mesa_hash_data_with_seed",
              "_mesa_hash_int",
              "_mesa_hash_pointer",
              "_mesa_hash_string",
              "_mesa_hash_table_next_entry_unsafe",
              "_mesa_hash_table_random_entry",
              "_mesa_hash_table_reserve",
              "_mesa_hash_table_u64_clear",
              "_mesa_hash_table_u64_create",
              "_mesa_hash_table_u64_destroy",
              "_mesa_hash_table_u64_insert",
              "_mesa_hash_u32",
              "_mesa_hash_uint",
              "_mesa_key_int_equal",
              "_mesa_key_pointer_equal",
              "_mesa_key_string_equal",
              "_mesa_key_u32_equal",
              "_mesa_key_uint_equal",
              "_mesa_pointer_hash_table_create",
              "_mesa_hash_table_u64_remove",
              "_mesa_hash_table_u64_search",
              "virgl_video_create_codec",
              "virgl_video_create_buffer",
              "util_format_get_blocksize",
              ##
              "util_format_apply_color_swizzle",
              "util_format_compose_swizzles",
              "util_format_fits_8unorm",
              "util_format_has_alpha",
              "util_format_is_alpha",
              "util_format_is_intensity",
              "util_format_is_luminance",
              "util_format_is_luminance_alpha",
              "util_format_is_pure_integer",
              "util_format_is_pure_sint",
              "util_format_is_pure_uint",
              "util_format_is_snorm",
              "util_format_swizzle_4f",
              "util_format_unswizzle_4f",
              "util_format_description",
              "util_get_depth_format_mrd",
              "util_is_format_compatible",
              ##
            ]
        ),
      EXTRA_LDFLAGS = [
        "-Wl,--error-limit=0",
      ],
    },

    preConfigurePhase = [
      m%"sed -i "s@subdir('vtest')@@" ${SRC}/meson.build"%,
    ],

    # postInstallPhase =
    #   let syms = [
    #     "_mesa_hash_table_clear",
    #     "_mesa_hash_table_clone",
    #     "_mesa_hash_table_create",
    #     "_mesa_hash_table_create_u32_keys",
    #     "_mesa_hash_table_destroy",
    #     "_mesa_hash_table_init",
    #     "_mesa_hash_table_insert",
    #     "_mesa_hash_table_insert_pre_hashed",
    #     "_mesa_hash_table_next_entry",
    #     "_mesa_hash_table_remove",
    #     "_mesa_hash_table_remove_key",
    #     "_mesa_hash_table_search",
    #     "_mesa_hash_table_search_pre_hashed",
    #     "_mesa_hash_table_set_deleted_key",
    #     "tgsi_dump",
    #     "tgsi_dump_instruction",
    #     "tgsi_dump_instruction_str",
    #     "tgsi_dump_str",
    #     "tgsi_dump_to_file",
    #     "tgsi_swizzle_names",
    #     "util_hash_table_foreach",
    #     "util_hash_table_get",
    #     "_mesa_hash_data",
    #     "_mesa_hash_data_with_seed",
    #     "_mesa_hash_int",
    #     "_mesa_hash_pointer",
    #     "_mesa_hash_string",
    #     "_mesa_hash_table_next_entry_unsafe",
    #     "_mesa_hash_table_random_entry",
    #     "_mesa_hash_table_reserve",
    #     "_mesa_hash_table_u64_clear",
    #     "_mesa_hash_table_u64_create",
    #     "_mesa_hash_table_u64_destroy",
    #     "_mesa_hash_table_u64_insert",
    #     "_mesa_hash_u32",
    #     "_mesa_hash_uint",
    #     "_mesa_key_int_equal",
    #     "_mesa_key_pointer_equal",
    #     "_mesa_key_string_equal",
    #     "_mesa_key_u32_equal",
    #     "_mesa_key_uint_equal",
    #     "_mesa_pointer_hash_table_create",
    #     "_mesa_hash_table_u64_remove",
    #     "_mesa_hash_table_u64_search",
    #     "virgl_video_create_codec",
    #     "virgl_video_create_buffer",
    #   ]
    #   in
    #   std.array.map (fun s => "llvm-objcopy --redefine-sym %{s}=__virglrenderer_private_%{s} ${DEST}/usr/lib/libvirglrenderer.a") syms,

    llvmProvider = drvs.llvmFull,
    biDrvs = [
      drvs.pyyaml,
    ],
    pDrvs = [
      drvs.libepoxy,
      drvs.libva,
    ],
  }
}
