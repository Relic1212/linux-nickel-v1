{
  lib,
  drvs,
  virglrenderer | lib.MesonPackage = {
    debug = true,
    singleSource = {
      uri = "https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/virglrenderer-1.3.0/virglrenderer-virglrenderer-1.3.0.tar.gz",
      sha256sum = "56170f8caa1bb642a2624b649e3bcca095ec2834814e5c308efc8a85a709e4ce",

      # uri = "https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/0.10.4/virglrenderer-0.10.4.tar.gz",
      # sha256sum = "da3fdc59821f645632d986482594410614a95c0c7c703b25bfb3473bd6674214",
    },
    extraMesonArgs =
      [
        "-Dplatforms=egl",
        # "-Dvideo=true",
        "-Dvideo=false",
        "-Ddrm-renderers='amdgpu-experimental,i915-experimental'",
        # "-Ddrm-renderers='amdgpu-experimental'",
        # "-Drender-server-worker='thread'",
        # "-Drender-server-worker='process'",
        "-Dcheck-gl-errors=false",
        # "-Dcheck-gl-errors=true",
      ]
      @ [
        # "-Ddrm=enabled",
        # "-Drender-server=true",
        # "-Dtracing=stderr",
      ],

    buildEnv = {
      EXTRA_CPPFLAGS =
        [
          "-D_debug_vprintf=virglrenderer___debug_vprintf",
          "-Ddebug_get_option=virglrenderer__debug_get_option",
          "-Ddebug_get_bool_option=virglrenderer__debug_get_bool_option",
          "-Ddebug_get_num_option=virglrenderer__debug_get_num_option",
          "-Ddebug_get_version_option=virglrenderer__debug_get_version_option",
          "-Ddebug_get_flags_option=virglrenderer__debug_get_flags_option",
          "-Ddebug_dump_enum=virglrenderer__debug_dump_enum",
          "-Ddebug_dump_flags=virglrenderer__debug_dump_flags",
        ]
        @ (
          std.array.map
            (fun s => "-D%{s}=vrglrenderer__%{s}"
            )
            (
              [
                "_mesa_hash_table_clear",
                "_mesa_hash_table_clone",
                "_mesa_hash_table_create",
                "_mesa_hash_table_create_u32_keys",
                "_mesa_hash_table_destroy",
                "_mesa_hash_table_init",
                "_mesa_hash_table_insert",
                "_mesa_hash_table_insert_pre_hashed",
