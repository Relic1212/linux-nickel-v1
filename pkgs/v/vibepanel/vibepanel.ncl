{
  lib,
  drvs,
  vibepanel | lib.CargoPackage = {
    singleSource = {
      uri = "https://github.com/prankstr/vibepanel/archive/refs/tags/v0.8.0.tar.gz",
      sha256sum = "ee8971d7a912bffb318b55d71c2e27a36c6b007fa53dbc808cced2d685046007",
    },
    crates = lib.functions.filterCrates (import "vibepanel-crates.json"),
    extraEnv = {
      EXTRA_RUSTFLAGS = [
        "-C link-arg=/tmp/workdir/src/dlopen.o",
        "-C link-arg=-lc++",
        m%"$(for l in $(pkg-config --libs --static libpulse egl glesv2);do printf " -C link-arg=$l ";done)"%,
        "-C link-arg=-ldbus-1",
      ],
    },
    configurePhase = [
      m%"sed -i 's@libpulse.so.0@libpulse.a@g' ${SRC}/vendor/libpulse-sys*/build.rs"%,
      "echo '%{import "vibepanel_dlopen.c" as 'Text}' > ${SRC}/dlopen.c",
      "${CC} ${CFLAGS} -c ${SRC}/dlopen.c -o ${SRC}/dlopen.o",
    ],

    llvmProvider = drvs.llvmFull,
    biDrvs = [
      drvs.atSpi2Core,
      #   drvs.cairo,
      drvs.cairoGobject,
      drvs.expat,
      drvs.fontconfig,
      drvs.freetype,
      drvs.fribidi,
      drvs.gdkPixbufFull,
      drvs.glibPatched,
      #   drvs.gobjectDynamic,
      drvs.gperf,
      drvs.graphene,
      drvs.harfbuzzFull,
      drvs.hwdata,
      drvs.libdrm,
      drvs.libelf,
      drvs.libepoxy,
      drvs.libffi,
      drvs.libjpegTurbo,
      drvs.libpciaccess,
      drvs.libpng,
      drvs.libtiff,
      drvs.libxkbcommon,
      drvs.linuxHeaders,
      drvs.llvmConfigStatic,
      drvs.mesa2,
      drvs.muslBothRenamedDl & { priority = 2 },
      drvs.ncurses,
      drvs.pango,
      drvs.pcre2,
      drvs.pixman,
      drvs.readline,
      drvs.spirvLlvmTranslator,
      drvs.spirvTools,
      drvs.waylandGtk4LayerShell,
      drvs.waylandProtocols,
      drvs.zlibNg,
      drvs.gtk4,
      drvs.gtk4LayerShell,
      drvs.eudev,
      drvs.kmod,
      drvs.xz,
      drvs.openssl,
      drvs.zstd,
      drvs.pulseaudio17,
      drvs.dbus,
    ],
  },
}
